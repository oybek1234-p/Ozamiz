<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_navigation"
    app:startDestination="@id/authFragment">

    <fragment
        android:id="@+id/profileFragment"
        android:name="uz.oybek.ozamiz.ui.feature.profile.ProfileFragment"
        android:label="@string/profile_title"
        tools:layout="@layout/fragment_profile">


        <action
            android:id="@+id/action_profileFragment_to_getMainInfoFragment"
            app:destination="@id/onboarding"
            app:enterAnim="@anim/fragment_open_anim"
            app:exitAnim="@anim/fragment_close_anim"
            app:popEnterAnim="@anim/fragment_pop_enter"
            app:popExitAnim="@anim/fragment_pop_exit">
            <argument
                android:name="new"
                android:defaultValue="false"
                app:argType="boolean" />
        </action>

        <action
            android:id="@+id/action_profileFragment_to_authFragment"
            app:destination="@id/authFragment"
            app:enterAnim="@anim/fragment_open_anim"
            app:exitAnim="@anim/fragment_close_anim"
            app:popEnterAnim="@anim/fragment_pop_enter"
            app:popExitAnim="@anim/fragment_pop_exit"
            app:popUpTo="@id/main_navigation"
            app:popUpToInclusive="true" />

        <action
            android:id="@+id/action_profileFragment_to_paymentGetCheckFragment"
            app:destination="@id/paymentGetCheckFragment"
            app:enterAnim="@anim/fragment_open_anim"
            app:exitAnim="@anim/fragment_close_anim"
            app:popEnterAnim="@anim/fragment_pop_enter"
            app:popExitAnim="@anim/fragment_pop_exit" />
        <action
            android:id="@+id/action_profileFragment_to_adminPaymentVerificationListFragment"
            app:destination="@id/adminPaymentVerificationListFragment"
            app:enterAnim="@anim/fragment_open_anim"
            app:exitAnim="@anim/fragment_close_anim"
            app:popEnterAnim="@anim/fragment_pop_enter"
            app:popExitAnim="@anim/fragment_pop_exit" />
        <action
            android:id="@+id/action_profileFragment_to_weightPhotoHistoryFragment"
            app:destination="@id/weightPhotoHistoryFragment"
            app:enterAnim="@anim/fragment_open_anim"
            app:exitAnim="@anim/fragment_close_anim"
            app:popEnterAnim="@anim/fragment_pop_enter"
            app:popExitAnim="@anim/fragment_pop_exit" />
    </fragment>

    <fragment
        android:id="@+id/paymentGetCheckFragment"
        android:name="uz.oybek.ozamiz.ui.feature.premium.PaymentGetCheckFragment"
        android:label="PaymentGetCheckFragment"
        tools:layout="@layout/payment_check_fragment" />

    <fragment
        android:id="@+id/adminPaymentVerificationListFragment"
        android:name="uz.oybek.ozamiz.ui.feature.premium.AdminPaymentVerificationListFragment"
        android:label="AdminPaymentVerificationListFragment">
        <action
            android:id="@+id/action_adminPaymentVerificationListFragment_to_adminPaymentVerificationDetailFragment"
            app:destination="@id/adminPaymentVerificationDetailFragment"
            app:enterAnim="@anim/fragment_open_anim"
            app:exitAnim="@anim/fragment_close_anim"
            app:popEnterAnim="@anim/fragment_pop_enter"
            app:popExitAnim="@anim/fragment_pop_exit" />
    </fragment>

    <fragment
        android:id="@+id/adminPaymentVerificationDetailFragment"
        android:name="uz.oybek.ozamiz.ui.feature.premium.AdminPaymentVerificationDetailFragment"
        android:label="AdminPaymentVerificationDetailFragment"
        tools:layout="@layout/fragment_admin_payment_verification_detail">
        <argument
            android:name="userId"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/authFragment"
        android:name="uz.oybek.ozamiz.ui.feature.auth.AuthFragment"
        android:label="AuthFragment"
        tools:layout="@layout/fragment_auth">
        <action
            android:id="@+id/action_authFragment_to_getMainInfo"
            app:destination="@id/onboarding"
            app:enterAnim="@anim/fragment_open_anim"
            app:exitAnim="@anim/fragment_close_anim"
            app:popEnterAnim="@anim/fragment_pop_enter"
            app:popExitAnim="@anim/fragment_pop_exit"
            app:popUpTo="@id/authFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_authFragment_to_loginGmailFragment"
            app:destination="@id/loginGmailFragment"
            app:enterAnim="@anim/fragment_open_anim"
            app:exitAnim="@anim/fragment_close_anim"
            app:popEnterAnim="@anim/fragment_pop_enter"
            app:popExitAnim="@anim/fragment_pop_exit" />
        <action
            android:id="@+id/action_authFragment_to_home"
            app:destination="@id/home"
            app:enterAnim="@anim/fragment_open_anim"
            app:exitAnim="@anim/fragment_close_anim"
            app:popEnterAnim="@anim/fragment_pop_enter"
            app:popExitAnim="@anim/fragment_pop_exit"
            app:popUpTo="@id/authFragment"
            app:popUpToInclusive="true" />
    </fragment>
    <fragment
        android:id="@+id/loginGmailFragment"
        android:name="uz.oybek.ozamiz.ui.feature.auth.email.LoginGmailFragment"
        android:label="LoginGmailFragment"
        tools:layout="@layout/login_gmail_fragment">
        <action
            android:id="@+id/action_loginGmailFragment_to_getMainInfo"
            app:destination="@id/onboarding"
            app:enterAnim="@anim/fragment_open_anim"
            app:exitAnim="@anim/fragment_close_anim"
            app:popEnterAnim="@anim/fragment_pop_enter"
            app:popExitAnim="@anim/fragment_pop_exit"
            app:popUpTo="@id/loginGmailFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_loginGmailFragment_to_home"
            app:destination="@id/home"
            app:enterAnim="@anim/fragment_open_anim"
            app:exitAnim="@anim/fragment_close_anim"
            app:popEnterAnim="@anim/fragment_pop_enter"
            app:popExitAnim="@anim/fragment_pop_exit"
            app:popUpTo="@id/loginGmailFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/onboarding"
        android:name="uz.oybek.ozamiz.ui.feature.onboarding.OnBoardingFragment"
        android:label="GetInfoMainFragment"
        tools:layout="@layout/get_info_main_fragment">

    </fragment>

    <fragment
        android:id="@+id/home"
        android:name="uz.oybek.ozamiz.ui.feature.home.HomeFragment"
        android:label="HomeFragment"
        tools:layout="@layout/fragment_home">
        <action
            android:id="@+id/action_home_to_logFoodFragment"
            app:destination="@id/logFoodFragment"
            app:enterAnim="@anim/fragment_open_anim"
            app:exitAnim="@anim/fragment_close_anim"
            app:popEnterAnim="@anim/fragment_pop_enter"
            app:popExitAnim="@anim/fragment_pop_exit" />
        <action
            android:id="@+id/action_home_to_logExerciseFragment"
            app:destination="@id/logExerciseFragment"
            app:enterAnim="@anim/fragment_open_anim"
            app:exitAnim="@anim/fragment_close_anim"
            app:popEnterAnim="@anim/fragment_pop_enter"
            app:popExitAnim="@anim/fragment_pop_exit" />
        <action
            android:id="@+id/action_home_to_logWaterDialog"
            app:destination="@id/logWaterDialog" />
        <action
            android:id="@+id/action_home_to_foods"
            app:destination="@id/foods"
            app:enterAnim="@anim/fragment_open_anim"
            app:exitAnim="@anim/fragment_close_anim"
            app:popEnterAnim="@anim/fragment_pop_enter"
            app:popExitAnim="@anim/fragment_pop_exit" />

    </fragment>


    <fragment
        android:id="@+id/logFoodFragment"
        android:name="uz.oybek.ozamiz.ui.feature.log.food.LogFoodFragment"
        android:label="LogFoodFragment"
        tools:layout="@layout/fragment_log_food">

        <action
            android:id="@+id/action_logFoodFragment_to_voiceRecorderBottomSheet"
            app:destination="@id/voiceInputBottomSheet" />

        <argument
            android:name="mealType"
            app:argType="string" />
        <argument
            android:name="logToEditJson"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
        <action
            android:id="@+id/action_logFoodFragment_to_calorieResultBottomSheet"
            app:destination="@id/calorieResultBottomSheet" />
    </fragment>

    <fragment
        android:id="@+id/calorieResultBottomSheet"
        android:name="uz.oybek.ozamiz.ui.feature.log.food.AnalyzeResultFragment"
        android:label="CalorieResultBottomSheet"
        tools:layout="@layout/bottom_sheet_calorie_result">

    </fragment>
    <fragment
        android:id="@+id/logExerciseFragment"
        android:name="uz.oybek.ozamiz.ui.feature.log.exercise.LogExerciseFragment"
        android:label="LogExerciseFragment"
        tools:layout="@layout/fragment_log_exercise">
        <argument
            android:name="logToEditJson"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
        <argument
            android:name="preselectedExerciseId"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
    </fragment>

    <dialog
        android:id="@+id/logWaterDialog"
        android:name="uz.oybek.ozamiz.ui.feature.log.water.LogWaterDialog"
        android:label="LogWaterDialog"
        tools:layout="@layout/dialog_log_water" />


    <dialog
        android:id="@+id/selectExercisesDialogFragment"
        android:name="uz.oybek.ozamiz.ui.feature.onboarding.exercise.SelectExerciseTypeBottomSheet"
        android:label="SelectExercisesDialogFragment"></dialog>


    <dialog
        android:id="@+id/customTimePickerDialogFragment"
        android:name="uz.oybek.ozamiz.ui.feature.onboarding.exercise.CustomTimePickerDialogFragment"
        android:label="CustomTimePickerDialogFragment" />


    <dialog
        android:id="@+id/streakInfoBottomSheetDialog"
        android:name="uz.oybek.ozamiz.ui.feature.streak.StreakInfoSheet"
        android:label="StreakInfoBottomSheetDialog" />

    <fragment
        android:id="@+id/addWeightPhotoFragment"
        android:name="uz.oybek.ozamiz.ui.feature.log.photo.AddWeightPhotoFragment"
        android:label="AddWeightPhotoFragment" />
    <fragment
        android:id="@+id/photoUploadInfoFragment"
        android:name="uz.oybek.ozamiz.ui.feature.log.photo.PhotoUploadInfoFragment"
        android:label="PhotoUploadInfoFragment" />
    <fragment
        android:id="@+id/weightPhotoHistoryFragment"
        android:name="uz.oybek.ozamiz.ui.feature.log.photo.WeightPhotoHistoryFragment"
        android:label="fragment_weight_photo_history"
        tools:layout="@layout/fragment_weight_photo_history" />
    <fragment
        android:id="@+id/natijaFragment2"
        android:name="uz.oybek.ozamiz.ui.feature.natija.NatijaFragment"
        android:label="NatijaFragment" />
    <dialog
        android:id="@+id/voiceInputBottomSheet"
        android:name="uz.oybek.ozamiz.ui.feature.log.voice.VoiceRecorderBottomSheet"
        android:label="VoiceInputBottomSheet" />
</navigation>