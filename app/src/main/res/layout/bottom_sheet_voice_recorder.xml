<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/round_lay"
    android:orientation="vertical"
    android:padding="24dp">

    <ImageView
        android:id="@+id/button_cancel_recording"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:padding="@dimen/dimen_8"
        android:src="@drawable/close_ic"
        app:tint="?colorOnSurfaceVariant" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/textView_record_status"
            style="@style/Title3_17"
            android:layout_width="wrap_content"
            android:layout_marginTop="@dimen/dimen_12"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="@string/recording_speak_now"
            android:textColor="?colorOnSurface" />

        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/lottie_recording_indicator"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            app:lottie_autoPlay="true"
            app:lottie_loop="true"
            app:lottie_rawRes="@raw/recording_lottie" />

        <TextView
            android:id="@+id/textView_timer"
            style="@style/Title3_17"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/roboto_bold"
            android:text="00:00"
            android:textColor="?colorOnSurface"
            android:visibility="visible" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_analyze"
                style="@style/Widget.Material3.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:enabled="true"

                android:text="@string/stop_and_analyze" />

            <ProgressBar
                android:id="@+id/progressBar_analyze"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_gravity="center"
                android:indeterminateTint="?colorPrimary"
                tools:visibility="visible" />
        </FrameLayout>
    </LinearLayout>

</FrameLayout>