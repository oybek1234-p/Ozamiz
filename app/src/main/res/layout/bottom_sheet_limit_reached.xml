<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bottom_sheet_background"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingTop="12dp"
    android:paddingBottom="24dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@drawable/drag_handle" />

    <TextView
        android:id="@+id/text_limit_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/roboto_bold"
        android:text="Bugungi rasmga olish limitingiz tugadi"
        android:textColor="?attr/colorOnSurface"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/text_limit_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/roboto_regular"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="14sp"
        tools:text="Ertaga yana 3 ta beriladi. Ovqatni tayyor ro'yxatdan kiriting yoki premium sotib oling" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_manual_search"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="20dp"
        android:fontFamily="@font/roboto_bold"
        android:text="Ro'yxatdan kiritish"
        android:textAllCaps="false"
        android:textColor="?attr/colorOnSurface"
        android:textSize="15sp"
        app:backgroundTint="?attr/colorSurfaceContainerHigh"
        app:cornerRadius="24dp"
        app:icon="@drawable/ic_search"
        app:iconGravity="textStart"
        app:iconPadding="10dp"
        app:iconTint="?attr/colorOnSurface" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_buy_premium"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="10dp"
        android:fontFamily="@font/roboto_bold"
        android:text="Premium olish"
        android:textAllCaps="false"
        android:textSize="15sp"
        app:cornerRadius="24dp"
        app:icon="@drawable/star_ic"
        app:iconGravity="textStart"
        app:iconPadding="10dp" />

</LinearLayout>
