<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet_rounded"
    android:orientation="vertical"
    android:padding="24dp">

    <ImageView
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center"
        android:src="@drawable/info_ic"
        app:tint="@color/yellow" />

    <TextView
        android:id="@+id/text_overage_amount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="@font/roboto_medium"
        android:gravity="center"
        android:textColor="@color/yellow"
        android:textSize="18sp"
        tools:text="Siz kunlik me'yordan asosan 140 kaloriya ortiqcha yedingiz." />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="@font/roboto_bold"
        android:text="Endi nima bo'ladi?"
        android:textColor="?attr/colorOnSurface"
        android:textSize="16sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/roboto_regular"
        android:lineSpacingExtra="4dp"
        android:text="Agar kaloriya me'yordan doimo oshsa, bu vazn yo'qotishni sekinlashtiradi yoki qisman vazn ortishiga olib kelishi mumkin."
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="14sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="@font/roboto_bold"
        android:text="Tavsiyalar"
        android:textColor="?attr/colorOnSurface"
        android:textSize="16sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/roboto_regular"
        android:lineSpacingExtra="4dp"
        android:text="• Bugun ko'proq suv ichishga harakat qiling.\n• Kamida 20 daqiqa yengil piyoda yuring.\n• Kuning qolgan qismida faqat yengil oziq-ovqatlarni (masalan: qatiq, sabzavotlar, mevalar yoki tovuq go'shti) iste'mol qiling."
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="14sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_got_it"
        style="@style/FilledButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="24dp"
        android:text="Tushunarli"
        app:cornerRadius="28dp" />

</LinearLayout>
