<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet_rounded"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingTop="32dp"
    android:paddingBottom="48dp">

    <ImageView
        android:id="@+id/icon_warning"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="center"
        android:src="@drawable/warning_24px"
        app:tint="@color/orange"
        xmlns:app="http://schemas.android.com/apk/res-auto" />

    <TextView
        android:id="@+id/text_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="@font/roboto_medium"
        android:gravity="center"
        android:text="@string/limit_exceeded_title"
        android:textColor="?attr/colorOnSurface"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/text_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fontFamily="@font/roboto_regular"
        android:gravity="center"
        android:textColor="?attr/colorOnSurface"
        android:textSize="15sp"
        android:lineSpacingExtra="4dp" />

    <TextView
        android:id="@+id/text_advice_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:fontFamily="@font/roboto_medium"
        android:text="@string/what_can_i_eat_now"
        android:textColor="?attr/colorOnSurface"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/text_advice_item1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fontFamily="@font/roboto_regular"
        android:textColor="?attr/colorOnSurface"
        android:textSize="16sp"
        android:lineSpacingExtra="2dp" />

    <TextView
        android:id="@+id/text_advice_item2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/roboto_regular"
        android:textColor="?attr/colorOnSurface"
        android:textSize="16sp"
        android:lineSpacingExtra="2dp" />

    <TextView
        android:id="@+id/text_advice_item3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/roboto_regular"
        android:textColor="?attr/colorOnSurface"
        android:textSize="16sp"
        android:lineSpacingExtra="2dp" />

    <TextView
        android:id="@+id/text_advice_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_24"
        android:fontFamily="@font/roboto_regular"
        android:gravity="start"
        android:textColor="?attr/colorOnSurface"
        android:textSize="16sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_got_it"
        android:layout_width="match_parent"
        style="@style/FilledButton"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_24"
        android:text="@string/tushunarli"
        xmlns:app="http://schemas.android.com/apk/res-auto" />

</LinearLayout>
