<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_active_task"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="?attr/colorSurfaceContainerLowest"
    app:cardCornerRadius="24dp"
    app:cardElevation="0dp"
    app:strokeColor="?attr/colorOutlineVariant"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp">

        <ImageView
            android:id="@+id/icon_task"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/star_ic"
            app:tint="@color/orange"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/text_task_status_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_rounded_8"
            android:backgroundTint="?attr/colorSecondaryContainer"
            android:fontFamily="@font/roboto_medium"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:textColor="?attr/colorSecondary"
            android:textSize="12sp"
            android:layout_marginStart="12dp"
            app:layout_constraintStart_toEndOf="@id/icon_task"
            app:layout_constraintTop_toTopOf="@id/icon_task"
            app:layout_constraintBottom_toBottomOf="@id/icon_task"
            tools:text="Bajarilmagan" />

        <TextView
            android:id="@+id/text_task_title"
            style="@style/TextAppearance.Material3.TitleLarge"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/roboto_bold"
            android:textColor="?attr/colorOnSurface"
            android:textSize="18sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/icon_task"
            tools:text="Yegan hamma narsangizni kiriting" />

        <TextView
            android:id="@+id/text_task_description"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/roboto_regular"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="14sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/text_task_title"
            tools:text="Bugun faqat bitta narsani qiling..." />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_open_task"
            style="@style/Widget.Material3.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Vazifani ko'rish va bajarish"
            app:cornerRadius="16dp"
            app:layout_constraintTop_toBottomOf="@id/text_task_description" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
