<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginBottom="8dp"
    app:cardBackgroundColor="?colorSurfaceContainerLowest"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:strokeColor="?colorOutlineVariant"
    app:strokeWidth="0.5dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <TextView
            android:id="@+id/textQuizNumber"
            style="@style/TextAppearance.Material3.TitleMedium"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/background_suggestion"
            android:gravity="center"
            android:textColor="?colorPrimary"
            tools:text="1" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textQuizQuestion"
                style="@style/TextAppearance.Material3.BodyLarge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="?colorOnSurface"
                tools:text="Savol matni bu yerda ko'rinadi" />

            <TextView
                android:id="@+id/textQuizOptions"
                style="@style/TextAppearance.Material3.BodySmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="?colorOnSurfaceVariant"
                tools:text="3 ta variant" />

        </LinearLayout>

        <ImageButton
            android:id="@+id/btnEditQuiz"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Tahrirlash"
            android:src="@drawable/edit"
            app:tint="?colorOnSurfaceVariant" />

        <ImageButton
            android:id="@+id/btnDeleteQuiz"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="O'chirish"
            android:src="@drawable/delete_ic"
            app:tint="?colorError" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
