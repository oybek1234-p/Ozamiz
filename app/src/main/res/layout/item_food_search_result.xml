<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="0dp"
    android:layout_marginVertical="4dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="?attr/colorSurfaceContainer"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:rippleColor="?attr/colorControlHighlight"
    app:strokeColor="?attr/colorOutlineVariant"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="14dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/text_view_food_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/roboto_bold"
                android:textColor="?attr/colorOnSurface"
                android:textSize="16sp"
                tools:text="Osh (Palov)" />

            <TextView
                android:id="@+id/text_view_food_serving"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="14sp"
                tools:text="106 kkal bo'lak (40 gr)" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="8dp">

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/progress_add_food"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                app:indicatorSize="44dp"
                app:trackThickness="2.5dp"
                app:trackCornerRadius="2dp"
                app:indicatorColor="?attr/colorPrimary"
                app:trackColor="@android:color/transparent"
                android:max="100"
                android:progress="0"
                android:visibility="invisible"
                tools:visibility="visible"
                tools:progress="60" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_add_food"
                style="@style/Widget.Material3.Button.IconButton.Filled"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_gravity="center"
                android:padding="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                app:cornerSize="17dp"
                app:backgroundTint="?attr/colorPrimary"
                app:iconTint="?attr/colorOnPrimary"
                app:icon="@drawable/add_ic"
                app:iconSize="18dp"
                app:iconPadding="0dp"
                app:iconGravity="textStart" />

        </FrameLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
