<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_main_calories"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        app:cardBackgroundColor="?attr/colorSurfaceContainerLowest"
        app:cardCornerRadius="24dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp"
        app:strokeColor="?attr/colorOutlineVariant">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Main Progress Card Content -->
            <LinearLayout
                android:id="@+id/layout_normal_progress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:id="@+id/layout_calorie_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:gravity="start|center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/text_calories_remaining_count"
                            style="@style/TextAppearance.Material3.HeadlineLarge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/roboto_bold"
                            android:includeFontPadding="false"
                            android:textColor="?attr/colorOnSurface"
                            tools:text="1,578" />

                        <TextView
                            android:id="@+id/text_calories_remaining_label"
                            style="@style/Text2_15"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="@string/calories_remaining"
                            android:textColor="?attr/colorOnSurfaceVariant" />
                    </LinearLayout>

                    <!-- Simple Limit Status -->
                    <LinearLayout
                        android:id="@+id/layout_limit_info"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone"
                     >

                        <TextView
                            android:id="@+id/text_limit_title"
                            style="@style/Title3_17"
                            android:textSize="18sp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/roboto_bold"
                            android:textColor="?attr/colorOnSurface"
                            tools:text="🔥 Yog' yoqilyapti" />

                        <TextView
                            android:id="@+id/text_limit_subtitle"
                            style="@style/Text2_15"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:fontFamily="@font/roboto_regular"
                            android:textColor="?attr/colorOnSurface"
                            tools:text="Me'yordan oshdi" />

                    </LinearLayout>

                </RelativeLayout>

                <!-- Progress indicators (always visible) -->
                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/progress_calories_circular"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    app:indicatorColor="?attr/colorPrimary"
                    app:trackColor="?attr/colorSurfaceContainerHigh"
                    app:trackCornerRadius="6dp"
                    app:trackThickness="12dp"
                    app:indicatorTrackGapSize="0dp"
                    app:trackStopIndicatorSize="0dp"
                    tools:progress="40" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/text_eaten_count"
                        style="@style/Text2_15"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="?attr/colorOnSurface"
                        tools:text="Yeyildi: 2600. Maqsad: 2600 kkal" />

                    <TextView
                        android:id="@+id/btn_detailed_info"
                        style="@style/Headline3_15"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:textSize="15sp"
                        android:padding="0dp"
                        android:text="Batafsil"
                        android:textColor="?attr/colorOnSurface"
                        android:visibility="gone"
                        tools:visibility="visible" />
                </LinearLayout>
            </LinearLayout>

        </FrameLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/macros_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="8dp"
        app:cardBackgroundColor="?attr/colorSurfaceContainerLowest"
        app:cardCornerRadius="24dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp"
        app:strokeColor="?attr/colorOutlineVariant">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="horizontal"
            android:padding="20dp">

            <!-- Protein -->
            <LinearLayout
                android:id="@+id/card_protein"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <com.google.android.material.imageview.ShapeableImageView
                    android:layout_width="@dimen/dimen_48"
                    android:layout_height="@dimen/dimen_48"
                    android:padding="@dimen/dimen_8"
                    android:layout_marginBottom="8dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/egg" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/protein_short"
                    android:textColor="?colorOnSurface"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/text_protein_value"
                    style="@style/Headline3_15"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginVertical="2dp"
                    android:textColor="?colorOnSurface"
                    tools:text="117 / 150" />

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/progress_protein"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="8dp"
                    app:trackStopIndicatorSize="0dp"
                    android:layout_marginTop="4dp"
                    app:indicatorColor="@color/orange"
                    app:indicatorTrackGapSize="0dp"
                    app:trackColor="?colorSurfaceContainerHigh"
                    app:trackCornerRadius="4dp"
                    app:trackStopIndicatorPadding="0dp"
                    app:trackThickness="6dp"
                    tools:progress="70" />
            </LinearLayout>

            <!-- Fat -->
            <LinearLayout
                android:id="@+id/card_fat"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <com.google.android.material.imageview.ShapeableImageView
                    android:layout_width="@dimen/dimen_48"
                    android:layout_height="48dp"
                    android:padding="@dimen/dimen_8"
                    android:layout_marginBottom="8dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/fat_ic" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/fat_short"
                    android:textColor="?colorOnSurface"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/text_fat_value"
                    style="@style/Headline3_15"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginVertical="2dp"
                    android:textColor="?colorOnSurface"
                    tools:text="60 / 80" />

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/progress_fat"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="8dp"
                    android:layout_marginTop="4dp"
                    app:indicatorColor="@color/yellow"
                    app:trackStopIndicatorSize="0dp"
                    app:indicatorTrackGapSize="0dp"
                    app:trackColor="?colorSurfaceContainerHigh"
                    app:trackCornerRadius="4dp"
                    app:trackStopIndicatorPadding="0dp"
                    app:trackThickness="6dp"
                    tools:progress="50" />
            </LinearLayout>

            <!-- Carbs -->
            <LinearLayout
                android:id="@+id/card_carbs"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <com.google.android.material.imageview.ShapeableImageView
                    android:layout_width="@dimen/dimen_48"
                    android:layout_height="@dimen/dimen_48"
                    android:layout_marginBottom="8dp"
                    android:padding="@dimen/dimen_8"
                    android:scaleType="centerInside"
                    android:src="@drawable/bread" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/carbs_short"
                    android:textColor="?colorOnSurface"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/text_carbs_value"
                    style="@style/Headline3_15"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginVertical="2dp"
                    android:textColor="?colorOnSurface"
                    tools:text="250 / 300" />

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/progress_carbs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="8dp"
                    android:layout_marginTop="4dp"
                    app:indicatorColor="?colorPrimary"
                    app:indicatorTrackGapSize="0dp"
                    app:trackColor="?colorSurfaceContainerHigh"
                    app:trackCornerRadius="4dp"
                    app:trackStopIndicatorSize="0dp"
                    app:trackStopIndicatorPadding="0dp"
                    app:trackThickness="6dp"
                    tools:progress="30" />
            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>