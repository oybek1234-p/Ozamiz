<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/dimen_12"
    app:cardCornerRadius="12dp"
    app:strokeWidth="0dp"
    app:cardElevation="1dp"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toTopOf="parent"
    app:layout_constraintVertical_bias="0.4">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?colorSurfaceContainerLowest"
        android:padding="@dimen/dimen_18">

        <TextView
            android:id="@+id/textViewCalories"
            style="@style/Title4_24"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textColor="?colorOnSurface"
            app:layout_constraintEnd_toStartOf="@+id/button_toggle_details"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="1660 qoldi" />

        <TextView
            android:id="@+id/button_toggle_details"
            style="@style/Text1_14"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingHorizontal="8dp"
            android:text="Ko'proq"
            android:textColor="?colorOnSurface"
            app:layout_constraintBottom_toBottomOf="@+id/textViewCalories"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/textViewCalories" />

        <TextView
            android:id="@+id/consumed_cal"
            style="@style/Text1_14"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_12"
            android:textColor="?colorOnSurfaceVariant"
            app:layout_constraintStart_toStartOf="@+id/textViewCalories"
            app:layout_constraintTop_toBottomOf="@+id/textViewCalories"
            tools:text="0 yeyildi" />

        <TextView
            android:id="@+id/remaining_cal"
            style="@style/Text1_14"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dimen_12"
            android:textColor="?colorOnSurfaceVariant"
            app:layout_constraintBottom_toBottomOf="@+id/consumed_cal"
            app:layout_constraintStart_toEndOf="@+id/consumed_cal"
            app:layout_constraintTop_toTopOf="@+id/consumed_cal"
            tools:text="Maqsad: 1660" />

        <TextView
            android:id="@+id/overflow_cal"
            style="@style/Text1_14"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dimen_12"
            android:fontFamily="@font/roboto_medium"
            android:textColor="?colorError"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@+id/consumed_cal"
            app:layout_constraintStart_toEndOf="@+id/remaining_cal"
            app:layout_constraintTop_toTopOf="@+id/consumed_cal"
            tools:text="395 ortiqcha"
            />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progressIndicatorCalories"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_12"
            app:indicatorColor="#4CAF50"
            app:indicatorTrackGapSize="0dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/consumed_cal"
            app:trackColor="#E0E0E0"
            app:trackCornerRadius="4dp"
            app:trackStopIndicatorSize="0dp"
            app:trackThickness="8dp" />

        <!-- Makronutrientlar (o'zgarishsiz) -->
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline_vertical_33"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.33" />
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline_vertical_66"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.66" />
        <TextView
            android:id="@+id/textViewCarbsLabel"
            style="@style/Caption2_12"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_12"
            android:text="Uglevod"
            android:textColor="?colorOnSurfaceVariant"
            app:layout_constraintEnd_toStartOf="@id/guideline_vertical_33"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/progressIndicatorCalories" />
        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progressIndicatorCarbs"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="8dp"
            android:progress="20"
            app:indicatorColor="#FFEB3B"
            app:indicatorTrackGapSize="0dp"
            app:layout_constraintEnd_toStartOf="@id/guideline_vertical_33"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/textViewCarbsLabel"
            app:trackColor="#E0E0E0"
            app:trackCornerRadius="4dp"
            app:trackStopIndicatorSize="0dp"
            app:trackThickness="8dp" />
        <TextView
            android:id="@+id/textViewCarbsValue"
            style="@style/Caption2_12"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="133 / 267 g"
            android:textColor="?colorOnSurfaceVariant"
            app:layout_constraintEnd_toStartOf="@id/guideline_vertical_33"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/progressIndicatorCarbs" />
        <TextView
            android:id="@+id/textViewProteinLabel"
            style="@style/Caption2_12"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Oqsil"
            android:textColor="?colorOnSurfaceVariant"
            app:layout_constraintEnd_toStartOf="@id/guideline_vertical_66"
            app:layout_constraintStart_toStartOf="@id/guideline_vertical_33"
            app:layout_constraintTop_toTopOf="@+id/textViewCarbsLabel" />
        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progressIndicatorProtein"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="8dp"
            android:progress="50"
            app:indicatorColor="#8BC34A"
            app:indicatorTrackGapSize="0dp"
            app:layout_constraintEnd_toStartOf="@id/guideline_vertical_66"
            app:layout_constraintStart_toStartOf="@id/guideline_vertical_33"
            app:layout_constraintTop_toBottomOf="@id/textViewProteinLabel"
            app:trackColor="#E0E0E0"
            app:trackCornerRadius="4dp"
            app:trackStopIndicatorSize="0dp"
            app:trackThickness="8dp" />
        <TextView
            android:id="@+id/textViewProteinValue"
            style="@style/Caption2_12"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="53 / 107 g"
            android:textColor="?colorOnSurfaceVariant"
            app:layout_constraintEnd_toStartOf="@id/guideline_vertical_66"
            app:layout_constraintStart_toStartOf="@id/guideline_vertical_33"
            app:layout_constraintTop_toBottomOf="@id/progressIndicatorProtein" />
        <TextView
            android:id="@+id/textViewFatsLabel"
            style="@style/Caption2_12"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Yog'"
            android:textColor="?colorOnSurfaceVariant"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@id/guideline_vertical_66"
            app:layout_constraintTop_toTopOf="@+id/textViewProteinLabel" />
        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progressIndicatorFats"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="8dp"
            android:progress="50"
            app:indicatorColor="#FF9800"
            app:indicatorTrackGapSize="0dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@id/guideline_vertical_66"
            app:layout_constraintTop_toBottomOf="@id/textViewFatsLabel"
            app:trackColor="#E0E0E0"
            app:trackCornerRadius="4dp"
            app:trackStopIndicatorSize="0dp"
            app:trackThickness="8dp" />
        <TextView
            android:id="@+id/textViewFatsValue"
            style="@style/Caption2_12"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="36 / 71 g"
            android:textColor="?colorOnSurfaceVariant"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@id/guideline_vertical_66"
            app:layout_constraintTop_toBottomOf="@id/progressIndicatorFats" />
        <androidx.constraintlayout.widget.Group
            android:id="@+id/macro_details_group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:constraint_referenced_ids="textViewCarbsLabel,progressIndicatorCarbs,textViewCarbsValue,textViewProteinLabel,progressIndicatorProtein,textViewProteinValue,textViewFatsLabel,progressIndicatorFats,textViewFatsValue"
            tools:visibility="visible" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>