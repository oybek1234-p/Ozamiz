<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_main_calories"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        app:cardBackgroundColor="?attr/colorSurfaceContainerLowest"
        app:cardCornerRadius="24dp"
        app:cardElevation="0dp"
        app:strokeWidth="1dp"
        app:strokeColor="?attr/colorOutlineVariant">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Normal Progress State -->
            <LinearLayout
                android:id="@+id/layout_normal_progress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerInParent="true"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/text_calories_remaining_count"
                            style="@style/TextAppearance.Material3.HeadlineLarge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/roboto_bold"
                            android:includeFontPadding="false"
                            android:textColor="?attr/colorOnSurface"
                            tools:text="1,578" />

                        <TextView
                            android:id="@+id/text_calories_remaining_label"
                            style="@style/TextAppearance.Material3.TitleMedium"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/calories_remaining"
                            android:textColor="?attr/colorOnSurfaceVariant" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/btn_how_it_works"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_alignParentTop="true"
                        android:layout_alignParentEnd="true"
                        android:background="?selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:focusable="true"
                        android:padding="8dp"
                        android:src="@drawable/info_ic"
                        app:tint="?attr/colorOnSurfaceVariant" />
                </RelativeLayout>

                <!-- Progress -->
                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/progress_calories_circular"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    app:indicatorColor="?attr/colorPrimary"
                    app:trackColor="?attr/colorSurfaceContainerHigh"
                    app:trackCornerRadius="6dp"
                    app:trackThickness="12dp"
                    app:indicatorTrackGapSize="0dp"
                    tools:progress="40" />

                <!-- Eaten / Target Info -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/check_ic"
                        app:tint="?attr/colorOnSurfaceVariant" />

                    <TextView
                        android:id="@+id/text_eaten_count"
                        style="@style/TextAppearance.Material3.BodyMedium"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        tools:text="Yeyildi: 2600. Maqsad: 2600 kkal" />
                </LinearLayout>
            </LinearLayout>

            <!-- Limit Reached / Optimal State -->
            <LinearLayout
                android:id="@+id/layout_limit_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp"
                android:gravity="center"
                android:visibility="gone">
                
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:layout_gravity="center"
                    app:cardCornerRadius="40dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
                    app:strokeWidth="0dp">
                    <ImageView
                        android:id="@+id/img_limit_state"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="16dp"
                        android:src="@drawable/info_ic" />
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:id="@+id/text_limit_title"
                    style="@style/TextAppearance.Material3.HeadlineSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:fontFamily="@font/roboto_bold"
                    android:gravity="center"
                    android:textColor="?attr/colorOnSurface"
                    tools:text="Bugunga shusi kifoya" />

                <TextView
                    android:id="@+id/text_limit_subtitle"
                    style="@style/TextAppearance.Material3.BodyMedium"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:lineSpacingExtra="4dp"
                    tools:text="Siz bugun uchun belgilangan limitga yetdingiz." />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_detailed_info"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="24dp"
                    android:text="Batafsil ma'lumot"
                    app:cornerRadius="16dp"
                    android:textSize="16sp" />
            </LinearLayout>

        </FrameLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/macros_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="16dp"
        app:cardBackgroundColor="?attr/colorSurfaceContainerLowest"
        app:cardCornerRadius="24dp"
        app:cardElevation="0dp"
        app:strokeWidth="1dp"
        app:strokeColor="?attr/colorOutlineVariant">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="horizontal"
            android:padding="20dp">

            <!-- Protein -->
            <LinearLayout
                android:id="@+id/card_protein"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <com.google.android.material.imageview.ShapeableImageView
                    android:layout_width="@dimen/dimen_48"
                    android:layout_height="@dimen/dimen_48"
                    android:layout_marginBottom="4dp"
                    android:background="@color/white"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
                    android:scaleType="centerInside"
                    android:src="@drawable/gosht_ic" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/protein_short"
                    android:textColor="?colorOnSurfaceVariant"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/text_protein_value"
                    style="@style/TextAppearance.Material3.TitleSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginVertical="2dp"
                    android:fontFamily="@font/roboto_bold"
                    android:textColor="?colorOnSurface"
                    tools:text="117 / 150" />

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/progress_protein"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="8dp"
                    app:trackStopIndicatorSize="0dp"

                    android:layout_marginTop="4dp"
                    app:indicatorColor="@color/orange"
                    app:indicatorTrackGapSize="0dp"
                    app:trackColor="?colorSurfaceContainerHigh"
                    app:trackCornerRadius="4dp"
                    app:trackStopIndicatorPadding="0dp"
                    app:trackThickness="6dp"
                    tools:progress="70" />
            </LinearLayout>

            <!-- Fat -->
            <LinearLayout
                android:id="@+id/card_fat"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <com.google.android.material.imageview.ShapeableImageView
                    android:layout_width="@dimen/dimen_48"
                    android:layout_height="48dp"
                    android:layout_marginBottom="4dp"
                    android:background="@color/white"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
                    android:scaleType="centerInside"
                    android:src="@drawable/yongoq_ic" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/fat_short"
                    android:textColor="?colorOnSurfaceVariant"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/text_fat_value"
                    style="@style/TextAppearance.Material3.TitleSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginVertical="2dp"
                    android:fontFamily="@font/roboto_bold"
                    android:textColor="?colorOnSurface"
                    tools:text="60 / 80" />

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/progress_fat"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="8dp"
                    android:layout_marginTop="4dp"
                    app:indicatorColor="@color/yellow"
                    app:trackStopIndicatorSize="0dp"
                    app:indicatorTrackGapSize="0dp"
                    app:trackColor="?colorSurfaceContainerHigh"
                    app:trackCornerRadius="4dp"
                    app:trackStopIndicatorPadding="0dp"
                    app:trackThickness="6dp"
                    tools:progress="50" />
            </LinearLayout>

            <!-- Carbs -->
            <LinearLayout
                android:id="@+id/card_carbs"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <com.google.android.material.imageview.ShapeableImageView
                    android:layout_width="@dimen/dimen_48"
                    android:layout_height="@dimen/dimen_48"
                    android:layout_marginBottom="4dp"
                    android:background="@color/white"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
                    android:scaleType="centerInside"
                    android:src="@drawable/non_ic" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/carbs_short"
                    android:textColor="?colorOnSurfaceVariant"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/text_carbs_value"
                    style="@style/TextAppearance.Material3.TitleSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginVertical="2dp"
                    android:fontFamily="@font/roboto_bold"
                    android:textColor="?colorOnSurface"
                    tools:text="250 / 300" />

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/progress_carbs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="8dp"
                    android:layout_marginTop="4dp"
                    app:indicatorColor="?colorPrimary"
                    app:indicatorTrackGapSize="0dp"
                    app:trackColor="?colorSurfaceContainerHigh"
                    app:trackCornerRadius="4dp"
                    app:trackStopIndicatorSize="0dp"
                    app:trackStopIndicatorPadding="0dp"
                    app:trackThickness="6dp"
                    tools:progress="30" />
            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>