<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_main_calories"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        app:cardBackgroundColor="?attr/colorSurfaceContainerLowest"
        app:cardCornerRadius="24dp"
        app:cardElevation="1dp"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Title & detailed button -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Bugungi limit"
                    android:fontFamily="@font/roboto_medium"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="15sp"/>

                <ImageButton
                    android:id="@+id/btn_detailed_info"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/info_ic"
                    app:tint="?attr/colorOutline" />
            </LinearLayout>

            <!-- Main Circular Progress -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/progress_calories_circular"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    app:indicatorColor="?attr/colorPrimary"
                    app:trackColor="?attr/colorSurfaceContainerHigh"
                    app:indicatorSize="160dp"
                    app:trackThickness="16dp"
                    app:trackCornerRadius="8dp"
                    tools:progress="65" />

                <LinearLayout
                    android:id="@+id/layout_calorie_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/text_calories_remaining_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/roboto_bold"
                        android:textSize="36sp"
                        android:textColor="?attr/colorOnSurface"
                        tools:text="1250" />

                    <TextView
                        android:id="@+id/text_calories_remaining_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="kkal qoldi"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="14sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layout_limit_info"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:orientation="vertical"
                    android:visibility="gone"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/text_limit_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/roboto_bold"
                        android:textSize="20sp"
                        android:textColor="@color/red"
                        tools:text="Limit to'ldi!" />

                    <TextView
                        android:id="@+id/text_limit_subtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Endi yemaslik kerak"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="12sp" />
                </LinearLayout>
            </FrameLayout>

            <TextView
                android:id="@+id/text_eaten_count"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:fontFamily="@font/roboto_medium"
                android:textColor="?attr/colorOnSurface"
                android:textSize="14sp"
                tools:text="Yeyildi: 850 kkal  •  Maqsad: 2100 kkal" />

            <!-- Macros Row -->
            <LinearLayout
                android:id="@+id/macros_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="horizontal"
                android:baselineAligned="false">

                <!-- Protein -->
                <LinearLayout
                    android:id="@+id/card_protein"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Oqsil"
                        android:textSize="13sp"
                        android:textColor="?attr/colorOnSurfaceVariant"/>

                    <TextView
                        android:id="@+id/text_protein_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/roboto_bold"
                        android:textSize="15sp"
                        android:textColor="?attr/colorOnSurface"
                        tools:text="45 / 120g"/>

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/progress_protein"
                        android:layout_width="50dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        app:trackThickness="4dp"
                        app:trackCornerRadius="2dp"
                        app:indicatorColor="?attr/colorPrimary"
                        app:trackColor="?attr/colorSurfaceContainerHigh"
                        tools:progress="30"/>
                </LinearLayout>

                <!-- Fat -->
                <LinearLayout
                    android:id="@+id/card_fat"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Yog'"
                        android:textSize="13sp"
                        android:textColor="?attr/colorOnSurfaceVariant"/>

                    <TextView
                        android:id="@+id/text_fat_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/roboto_bold"
                        android:textSize="15sp"
                        android:textColor="?attr/colorOnSurface"
                        tools:text="30 / 60g"/>

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/progress_fat"
                        android:layout_width="50dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        app:trackThickness="4dp"
                        app:trackCornerRadius="2dp"
                        app:indicatorColor="@color/yellow"
                        app:trackColor="?attr/colorSurfaceContainerHigh"
                        tools:progress="50"/>
                </LinearLayout>

                <!-- Carbs -->
                <LinearLayout
                    android:id="@+id/card_carbs"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Uglevod"
                        android:textSize="13sp"
                        android:textColor="?attr/colorOnSurfaceVariant"/>

                    <TextView
                        android:id="@+id/text_carbs_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/roboto_bold"
                        android:textSize="15sp"
                        android:textColor="?attr/colorOnSurface"
                        tools:text="150 / 200g"/>

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/progress_carbs"
                        android:layout_width="50dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        app:trackThickness="4dp"
                        app:trackCornerRadius="2dp"
                        app:indicatorColor="@color/blue"
                        app:trackColor="?attr/colorSurfaceContainerHigh"
                        tools:progress="75"/>
                </LinearLayout>

            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>