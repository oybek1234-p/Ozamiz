<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        app:cardBackgroundColor="?attr/colorSurfaceContainerLowest"
        app:cardCornerRadius="24dp"
        app:cardElevation="0dp"
        app:strokeWidth="1dp"
        app:strokeColor="?attr/colorOutlineVariant">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Top row: remaining + how it works -->
            <!-- Top row: remaining + how it works -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/text_calories_remaining_count"
                        style="@style/TextAppearance.Material3.HeadlineMedium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/roboto_bold"
                        android:includeFontPadding="false"
                        android:textColor="?colorOnSurface"
                        tools:text="1,578" />

                    <TextView
                        android:id="@+id/text_calories_remaining_label"
                        style="@style/TextAppearance.Material3.BodyLarge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:layout_marginTop="@dimen/dimen_4"
                        android:text="@string/calories_remaining"
                        android:textColor="?colorOnSurface" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/btn_how_it_works"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_alignParentTop="true"
                    android:layout_alignParentEnd="true"
                    android:background="?selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="6dp"
                    android:src="@drawable/info_ic"
                    app:tint="?colorOnSurfaceVariant" />
            </RelativeLayout>

            <!-- Progress -->
            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/progress_calories_circular"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:indicatorColor="?colorPrimary"
                app:indicatorTrackGapSize="0dp"
                app:trackColor="?colorSurfaceContainerHigh"
                app:trackCornerRadius="5dp"
                app:trackStopIndicatorPadding="0dp"
                app:trackStopIndicatorSize="0dp"
                app:trackThickness="10dp"
                tools:progress="40" />

            <!-- Eaten / Burned -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <!-- Eaten -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="start|center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/text_eaten_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/yeyildi"
                        android:textColor="?colorOnSurfaceVariant"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/text_eaten_count"
                        style="@style/TextAppearance.Material3.TitleMedium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:fontFamily="@font/roboto_medium"
                        android:textColor="?colorOnSurface"
                        tools:text="1200" />
                </LinearLayout>

                <!-- Burned -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end|center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/text_burned_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/burned"
                        android:textColor="?colorOnSurfaceVariant"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/text_burned_count"
                        style="@style/TextAppearance.Material3.TitleMedium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:fontFamily="@font/roboto_medium"
                        android:textColor="?colorOnSurface"
                        tools:text="350" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/macros_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="16dp"
        app:cardBackgroundColor="?attr/colorSurfaceContainerLowest"
        app:cardCornerRadius="24dp"
        app:cardElevation="0dp"
        app:strokeWidth="1dp"
        app:strokeColor="?attr/colorOutlineVariant">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="horizontal"
            android:padding="20dp">

            <!-- Protein -->
            <LinearLayout
                android:id="@+id/card_protein"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <com.google.android.material.imageview.ShapeableImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginBottom="4dp"
                    android:background="@color/white"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
                    android:scaleType="centerInside"
                    android:src="@drawable/gosht_ic" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/protein_short"
                    android:textColor="?colorOnSurfaceVariant"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/text_protein_value"
                    style="@style/TextAppearance.Material3.TitleSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginVertical="2dp"
                    android:fontFamily="@font/roboto_bold"
                    android:textColor="?colorOnSurface"
                    tools:text="117 / 150" />

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/progress_protein"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="8dp"
                    app:trackStopIndicatorSize="0dp"

                    android:layout_marginTop="4dp"
                    app:indicatorColor="@color/orange"
                    app:indicatorTrackGapSize="0dp"
                    app:trackColor="?colorSurfaceContainerHigh"
                    app:trackCornerRadius="4dp"
                    app:trackStopIndicatorPadding="0dp"
                    app:trackThickness="6dp"
                    tools:progress="70" />
            </LinearLayout>

            <!-- Fat -->
            <LinearLayout
                android:id="@+id/card_fat"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <com.google.android.material.imageview.ShapeableImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginBottom="4dp"
                    android:background="@color/white"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
                    android:scaleType="centerInside"
                    android:src="@drawable/yongoq_ic" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/fat_short"
                    android:textColor="?colorOnSurfaceVariant"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/text_fat_value"
                    style="@style/TextAppearance.Material3.TitleSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginVertical="2dp"
                    android:fontFamily="@font/roboto_bold"
                    android:textColor="?colorOnSurface"
                    tools:text="60 / 80" />

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/progress_fat"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="8dp"
                    android:layout_marginTop="4dp"
                    app:indicatorColor="@color/yellow"
                    app:trackStopIndicatorSize="0dp"
                    app:indicatorTrackGapSize="0dp"
                    app:trackColor="?colorSurfaceContainerHigh"
                    app:trackCornerRadius="4dp"
                    app:trackStopIndicatorPadding="0dp"
                    app:trackThickness="6dp"
                    tools:progress="50" />
            </LinearLayout>

            <!-- Carbs -->
            <LinearLayout
                android:id="@+id/card_carbs"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <com.google.android.material.imageview.ShapeableImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginBottom="4dp"
                    android:background="@color/white"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
                    android:scaleType="centerInside"
                    android:src="@drawable/non_ic" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/carbs_short"
                    android:textColor="?colorOnSurfaceVariant"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/text_carbs_value"
                    style="@style/TextAppearance.Material3.TitleSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginVertical="2dp"
                    android:fontFamily="@font/roboto_bold"
                    android:textColor="?colorOnSurface"
                    tools:text="250 / 300" />

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/progress_carbs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="8dp"
                    android:layout_marginTop="4dp"
                    app:indicatorColor="?colorPrimary"
                    app:indicatorTrackGapSize="0dp"
                    app:trackColor="?colorSurfaceContainerHigh"
                    app:trackCornerRadius="4dp"
                    app:trackStopIndicatorSize="0dp"
                    app:trackStopIndicatorPadding="0dp"
                    app:trackThickness="6dp"
                    tools:progress="30" />
            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>