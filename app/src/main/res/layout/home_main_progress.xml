<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="@dimen/dimen_18">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_main_calories"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        app:cardBackgroundColor="?attr/colorSurfaceContainerLowest"
        app:cardCornerRadius="24dp"
        app:cardElevation="0dp"
        app:strokeColor="?attr/colorOutlineVariant"
        app:strokeWidth="0dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:id="@+id/layout_normal_progress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingVertical="4dp">

                    <!-- Left: Yeyildi -->
                    <LinearLayout
                        android:id="@+id/layout_eaten_info"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/text_calories_eaten_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/roboto_bold"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="18sp"
                            tools:text="0" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="@font/roboto_regular"
                            android:text="Yeyildi"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <!-- Center: Progress Circle -->
                    <FrameLayout
                        android:id="@+id/layout_calorie_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">

                        <com.google.android.material.progressindicator.CircularProgressIndicator
                            android:id="@+id/progress_calories_circular"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            app:indicatorSize="120dp"
                            app:indicatorTrackGapSize="0dp"
                            app:trackColor="?attr/colorSurfaceContainerHigh"
                            app:trackCornerRadius="8dp"
                            app:trackThickness="6dp"
                            tools:progress="40" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/text_calories_remaining_count"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/roboto_bold"
                                android:includeFontPadding="false"
                                android:textColor="?attr/colorOnSurface"
                                android:textSize="24sp"
                                tools:text="1200" />

                            <TextView
                                android:id="@+id/text_calories_remaining_label"
                                style="@style/Text1_14"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFamily="@font/roboto_regular"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                tools:text="qoldi" />
                        </LinearLayout>
                    </FrameLayout>

                    <!-- Right: Yoqildi -->
                    <LinearLayout
                        android:id="@+id/layout_burned_info"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/text_calories_burned_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/roboto_bold"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="18sp"
                            tools:text="0" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="@font/roboto_regular"
                            android:text="Yoqildi"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textSize="14sp" />
                    </LinearLayout>

                </LinearLayout>


                <!-- Simple Limit Status -->
                <LinearLayout
                    android:id="@+id/layout_limit_info"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/text_limit_title"
                        style="@style/Title3_17"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/roboto_bold"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="18sp"
                        tools:text="🔥 Yog' yoqilyapti" />

                    <TextView
                        android:id="@+id/text_limit_subtitle"
                        style="@style/Text2_15"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="@font/roboto_regular"
                        android:textColor="?attr/colorOnSurface"
                        tools:text="Me'yordan oshdi" />

                </LinearLayout>

            </LinearLayout>

        </FrameLayout>
    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:id="@+id/macros_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="8dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <!-- Protein Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_protein"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?selectableItemBackground"
            app:cardBackgroundColor="?attr/colorSurfaceContainerLowest"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="10dp">

                <FrameLayout
                    android:layout_width="48dp"
                    android:layout_height="48dp">

                    <com.google.android.material.progressindicator.CircularProgressIndicator
                        android:id="@+id/progress_protein"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        app:indicatorColor="@color/orange"
                        app:indicatorSize="48dp"
                        app:indicatorTrackGapSize="0dp"
                        app:trackColor="?colorSurfaceContainerHigh"
                        app:trackCornerRadius="3dp"
                        app:trackThickness="4dp"
                        tools:progress="70" />

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/egg_ic" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="@font/roboto_regular"
                    android:text="@string/protein_short"
                    android:textColor="?colorOnSurfaceVariant"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/text_protein_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:fontFamily="@font/roboto_medium"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="12sp"
                    tools:text="47 qoldi" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Fat Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_fat"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="4dp"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?selectableItemBackground"
            app:cardBackgroundColor="?attr/colorSurfaceContainerLowest"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="10dp">

                <FrameLayout
                    android:layout_width="48dp"
                    android:layout_height="48dp">

                    <com.google.android.material.progressindicator.CircularProgressIndicator
                        android:id="@+id/progress_fat"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        app:indicatorColor="@color/yellow"
                        app:indicatorSize="48dp"
                        app:indicatorTrackGapSize="0dp"
                        app:trackColor="?colorSurfaceContainerHigh"
                        app:trackCornerRadius="3dp"
                        app:trackThickness="4dp"
                        tools:progress="50" />

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/fat_ic" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="@font/roboto_regular"
                    android:text="@string/fat_short"
                    android:textColor="?colorOnSurfaceVariant"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/text_fat_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:fontFamily="@font/roboto_medium"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="12sp"
                    tools:text="20 qoldi" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Carbs Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_carbs"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?selectableItemBackground"
            app:cardBackgroundColor="?attr/colorSurfaceContainerLowest"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="10dp">

                <FrameLayout
                    android:layout_width="48dp"
                    android:layout_height="48dp">

                    <com.google.android.material.progressindicator.CircularProgressIndicator
                        android:id="@+id/progress_carbs"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        app:indicatorColor="?colorPrimary"
                        app:indicatorSize="48dp"
                        app:indicatorTrackGapSize="0dp"
                        app:trackColor="?colorSurfaceContainerHigh"
                        app:trackCornerRadius="3dp"
                        app:trackThickness="4dp"
                        tools:progress="30" />

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/bread" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="@font/roboto_regular"
                    android:text="@string/carbs_short"
                    android:textColor="?colorOnSurfaceVariant"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/text_carbs_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:fontFamily="@font/roboto_medium"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="12sp"
                    tools:text="109 qoldi" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>


    <!-- Limit Reached Standalone Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/limit_reached"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="12dp"
        android:visibility="gone"
        app:cardBackgroundColor="?attr/colorSurfaceContainerLowest"
        app:cardCornerRadius="20dp"
        app:cardElevation="0dp"
        app:strokeColor="?attr/colorOutlineVariant"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/text_limit_emoji"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="12dp"
                    android:includeFontPadding="false"
                    android:textSize="28sp"
                    tools:text="🔥" />

                <TextView
                    android:id="@+id/text_limit_reached_message"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/roboto_medium"
                    android:lineSpacingExtra="2dp"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="15sp"
                    tools:text="Maqsad bajarildi, tez orada tanangiz yog' yoqishga o'tadi, ertagacha faqat suv ichishingiz mumkin" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="end"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_how_fat_burned"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Qanday qilib yog\' yoqiladi?"
                    android:textColor="?attr/colorPrimary"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_hungry_what_to_eat"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:backgroundTint="?attr/colorPrimary"
                    android:fontFamily="@font/roboto_bold"
                    android:text="Qornim ochdi"
                    android:textColor="?attr/colorOnPrimary"
                    app:cornerRadius="12dp" />
            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>