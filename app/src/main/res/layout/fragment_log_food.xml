<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurfaceContainerLowest"
    android:orientation="vertical">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurfaceContainerLowest"
        app:elevation="0dp">

        <uz.oybek.ozamiz.ui.base.MyToolBar
            android:id="@+id/toolbar_log_food"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="?attr/colorSurfaceContainerLowest"
            app:navigationIcon="@drawable/arrow_back"
            app:titleCentered="true"
            app:titleTextColor="?attr/colorOnSurface"
            tools:title="Nonushta" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/main_scroll_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="24dp">

            <FrameLayout
                android:id="@+id/banner_ad_container_log_food"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:visibility="gone" />

            <!-- Empty State -->
            <LinearLayout
                android:id="@+id/layout_empty_history"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="56dp"
                android:layout_marginBottom="32dp"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <FrameLayout
                    android:id="@+id/container_empty_icon"
                    android:layout_width="88dp"
                    android:layout_height="88dp"
                    android:background="@drawable/bg_circle_surface"
                    android:backgroundTint="?attr/colorSurfaceContainer">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/img_empty_meal_icon"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_gravity="center"
                        android:scaleType="fitCenter"
                        tools:src="@drawable/breakfast_ic" />
                </FrameLayout>

                <TextView
                    android:id="@+id/text_empty_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:fontFamily="@font/roboto_bold"
                    android:gravity="center"
                    android:text="@string/log_food_empty_title"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/text_empty_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="@font/roboto_regular"
                    android:gravity="center"
                    android:lineSpacingExtra="3dp"
                    android:paddingHorizontal="32dp"
                    android:text="@string/log_food_empty_subtitle"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="14sp" />

            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_recent_logs"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:nestedScrollingEnabled="false"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:listitem="@layout/item_todays_food" />

        </FrameLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Action Button Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurfaceContainerLowest"
        android:elevation="8dp"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_add_food"
            style="@style/Widget.Material3.Button"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:backgroundTint="?attr/colorPrimary"
            android:fontFamily="@font/roboto_bold"
            android:text="@string/add_food_btn"
            android:textColor="?attr/colorOnPrimary"
            android:textSize="16sp"
            app:cornerRadius="27dp"
            app:icon="@drawable/add_ic"
            app:iconGravity="textStart"
            app:iconTint="?attr/colorOnPrimary" />

    </LinearLayout>

</LinearLayout>
