<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?colorSurface"
    tools:context=".ui.log.LogFoodFragment">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout_logFood"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?colorSurface"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar_logFood"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@drawable/arrow_back"
            app:navigationIconTint="?colorOnSurface"
            app:titleTextColor="?colorOnSurface"
            tools:title="Nonushta Qo'shish" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                style="@style/Title3_17"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/upload_meal_photo"
                android:textColor="?colorPrimary" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_image_container_log"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_marginTop="@dimen/dimen_8"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeColor="?colorOutlineVariant"
                app:strokeWidth="1dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <ImageView
                        android:id="@+id/imageView_selectedLogImage"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:visibility="gone"
                        tools:src="@drawable/placeholder_food"
                        tools:visibility="visible"
                        android:contentDescription="@string/selected_meal_image_preview" />

                    <LinearLayout
                        android:id="@+id/layout_addImagePlaceholder_log"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="?colorSurfaceContainerLow"
                        android:gravity="center"

                        android:orientation="vertical"
                        android:visibility="visible">

                        <ImageView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:src="@drawable/camera_ic"
                            app:tint="?colorPrimary"
                            android:contentDescription="@null" />

                        <TextView
                            style="@style/Subtitle2_14"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/take_photo_placeholder"
                            android:textColor="?colorOnSurface" />

                    </LinearLayout>

                    <ImageButton
                        android:id="@+id/button_remove_image_log"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/close_ic"
                        app:tint="@color/white"
                        android:background="@drawable/oval_background_with_opacity"
                        android:layout_gravity="top|end"
                        android:layout_margin="8dp"
                        android:visibility="gone"
                        tools:visibility="visible"
                        android:contentDescription="@string/remove_image"/>

                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>


            <TextView
                style="@style/Title3_17"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_24"
                android:paddingEnd="@dimen/dimen_24"
                tools:ignore="RtlSymmetry"
                android:text="@string/ovqat_haqida_yozing_ixtiyoriy"
                android:textColor="?colorPrimary" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/textInputLayout_foodDescription_log"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_18"
                app:helperTextEnabled="true"
                app:hintEnabled="false">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editText_foodDescription_log"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="none"
                    android:textColorHint="?colorOnSurfaceVariant"
                    android:gravity="top"
                    android:hint="@string/food_description_hint"
                    android:imeOptions="actionDone"
                    android:inputType="textMultiLine|textCapSentences"
                    android:minLines="3"
                    android:padding="@dimen/dimen_18"
                    android:background="@drawable/round_lay_stroke"
                    android:textSize="15sp" />
            </com.google.android.material.textfield.TextInputLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="?colorSurface"
        android:elevation="4dp"
        android:padding="16dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_analyze_and_save"
                style="@style/Widget.Material3.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="56dp"
                android:paddingEnd="56dp"
                android:text="Tahlil qilish"
                app:icon="@drawable/search_ic"
                app:iconGravity="textStart" />

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/progress_analyze"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:indeterminate="true"
                android:visibility="gone"
                app:indicatorColor="?colorOnPrimary"
                app:trackColor="?colorSurfaceContainerLowest"
                app:indicatorSize="24dp" />
        </FrameLayout>

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>