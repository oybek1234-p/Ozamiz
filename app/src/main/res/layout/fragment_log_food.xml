<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?colorSurfaceContainer">

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/rootCoordinatorLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fitsSystemWindows="false"
        tools:context=".ui.feature.log.food.LogFoodFragment">

        <com.google.android.material.appbar.AppBarLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            app:elevation="0dp">

            <uz.oybek.ozamiz.ui.base.MyToolBar
                android:id="@+id/toolbar_log_food"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                app:navigationIcon="@drawable/arrow_back"
                app:title="" />

        </com.google.android.material.appbar.AppBarLayout>

        <androidx.core.widget.NestedScrollView
            android:id="@+id/main_scroll_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:orientation="vertical"
                android:paddingBottom="100dp">

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:paddingTop="8dp"
                    android:scrollbars="none">

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chipGroup_meal_type"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="20dp"
                        app:chipSpacingHorizontal="8dp"
                        app:selectionRequired="true"
                        app:singleLine="true"
                        app:singleSelection="true" />
                </HorizontalScrollView>

                <!-- Action Section -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:orientation="vertical"
                    android:paddingHorizontal="18dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="vertical">


                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/button_quick_camera"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp"
                            android:clickable="true"
                            android:focusable="true"
                            app:cardBackgroundColor="?attr/colorPrimary"
                            app:cardCornerRadius="16dp"
                            app:cardElevation="0dp"
                            app:strokeWidth="0dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:padding="16dp">

                                <ImageView
                                    android:layout_width="24dp"
                                    android:layout_height="24dp"
                                    android:src="@drawable/camera_ic"
                                    app:tint="?attr/colorOnPrimary" />

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="16dp"
                                    android:layout_weight="1"
                                    android:fontFamily="@font/roboto_medium"
                                    android:text="@string/log_food_camera_title"
                                    android:textColor="?attr/colorOnPrimary"
                                    android:textSize="16sp" />

                                <com.google.android.material.card.MaterialCardView
                                    android:id="@+id/badge_camera_premium"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginEnd="12dp"
                                    app:cardBackgroundColor="@color/yellow"
                                    app:cardCornerRadius="6dp"
                                    app:strokeWidth="0dp"
                                    android:visibility="gone"
                                    tools:visibility="visible">
                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:paddingHorizontal="6dp"
                                        android:paddingVertical="2dp"
                                        android:text="PREMIUM"
                                        android:textColor="#002111"
                                        android:textSize="10sp"
                                        android:fontFamily="@font/roboto_bold" />
                                </com.google.android.material.card.MaterialCardView>

                                <ImageView
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:rotation="180"
                                    android:src="@drawable/arrow_back"
                                    app:tint="?attr/colorOnPrimary" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <!-- Option: Write -->
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/button_show_text_input"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp"
                            android:clickable="true"
                            android:focusable="true"
                            app:strokeWidth="0dp"
                            app:cardBackgroundColor="?attr/colorSurfaceContainerLowest"
                            app:cardCornerRadius="16dp"
                            app:cardElevation="0dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:padding="16dp">

                                <ImageView
                                    android:layout_width="24dp"
                                    android:layout_height="24dp"
                                    android:src="@drawable/edit"
                                    app:tint="?attr/colorOnSurface" />

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="16dp"
                                    android:layout_weight="1"
                                    android:fontFamily="@font/roboto_medium"
                                    android:text="@string/log_food_text_title"
                                    android:textColor="?attr/colorOnSurface"
                                    android:textSize="16sp" />

                                <com.google.android.material.card.MaterialCardView
                                    android:id="@+id/badge_text_premium"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginEnd="12dp"
                                    app:cardBackgroundColor="@color/yellow"
                                    app:cardCornerRadius="6dp"
                                    app:strokeWidth="0dp"
                                    android:visibility="gone"
                                    tools:visibility="visible">
                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:paddingHorizontal="6dp"
                                        android:paddingVertical="2dp"
                                        android:text="PREMIUM"
                                        android:textColor="#002111"
                                        android:textSize="10sp"
                                        android:fontFamily="@font/roboto_bold" />
                                </com.google.android.material.card.MaterialCardView>

                                <ImageView
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:rotation="180"
                                    android:src="@drawable/arrow_back"
                                    app:tint="?attr/colorOnSurfaceVariant" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <!-- Option: Voice -->
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/button_voice_input"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp"
                            android:clickable="true"
                            android:focusable="true"
                            app:cardBackgroundColor="?attr/colorSurfaceContainerLowest"
                            app:cardCornerRadius="16dp"
                            app:cardElevation="0dp"
                            app:strokeWidth="0dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:padding="16dp">

                                <ImageView
                                    android:layout_width="24dp"
                                    android:layout_height="24dp"
                                    android:src="@drawable/mic_ic"
                                    app:tint="?attr/colorOnSurface" />

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="16dp"
                                    android:layout_weight="1"
                                    android:fontFamily="@font/roboto_medium"
                                    android:text="@string/log_food_voice_title"
                                    android:textColor="?attr/colorOnSurface"
                                    android:textSize="16sp" />

                                <com.google.android.material.card.MaterialCardView
                                    android:id="@+id/badge_voice_premium"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginEnd="12dp"
                                    app:cardBackgroundColor="@color/yellow"
                                    app:cardCornerRadius="6dp"
                                    app:strokeWidth="0dp"
                                    android:visibility="gone"
                                    tools:visibility="visible">
                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:paddingHorizontal="6dp"
                                        android:paddingVertical="2dp"
                                        android:text="PREMIUM"
                                        android:textColor="#002111"
                                        android:textSize="10sp"
                                        android:fontFamily="@font/roboto_bold" />
                                </com.google.android.material.card.MaterialCardView>

                                <ImageView
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:rotation="180"
                                    android:src="@drawable/arrow_back"
                                    app:tint="?attr/colorOnSurfaceVariant" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/button_saved_foods"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp"
                            android:clickable="true"
                            android:focusable="true"
                            app:cardBackgroundColor="?attr/colorSurfaceContainerLowest"
                            app:cardCornerRadius="16dp"
                            app:strokeWidth="0dp"
                            app:cardElevation="0dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:padding="16dp">

                                <ImageView
                                    android:layout_width="24dp"
                                    android:layout_height="24dp"
                                    android:src="@drawable/ic_heart_outline"
                                    app:tint="?attr/colorOnSurface" />

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="16dp"
                                    android:layout_weight="1"
                                    android:fontFamily="@font/roboto_medium"
                                    android:text="@string/saved_foods_title"
                                    android:textColor="?attr/colorOnSurface"
                                    android:textSize="16sp" />

                                <ImageView
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:rotation="180"
                                    android:src="@drawable/arrow_back"
                                    app:tint="?attr/colorOnSurfaceVariant" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/button_search_list"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:clickable="true"
                            android:focusable="true"
                            app:cardBackgroundColor="?attr/colorSurfaceContainerLowest"
                            app:cardCornerRadius="16dp"
                            app:strokeWidth="0dp"
                            app:cardElevation="0dp">


                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:padding="16dp">


                                <ImageView
                                    android:layout_width="24dp"
                                    android:layout_height="24dp"
                                    android:src="@drawable/ic_search"
                                    app:tint="?attr/colorOnSurface" />

                                <TextView
                                    android:id="@+id/text_view_search_list_title"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="16dp"
                                    android:layout_weight="1"
                                    android:fontFamily="@font/roboto_medium"
                                    android:text="@string/log_food_search_list_title"
                                    android:textColor="?attr/colorOnSurface"
                                    android:textSize="16sp" />

                                <com.google.android.material.card.MaterialCardView
                                    android:id="@+id/ruyhat_premium"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginEnd="12dp"
                                    app:cardBackgroundColor="@color/yellow"
                                    app:cardCornerRadius="6dp"
                                    app:strokeWidth="0dp"
                                    android:visibility="gone"
                                    tools:visibility="visible">
                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:paddingHorizontal="6dp"
                                        android:paddingVertical="2dp"
                                        android:text="PREMIUM"
                                        android:textColor="#002111"
                                        android:textSize="10sp"
                                        android:fontFamily="@font/roboto_bold" />
                                </com.google.android.material.card.MaterialCardView>

                                <ImageView
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:rotation="180"
                                    android:src="@drawable/arrow_back"
                                    app:tint="?attr/colorOnSurfaceVariant" />



                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/button_meal_recommendation"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:layout_marginBottom="12dp"
                            android:clickable="true"
                            android:focusable="true"
                            app:cardBackgroundColor="?attr/colorSurfaceContainerLowest"
                            app:cardCornerRadius="16dp"
                            app:cardElevation="0dp"
                            app:strokeColor="?attr/colorOutlineVariant"
                            app:strokeWidth="1dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:padding="16dp">

                                <FrameLayout
                                    android:layout_width="40dp"
                                    android:layout_height="40dp"
                                    android:background="@drawable/bg_circle_filled">

                                    <ImageView
                                        android:layout_width="22dp"
                                        android:layout_height="22dp"
                                        android:layout_gravity="center"
                                        android:src="@drawable/food_ic"
                                        app:tint="?attr/colorPrimary" />
                                </FrameLayout>

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="14dp"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:fontFamily="@font/roboto_bold"
                                        android:text="Ovqatlanish tavsiyasi"
                                        android:textColor="?attr/colorOnSurface"
                                        android:textSize="15sp" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="2dp"
                                        android:fontFamily="@font/roboto_regular"
                                        android:text="Sog\'lom va balansli taomlar ro\'yxati"
                                        android:textColor="?attr/colorOnSurfaceVariant"
                                        android:textSize="13sp" />
                                </LinearLayout>

                                <ImageView
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:rotation="180"
                                    android:src="@drawable/arrow_back"
                                    app:tint="?attr/colorOnSurfaceVariant" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <FrameLayout
                            android:layout_marginTop="@dimen/dimen_12"
                            android:id="@+id/banner_ad_container_log_food"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:visibility="gone" />

                    </LinearLayout>
                </LinearLayout>



                <LinearLayout
                    android:id="@+id/layout_recent_history"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        style="@style/Headline3_15"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="24dp"
                        android:layout_marginBottom="12dp"
                        android:text="@string/log_food_recent_history"
                        android:textColor="?colorOnSurface" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recycler_recent_logs"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                        tools:listitem="@layout/item_todays_food" />
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

    </androidx.coordinatorlayout.widget.CoordinatorLayout>
</RelativeLayout>