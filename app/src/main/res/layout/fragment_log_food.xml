<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?colorSurface"
    tools:context=".ui.log.LogFoodFragment">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout_logFood"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?colorSurface"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar_logFood"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@drawable/arrow_back"
            app:navigationIconTint="?colorOnSurface"
            app:titleTextColor="?colorOnSurface"
            tools:title="Nonushta Qo'shish" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                style="@style/Title3_17"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/upload_meal_photo"
                android:textColor="?colorPrimary" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_imagePicker_log"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_gravity="start"
                android:layout_marginTop="@dimen/dimen_8"
                android:clickable="true"
                android:focusable="true"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeColor="?colorOutlineVariant"
                app:strokeWidth="1dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <ImageView
                        android:id="@+id/imageView_selectedLogImage"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:alpha="0.5"
                        android:scaleType="centerCrop" />

                    <LinearLayout
                        android:id="@+id/layout_addImagePlaceholder_log"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="?android:attr/selectableItemBackground"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:src="@drawable/camera_ic"
                            app:tint="?colorOnSurface" />

                        <TextView
                            style="@style/Caption1_13"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="@dimen/dimen_12"
                            android:layout_marginTop="8dp"
                            android:gravity="center"
                            android:text="Rasm olish"
                            android:textColor="?colorOnSurface" />
                    </LinearLayout>
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                style="@style/Title3_17"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_24"
                android:paddingEnd="@dimen/dimen_24"
                android:text="@string/ovqat_haqida_yozing_ixtiyoriy"
                android:textColor="?colorPrimary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:visibility="gone"
                android:fontFamily="@font/roboto_regular"
                android:text="Ovqat nomi va miqdorini yozing: kosa, tarelka, bo'lak, stakan, piyola, gram"
                android:textColor="?colorOnSurfaceVariant"
                android:textSize="15sp" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/textInputLayout_foodDescription_log"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_18"
                app:helperTextEnabled="true"
                app:hintEnabled="false">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editText_foodDescription_log"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="none"
                    android:textColorHint="?colorOnSurfaceVariant"
                    android:gravity="top"
                    android:hint="@string/food_description_hint"
                    android:imeOptions="actionDone"
                    android:inputType="textMultiLine|textCapSentences"
                    android:minLines="3"
                    android:padding="@dimen/dimen_18"
                    android:background="@drawable/round_lay_stroke"
                    android:textSize="15sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/roboto_medium"
                android:padding="@dimen/dimen_12"
                android:visibility="gone"
                android:background="@drawable/round_lay"
                android:layout_marginTop="@dimen/dimen_18"
                android:backgroundTint="?colorSurfaceContainer"
                android:text="Har bir yegan ovqatingizni ilovaga kiritib boring, sizga tavsiyalar, ogohlantirishlar beramiz, bu siz uchun juda muhim!"
                android:textColor="?colorPrimary"
                android:textSize="16sp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="?colorSurface"
        android:elevation="4dp"
        android:padding="16dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_analyze_and_save"
                style="@style/Widget.Material3.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="56dp"
                android:paddingEnd="56dp"
                android:text="Tahlil qilish"
                app:icon="@drawable/search_ic"
                app:iconGravity="textStart" />

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/progress_analyze"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:indeterminate="true"
                android:visibility="gone"
                app:indicatorColor="?colorOnPrimary"
                app:trackColor="?colorSurfaceContainerLowest"
                app:indicatorSize="24dp" />
        </FrameLayout>

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>