<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?colorSurface">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBar"
        android:layout_width="match_parent"
        android:layout_height="320dp"
        android:background="?colorSurface"
        app:elevation="0dp">

        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:id="@+id/collapsingToolbar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:contentScrim="?attr/colorSurface"
            app:statusBarScrim="?attr/colorSurface"
            app:layout_scrollFlags="scroll|exitUntilCollapsed"
            app:titleEnabled="false">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/imageMenu"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                app:layout_collapseMode="parallax"
                tools:src="@drawable/placeholder_food" />

            <View
                android:id="@+id/scrimView"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:layout_gravity="bottom"
                android:background="@drawable/bottom_gradient_scrim" />

            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="@android:color/transparent"
                app:layout_collapseMode="pin"
                app:contentInsetStart="0dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:paddingHorizontal="16dp">

                    <ImageButton
                        android:id="@+id/btnBack"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_centerVertical="true"
                        android:background="@drawable/blur_background_pill"
                        android:contentDescription="Back"
                        android:padding="8dp"
                        android:src="@drawable/arrow_back"
                        app:tint="@android:color/white" />
                </RelativeLayout>
            </androidx.appcompat.widget.Toolbar>
        </com.google.android.material.appbar.CollapsingToolbarLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_bottom_sheet_top_rounded"
        android:layout_marginTop="-24dp"
        android:backgroundTint="?colorSurface"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="24dp"
            android:paddingBottom="40dp">

            <TextView
                android:id="@+id/textName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/roboto_bold"
                android:textColor="?colorOnSurface"
                android:textSize="26sp"
                tools:text="Taom nomi" />

            <!-- Metadata Badges Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- Calories -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/pill_background"
                    android:backgroundTint="?attr/colorSurfaceContainerHigh"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="6dp">
                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/fire_ic"
                        app:tint="?attr/colorPrimary" />
                    <TextView
                        android:id="@+id/textCalories"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:textSize="12sp"
                        android:fontFamily="@font/roboto_bold"
                        android:textColor="?attr/colorPrimary"
                        tools:text="450 kkal" />
                </LinearLayout>

                <View android:layout_width="8dp" android:layout_height="1dp" />

                <!-- Prep Time -->
                <LinearLayout
                    android:id="@+id/containerPrepTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/pill_background"
                    android:backgroundTint="?attr/colorSurfaceContainerHigh"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="6dp"
                    android:visibility="gone"
                    tools:visibility="visible">
                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/date_ic"
                        app:tint="?attr/colorOnSurfaceVariant" />
                    <TextView
                        android:id="@+id/textPrepTimeValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:textSize="12sp"
                        android:fontFamily="@font/roboto_bold"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        tools:text="15 daq." />
                </LinearLayout>

                <View android:layout_width="8dp" android:layout_height="1dp" />

                <!-- Difficulty -->
                <LinearLayout
                    android:id="@+id/containerDifficulty"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/pill_background"
                    android:backgroundTint="?attr/colorSurfaceContainerHigh"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="6dp"
                    android:visibility="gone"
                    tools:visibility="visible">
                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/badge_ic"
                        app:tint="?attr/colorOnSurfaceVariant" />
                    <TextView
                        android:id="@+id/textDifficultyValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:textSize="12sp"
                        android:fontFamily="@font/roboto_bold"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        tools:text="Oson" />
                </LinearLayout>
            </LinearLayout>

            <!-- Category Tags ChipGroup Scroll -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:scrollbars="none">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupCategoryTags"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:singleLine="true" />
            </HorizontalScrollView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:background="@drawable/bg_rounded_16"
                    android:backgroundTint="?colorSurfaceContainer"
                    android:paddingVertical="12dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Oqsil"
                        android:textSize="11sp"
                        android:textColor="?colorOnSurfaceVariant"
                        android:fontFamily="@font/roboto_medium" />
                    <TextView
                        android:id="@+id/textProtein"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/roboto_bold"
                        android:textColor="?colorOnSurface"
                        android:textSize="16sp"
                        tools:text="25g" />
                </LinearLayout>

                <View android:layout_width="12dp" android:layout_height="1dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:background="@drawable/bg_rounded_16"
                    android:backgroundTint="?colorSurfaceContainer"
                    android:paddingVertical="12dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Yog'"
                        android:textSize="11sp"
                        android:textColor="?colorOnSurfaceVariant"
                        android:fontFamily="@font/roboto_medium" />
                    <TextView
                        android:id="@+id/textFat"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/roboto_bold"
                        android:textColor="?colorOnSurface"
                        android:textSize="16sp"
                        tools:text="15g" />
                </LinearLayout>

                <View android:layout_width="12dp" android:layout_height="1dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:background="@drawable/bg_rounded_16"
                    android:backgroundTint="?colorSurfaceContainer"
                    android:paddingVertical="12dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Uglevod"
                        android:textSize="11sp"
                        android:textColor="?colorOnSurfaceVariant"
                        android:fontFamily="@font/roboto_medium" />
                    <TextView
                        android:id="@+id/textCarbs"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/roboto_bold"
                        android:textColor="?colorOnSurface"
                        android:textSize="16sp"
                        tools:text="40g" />
                </LinearLayout>
            </LinearLayout>

            <!-- Ingredients header + Portions selector -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/labelIngredients"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/roboto_bold"
                    android:text="Tarkibi"
                    android:textColor="?colorOnSurface"
                    android:textSize="18sp" />

                <!-- Serving Size Selector -->
                <LinearLayout
                    android:id="@+id/servingSelector"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/pill_background"
                    android:backgroundTint="?attr/colorSurfaceContainerHigh"
                    android:padding="4dp"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <TextView
                        android:id="@+id/btnSrvDec"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:gravity="center"
                        android:text="-"
                        android:textSize="18sp"
                        android:fontFamily="@font/roboto_bold"
                        android:textColor="?attr/colorPrimary"
                        android:background="@drawable/oval_back"
                        android:backgroundTint="?attr/colorSurface"
                        android:clickable="true"
                        android:focusable="true"/>

                    <TextView
                        android:id="@+id/textServingsCount"
                        android:layout_width="40dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="1"
                        android:textSize="12sp"
                        android:fontFamily="@font/roboto_medium"
                        android:textColor="?attr/colorOnSurface"/>

                    <TextView
                        android:id="@+id/btnSrvInc"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:gravity="center"
                        android:text="+"
                        android:textSize="18sp"
                        android:fontFamily="@font/roboto_bold"
                        android:textColor="?attr/colorPrimary"
                        android:background="@drawable/oval_back"
                        android:backgroundTint="?attr/colorSurface"
                        android:clickable="true"
                        android:focusable="true"/>
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/textIngredients"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/roboto_regular"
                android:lineSpacingMultiplier="1.4"
                android:textColor="?colorOnSurfaceVariant"
                android:textSize="15sp"
                tools:text="Tarkibi ko'rsatiladi..." />

            <TextView
                android:id="@+id/labelDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:fontFamily="@font/roboto_bold"
                android:text="Tayyorlash usuli"
                android:textColor="?colorOnSurface"
                android:textSize="18sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/textDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/roboto_regular"
                android:lineSpacingMultiplier="1.4"
                android:textColor="?colorOnSurfaceVariant"
                android:textSize="15sp"
                android:visibility="gone"
                tools:text="Tavsif bu yerda bo'ladi..." />

            <TextView
                android:id="@+id/labelAbout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:fontFamily="@font/roboto_bold"
                android:text="Mahsulot haqida"
                android:textColor="?colorOnSurface"
                android:textSize="18sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/textAbout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/roboto_regular"
                android:lineSpacingMultiplier="1.4"
                android:textColor="?colorOnSurfaceVariant"
                android:textSize="15sp"
                android:visibility="gone"
                tools:text="Tavsif ko'rsatiladi..." />

            <TextView
                android:id="@+id/labelRichIn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:fontFamily="@font/roboto_bold"
                android:text="Nimalarga boyligi"
                android:textColor="?colorOnSurface"
                android:textSize="18sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/textRichIn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/roboto_regular"
                android:lineSpacingMultiplier="1.4"
                android:textColor="?colorOnSurfaceVariant"
                android:textSize="15sp"
                android:visibility="gone"
                tools:text="Vitaminlar va minerallar..." />

            <TextView
                android:id="@+id/labelPreparationMethod"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:fontFamily="@font/roboto_bold"
                android:text="Tayyorlash usuli"
                android:textColor="?colorOnSurface"
                android:textSize="18sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/textPreparationMethod"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/roboto_regular"
                android:lineSpacingMultiplier="1.4"
                android:textColor="?colorOnSurfaceVariant"
                android:textSize="15sp"
                android:visibility="gone"
                tools:text="Qadamlar ro'yxati..." />

            <TextView
                android:id="@+id/labelBenefits"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:fontFamily="@font/roboto_bold"
                android:text="Foydali xususiyati"
                android:textColor="?colorOnSurface"
                android:textSize="18sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/textBenefits"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/roboto_regular"
                android:lineSpacingMultiplier="1.4"
                android:textColor="?colorOnSurfaceVariant"
                android:textSize="15sp"
                android:visibility="gone"
                tools:text="Salomatlikka foydalari..." />

            <TextView
                android:id="@+id/labelConsumptionTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:fontFamily="@font/roboto_bold"
                android:text="Iste'mol vaqti"
                android:textColor="?colorOnSurface"
                android:textSize="18sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/textConsumptionTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/roboto_regular"
                android:lineSpacingMultiplier="1.4"
                android:textColor="?colorOnSurfaceVariant"
                android:textSize="15sp"
                android:visibility="gone"
                tools:text="Masalan: Ertalab yoki tushlikda..." />

            <Button
                android:id="@+id/btnDelete"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="40dp"
                android:backgroundTint="?colorError"
                android:fontFamily="@font/roboto_bold"
                android:text="O'chirish"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="16sp"
                app:cornerRadius="16dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>

