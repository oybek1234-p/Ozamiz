<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?colorSurface">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBar"
        android:layout_width="match_parent"
        android:layout_height="320dp"
        android:background="?colorSurface"
        app:elevation="0dp">

        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:id="@+id/collapsingToolbar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:contentScrim="?attr/colorSurface"
            app:statusBarScrim="?attr/colorSurface"
            app:layout_scrollFlags="scroll|exitUntilCollapsed"
            app:titleEnabled="false">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/imageMenu"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                app:layout_collapseMode="parallax"
                tools:src="@drawable/placeholder_food" />

            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="@android:color/transparent"
                app:layout_collapseMode="pin"
                app:contentInsetStart="0dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:paddingHorizontal="16dp">

                    <ImageButton
                        android:id="@+id/btnBack"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_centerVertical="true"
                        android:layout_alignParentStart="true"
                        android:background="@drawable/blur_background_pill"
                        android:contentDescription="Back"
                        android:padding="8dp"
                        android:src="@drawable/arrow_back"
                        app:tint="@android:color/white" />

                    <ImageButton
                        android:id="@+id/btnEdit"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_centerVertical="true"
                        android:layout_alignParentEnd="true"
                        android:background="@drawable/blur_background_pill"
                        android:contentDescription="Edit"
                        android:padding="8dp"
                        android:src="@drawable/edit"
                        android:visibility="gone"
                        app:tint="@android:color/white"
                        tools:visibility="visible" />
                </RelativeLayout>
            </androidx.appcompat.widget.Toolbar>
        </com.google.android.material.appbar.CollapsingToolbarLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:backgroundTint="?colorSurface"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="32dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="top|start"
                android:baselineAligned="false">
                
                <TextView
                    android:id="@+id/textName"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    style="@style/Headline2_16"
                    android:textColor="?colorOnSurface"
                    tools:text="Overnight Raspberry &amp; Almond Oats" />
                    
                <TextView
                    android:id="@+id/textFoodCalories"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/roboto_medium"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="18sp"
                    android:visibility="gone"
                    android:background="@drawable/blur_background_pill"
                    android:backgroundTint="?attr/colorSurfaceVariant"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    tools:text="286 Kal"
                    tools:visibility="visible" />
            </LinearLayout>

            <!-- Metadata Row -->
            <LinearLayout
                android:id="@+id/metadataRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal"
                android:weightSum="3">

                <!-- Calories -->
                <LinearLayout
                    android:id="@+id/containerCaloriesPill"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/fire_ic"
                        app:tint="?attr/colorOnSurfaceVariant" />
                    <TextView
                        android:id="@+id/textCalories"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textSize="13sp"
                        android:fontFamily="@font/roboto_regular"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        tools:text="286 Cal" />
                </LinearLayout>

                <!-- Prep Time -->
                <LinearLayout
                    android:id="@+id/containerPrepTime"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/date_ic"
                        app:tint="?attr/colorOnSurfaceVariant" />
                    <TextView
                        android:id="@+id/textPrepTimeValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textSize="13sp"
                        android:fontFamily="@font/roboto_regular"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        tools:text="185 minutes" />
                </LinearLayout>

                <!-- Difficulty -->
                <LinearLayout
                    android:id="@+id/containerDifficulty"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/food_ic"
                        app:tint="?attr/colorOnSurfaceVariant" />
                    <TextView
                        android:id="@+id/textDifficultyValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textSize="13sp"
                        android:fontFamily="@font/roboto_regular"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        tools:text="Easy" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/textDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:fontFamily="@font/roboto_regular"
                android:lineSpacingMultiplier="1.2"
                android:textColor="?colorOnSurfaceVariant"
                android:textSize="16sp"
                android:visibility="gone"
                tools:text="Our overnight raspberry and almond oats..." />

            <TextView
                android:id="@+id/textAbout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/roboto_regular"
                android:lineSpacingMultiplier="1.4"
                android:textColor="?colorOnSurfaceVariant"
                android:textSize="15sp"
                android:visibility="gone"
                tools:text="Tavsif ko'rsatiladi..." />

            <TextView
                android:id="@+id/textRichIn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/roboto_regular"
                android:lineSpacingMultiplier="1.4"
                android:textColor="?colorOnSurfaceVariant"
                android:textSize="15sp"
                android:visibility="gone"
                tools:text="Vitaminlar va minerallar..." />


            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupCategoryTags"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:chipSpacingVertical="8dp"
                app:chipSpacingHorizontal="8dp" />

            <TextView
                android:id="@+id/labelIngredients"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                style="@style/Headline2_16"
                android:text="Tarkibi"
                android:textColor="?colorOnSurface" />

            <TextView
                android:id="@+id/textIngredients"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="@font/roboto_regular"
                android:lineSpacingMultiplier="1.6"
                android:textColor="?colorOnSurfaceVariant"
                android:textSize="15sp"
                tools:text="• Cinnamon\n• Raspberries (50 g)" />

            <!-- Instructions -->
            <View
                android:id="@+id/divider1"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="?colorSurfaceContainerHighest"
                android:layout_marginTop="24dp" />

            <TextView
                android:id="@+id/labelPreparationMethod"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                style="@style/Headline2_16"
                android:text="Tayyorlash usuli"
                android:textColor="?colorOnSurface" />

            <LinearLayout
                android:id="@+id/containerSteps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical" />

            <!-- Nutrition Facts List -->
            <View
                android:id="@+id/divider2"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="?colorSurfaceContainerHighest"
                android:layout_marginTop="24dp" />


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="12dp"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="Kaloriya"
                        style="@style/Headline2_16"
                        android:textColor="?colorOnSurface"
                        />
                    <TextView
                        android:id="@+id/textFactCalories"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/roboto_bold"
                        android:textColor="?colorOnSurface"
                        android:textSize="16sp"
                        tools:text="286 Kal"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="12dp"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="Oqsil"
                        android:fontFamily="@font/roboto_bold"
                        android:textColor="?colorOnSurfaceVariant"
                        android:textSize="16sp"/>
                    <TextView
                        android:id="@+id/textProtein"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/roboto_bold"
                        android:textColor="?colorOnSurfaceVariant"
                        android:textSize="16sp"
                        tools:text="46.1 g"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="12dp"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="Uglevod"
                        android:fontFamily="@font/roboto_bold"
                        android:textColor="?colorOnSurfaceVariant"
                        android:textSize="16sp"/>
                    <TextView
                        android:id="@+id/textCarbs"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/roboto_bold"
                        android:textColor="?colorOnSurfaceVariant"
                        android:textSize="16sp"
                        tools:text="7.5 g"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="12dp"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="Kletchatka"
                        android:fontFamily="@font/roboto_bold"
                        android:textColor="?colorOnSurfaceVariant"
                        android:textSize="16sp"/>
                    <TextView
                        android:id="@+id/textFactFiber"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/roboto_bold"
                        android:textColor="?colorOnSurfaceVariant"
                        android:textSize="16sp"
                        tools:text="2.3 g"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="12dp"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="Qand miqdori"
                        android:fontFamily="@font/roboto_bold"
                        android:textColor="?colorOnSurfaceVariant"
                        android:textSize="16sp"/>
                    <TextView
                        android:id="@+id/textFactSugar"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/roboto_bold"
                        android:textColor="?colorOnSurfaceVariant"
                        android:textSize="16sp"
                        tools:text="7.3 g"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="12dp"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="Yog'"
                        android:fontFamily="@font/roboto_bold"
                        android:textColor="?colorOnSurfaceVariant"
                        android:textSize="16sp"/>
                    <TextView
                        android:id="@+id/textFat"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/roboto_bold"
                        android:textColor="?colorOnSurfaceVariant"
                        android:textSize="16sp"
                        tools:text="36.4 g"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="12dp"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="Tuz"
                        android:fontFamily="@font/roboto_bold"
                        android:textColor="?colorOnSurfaceVariant"
                        android:textSize="16sp"/>
                    <TextView
                        android:id="@+id/textFactSalt"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/roboto_bold"
                        android:textColor="?colorOnSurfaceVariant"
                        android:textSize="16sp"
                        tools:text="2.6 g"/>
                </LinearLayout>

            </LinearLayout>



            <Button
                android:id="@+id/btnDelete"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="24dp"
                android:backgroundTint="?colorError"
                android:fontFamily="@font/roboto_bold"
                android:text="O'chirish"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="16sp"
                app:cornerRadius="16dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
