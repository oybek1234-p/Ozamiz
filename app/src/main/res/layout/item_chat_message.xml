<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/messageContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingVertical="4dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/aiMessageLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:id="@+id/aiMessageText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_chat_ai"
            android:backgroundTint="?attr/colorSurfaceContainerLowest"
            android:lineSpacingExtra="5sp"
            android:lineSpacingMultiplier="1.2"
            android:paddingHorizontal="16dp"
            android:paddingVertical="14dp"
            android:textColor="?attr/colorOnSurface"
            android:textSize="16sp"
            android:fontFamily="@font/roboto_regular"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Salom! Men sizning AI diyetologingizman." />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveMenu"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="8dp"
            android:fontFamily="@font/roboto_medium"
            android:text="Saqlash"
            android:visibility="gone"
            app:icon="@drawable/check_circle_ic"
            app:layout_constraintEnd_toStartOf="@id/btnRecreate"
            app:layout_constraintTop_toBottomOf="@id/aiMessageText"
            tools:visibility="visible" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRecreate"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="8dp"
            android:fontFamily="@font/roboto_medium"
            android:text="Qayta tuzish"
            android:visibility="gone"
            app:icon="@drawable/info_ic"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/aiMessageText"
            tools:visibility="visible" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/userMessageLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:id="@+id/userMessageText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="64dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_chat_user"
            android:backgroundTint="?attr/colorPrimary"
            android:lineSpacingExtra="3sp"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp"
            android:textColor="?attr/colorOnPrimary"
            style="@style/TextAppearance.Material3.BodyLarge"
            android:fontFamily="@font/roboto_regular"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Bugun nima yeyman?" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</LinearLayout>
