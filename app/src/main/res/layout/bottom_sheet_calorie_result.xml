<!-- ✅ YAKUNIY, YAXSHILANGAN VERSIYA -->
<!-- C:...\res\layout\bottom_sheet_calorie_result.xml -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?colorSurfaceContainer"
    app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">

    <!-- Orqaga qaytish tugmasi -->
    <ImageView
        android:id="@+id/back_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        android:background="?selectableItemBackgroundBorderless"
        android:elevation="2dp"
        android:padding="12dp"
        android:src="@drawable/arrow_back"
        app:tint="?colorOnSurface" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="100dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:layout_gravity="center_vertical"
            android:paddingStart="24dp"
            android:paddingTop="64dp"
            android:paddingEnd="24dp">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/imageView_illustration"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_gravity="center"
                android:scaleType="centerCrop"
                android:visibility="gone"
                app:shapeAppearanceOverlay="@style/RadiusImageView12"
                tools:src="@drawable/placeholder_food" />

            <TextView
                android:id="@+id/textView_estimatedCalories"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp"
                android:drawablePadding="4dp"
                android:fontFamily="@font/roboto_bold"
                android:textColor="?colorPrimary"
                android:textSize="45sp"
                app:drawableTint="?colorPrimary"
                tools:text="480" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:fontFamily="@font/roboto_regular"

                android:text="kaloriya (Energiya)"
                android:textColor="?colorPrimary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/food_name"
                style="@style/Text2_15"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/round_lay"
                android:backgroundTint="?colorSurfaceContainerLowest"
                android:ellipsize="end"
                android:fontFamily="@font/roboto_regular"
                android:gravity="center"
                android:maxLines="2"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp"
                android:textColor="?colorOnSurfaceVariant"
                app:drawableTint="#939393"
                tools:text="2 sih shashlik va oq non" />


            <!-- Sog'lomlik Darajasi Bloki -->
            <LinearLayout
                android:id="@+id/layout_health_feedback"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/round_lay"
                android:backgroundTint="@color/white"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/icon_health_feedback"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_marginEnd="12dp"
                        tools:src="@drawable/check_ic"
                        tools:tint="@color/green" />

                    <TextView
                        android:id="@+id/level_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:fontFamily="@font/roboto_medium"
                        android:textSize="15sp"
                        tools:text="Yaxshi tanlov"
                        tools:textColor="@color/green" />

                </LinearLayout>

                <TextView
                    android:id="@+id/textView_health_feedback"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:fontFamily="@font/roboto_regular"
                    android:lineSpacingMultiplier="1.2"
                    android:textColor="?colorOnSurface"
                    android:textSize="16sp"
                    tools:text="Haftasiga 1 martadan oshirmang, yoki 'Cola Zero' iching." />
            </LinearLayout>

            <!-- Makronutrientlar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:baselineAligned="false"
                android:clipToPadding="false"
                android:orientation="horizontal"
                android:padding="2dp">

                <!-- Protein -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    app:cardBackgroundColor="?colorSurfaceContainerLowest"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <ImageView
                                android:layout_width="30dp"
                                android:layout_height="30dp"
                                android:src="@drawable/protein_ic"
                                android:layout_gravity="center" />
                            <ImageView
                                android:id="@+id/info_protein"
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:background="?selectableItemBackgroundBorderless"
                                android:src="@drawable/info_ic"
                                android:layout_gravity="top|end"
                                app:tint="@color/grey" />
                        </FrameLayout>

                        <TextView
                            style="@style/MacroItemLabel"
                            android:layout_marginTop="8dp"
                            android:text="@string/protein_short" />
                        <TextView
                            android:id="@+id/textView_estimatedProtein"
                            style="@style/MacroItemValue"
                            tools:text="25.5 g" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Carbs -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    app:cardBackgroundColor="?colorSurfaceContainerLowest"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="16dp">
                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <ImageView
                                android:layout_width="30dp"
                                android:layout_height="30dp"
                                style="@style/MacroItemIcon"
                                android:layout_gravity="center"
                                android:src="@drawable/carbs_ic"
                               />
                            <ImageView
                                android:id="@+id/info_carbs"
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:background="?selectableItemBackgroundBorderless"
                                android:src="@drawable/info_ic"
                                android:layout_gravity="top|end"
                                app:tint="@color/grey" />
                        </FrameLayout>
                        <TextView
                            style="@style/MacroItemLabel"
                            android:layout_marginTop="8dp"
                            android:text="@string/carbs_short" />
                        <TextView
                            android:id="@+id/textView_estimatedCarbs"
                            style="@style/MacroItemValue"
                            tools:text="55.0 g" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Fat -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    app:cardBackgroundColor="?colorSurfaceContainerLowest"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="16dp">
                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <ImageView
                                style="@style/MacroItemIcon"
                                android:layout_width="30dp"
                                android:layout_height="30dp"
                                android:layout_gravity="center"
                                android:src="@drawable/fat_ic"
                               />
                            <ImageView
                                android:id="@+id/info_fat"
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:background="?selectableItemBackgroundBorderless"
                                android:src="@drawable/info_ic"
                                android:layout_gravity="top|end"
                                app:tint="@color/grey" />
                        </FrameLayout>
                        <TextView
                            style="@style/MacroItemLabel"
                            android:layout_marginTop="8dp"
                            android:text="@string/fat_short" />
                        <TextView
                            android:id="@+id/textView_estimatedFat"
                            style="@style/MacroItemValue"
                            tools:text="15.2 g" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Harakat tugmalari -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="?colorSurfaceContainerLowest"
        android:elevation="4dp"
        android:padding="16dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_retry_analysis"
                style="@style/Widget.Material3.Button.ElevatedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:text="@string/retry_or_cancel" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_save_to_log"
                style="@style/Widget.Material3.Button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/save_to_log"
                app:icon="@drawable/check_ic"
                app:iconGravity="textStart" />
        </LinearLayout>
        <ProgressBar
            android:id="@+id/progressBar_save"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_gravity="center"
            android:indeterminateTint="?colorPrimary"
            android:visibility="gone"
            tools:visibility="visible" />
    </FrameLayout>
</FrameLayout>