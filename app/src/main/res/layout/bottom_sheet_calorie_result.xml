<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?colorSurfaceContainerLowest"
    app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">

    <ImageView
        android:id="@+id/back_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        android:background="?selectableItemBackgroundBorderless"
        android:elevation="@dimen/dimen_2"
        android:padding="@dimen/dimen_12"
        android:src="@drawable/arrow_back"
        app:tint="?colorOnSurface" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="100dp">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            >

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="56dp"
                >

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/imageView_illustration"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:visibility="gone"
                    android:layout_gravity="center_horizontal"
                    android:scaleType="centerCrop"
                    android:src="@drawable/food_icon"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:shapeAppearanceOverlay="@style/RadiusImageView12" />

                <TextView
                    android:id="@+id/food_name"
                    style="@style/Text1_16"
                    android:textSize="17sp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginStart="@dimen/dimen_12"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:text="2 sih shashlik va oq non"
                    android:textColor="?colorOnSurface"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/imageView_illustration"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/textView_estimatedCalories"
                    style="@style/Title2_20"
                    android:fontFamily="@font/roboto_bold"
                    android:layout_width="wrap_content"
                    android:paddingVertical="@dimen/dimen_4"
                    android:layout_height="wrap_content"
                    android:drawableTint="#FF9800"
                    android:drawablePadding="@dimen/dimen_8"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginStart="@dimen/dimen_12"
                    android:textColor="#FF9800"
                    app:drawableStartCompat="@drawable/fire_ic"
                    app:layout_constraintStart_toEndOf="@+id/imageView_illustration"
                    app:layout_constraintTop_toBottomOf="@+id/food_name"
                    tools:text="480 kkal" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <LinearLayout
                android:id="@+id/layout_health_feedback"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"

                android:layout_marginTop="16dp"
                android:padding="12dp"
                android:background="@drawable/round_lay"
                android:backgroundTint="@color/green"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/icon_health_feedback"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginEnd="12dp"
                    app:tint="@color/white"
                    tools:src="@drawable/check_circle_ic"
                    tools:tint="@color/white"/>

                <TextView
                    android:id="@+id/textView_health_feedback"
                    style="@style/Headline3_15"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/white"
                    tools:text="Ajoyib! Bu ozish uchun foydali."/>
            </LinearLayout>


            <TextView
                android:id="@+id/textView_calorieInsights"
                style="@style/Text1_16"
                android:lineSpacingExtra="1.4dp"
                android:padding="@dimen/dimen_18"
                android:backgroundTint="?colorSurfaceContainer"
                android:background="@drawable/round_lay"
                android:elevation="@dimen/dimen_4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_24"
                android:lineSpacingMultiplier="1.2"
                android:textColor="?colorOnSurface"
                tools:text="✅ Bu ovqat oqsilga boy, uzoq vaqt to'q tutadi.\n⚠️ Non miqdorini kamaytiring, ayniqsa kechki payt.\n💡 Non o'rniga ko'proq sabzavot qo'shing." />

            <LinearLayout
                android:id="@+id/layout_warnings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_24"
                android:elevation="2dp"
                android:background="@drawable/warning_background"
                android:orientation="vertical"
                android:padding="12dp"
                android:backgroundTint="#FFFCE9"
                android:visibility="gone"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    >
                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/warning_24px"
                        app:tint="@color/yellow"
                        />
                    <TextView
                        style="@style/Subtitle2_14"
                        android:textColor="@color/yellow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="Diqqat"
                        />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/layout_warnings_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dimen_12"
                    android:orientation="vertical" />
            </LinearLayout>

            <TextView
                android:id="@+id/label_recognized_ingredients"
                style="@style/Subtitle2_14"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_24"
                android:text="@string/recognized_ingredients"
                android:textColor="?colorOnSurface" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroup_ingredients"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:chipSpacingHorizontal="6dp"
                app:chipSpacingVertical="4dp"
                tools:visibility="visible"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_24"
                android:clipToPadding="false"
                android:paddingVertical="@dimen/dimen_8"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout style="@style/MacroItemLayout">
                    <TextView
                        style="@style/MacroItemLabel"
                        android:text="@string/protein_short" />
                    <TextView
                        android:id="@+id/textView_estimatedProtein"
                        style="@style/MacroItemValue"
                        tools:text="~ 25.5 g" />
                </LinearLayout>
                <LinearLayout style="@style/MacroItemLayout">
                    <TextView
                        style="@style/MacroItemLabel"
                        android:text="@string/fat_short" />
                    <TextView
                        android:id="@+id/textView_estimatedFat"
                        style="@style/MacroItemValue"
                        tools:text="~ 15.2 g" />
                </LinearLayout>
                <LinearLayout style="@style/MacroItemLayout">
                    <TextView
                        style="@style/MacroItemLabel"
                        android:text="@string/carbs_short" />
                    <TextView
                        android:id="@+id/textView_estimatedCarbs"
                        style="@style/MacroItemValue"
                        tools:text="~ 55.0 g" />
                </LinearLayout>
            </LinearLayout>
            <TextView
                android:id="@+id/textView_calorieDisclaimer"
                style="@style/Caption2_12"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:layout_marginTop="16dp"
                android:gravity="center_horizontal"
                android:text="@string/pfc_estimation_disclaimer"
                android:textColor="#979797" />

        </LinearLayout>
    </ScrollView>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="?colorSurfaceContainerLowest"
        android:elevation="4dp"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_retry_analysis"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:visibility="gone"
                android:text="@string/retry_or_cancel" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_save_to_log"
                style="@style/Widget.Material3.Button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                app:icon="@drawable/check_ic"
                app:iconGravity="textStart"
                android:text="@string/save_to_log" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progressBar_save"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_gravity="center"
            android:progressTint="?colorPrimary"
            android:visibility="gone"
            tools:visibility="visible"
            android:indeterminateTint="?colorPrimary"
            app:indicatorColor="?colorPrimary"
            app:indicatorSize="24dp" />
    </FrameLayout>
</FrameLayout>