<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?colorSurfaceContainer">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        app:elevation="0dp">

        <uz.oybek.ozamiz.ui.base.MyToolBar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@drawable/arrow_back"
            app:titleCentered="true"
            app:titleTextAppearance="@style/Title3_17" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/nestedScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="100dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="16dp">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/imageView_food_photo"
                android:layout_width="200dp"
                android:layout_height="200dp"
                android:layout_gravity="center_horizontal"
                android:scaleType="centerCrop"
                app:shapeAppearance="@style/RadiusImageView12"
                tools:src="@drawable/placeholder_food" />

            <TextView
                android:id="@+id/textView_timestamp"
                style="@style/Caption2_12"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:drawablePadding="6dp"
                android:gravity="center"
                android:text="6:21 PM"
                android:textColor="?colorOnSurfaceVariant"
                android:visibility="gone"
                app:drawableStartCompat="@drawable/date_ic"
                app:drawableTint="?colorOnSurfaceVariant" />

            <LinearLayout
                android:id="@+id/layout_food_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="?selectableItemBackground"
                android:gravity="center"
                android:orientation="horizontal"
                android:padding="4dp">

                <TextView
                    android:id="@+id/textView_food_name"
                    style="@style/Title4_24"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/roboto_bold"
                    android:gravity="center"
                    android:maxLines="2"
                    android:textColor="?colorOnSurface"
                    tools:text="Caesar Salad" />

            </LinearLayout>


            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_calorie_banner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?selectableItemBackground"
                app:cardBackgroundColor="?attr/colorSurfaceContainerLowest"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="?colorOutlineVariant"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:id="@+id/loading_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <com.airbnb.lottie.LottieAnimationView
                        android:id="@+id/animation"
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        app:lottie_autoPlay="true"
                        app:lottie_rawRes="@raw/bouncing_fruits"
                        app:lottie_repeatCount="100"
                        app:lottie_repeatMode="restart" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/loading_text"
                            style="@style/Title3_17"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/analyzing"
                            android:textColor="?colorOnSurface" />

                        <TextView
                            style="@style/Text2_15"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/learning_benefits_calories"
                            android:textColor="?colorOnSurface" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/calorie_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/dimen_18"
                    android:paddingVertical="@dimen/dimen_12"
                    android:visibility="invisible">

                    <FrameLayout
                        android:layout_width="28dp"
                        android:layout_height="28dp">

                        <ImageView
                            android:id="@+id/imageView_fire"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@drawable/fire_ic"
                            app:tint="?colorOnSurface" />

                        <com.airbnb.lottie.LottieAnimationView
                            android:id="@+id/lottie_loading_calories"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:visibility="gone"
                            app:lottie_autoPlay="true"
                            app:lottie_loop="true"
                            app:lottie_rawRes="@raw/food_anim" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/textView_calories_label"
                            style="@style/Caption2_12"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/kaloriya"
                            android:textColor="?colorOnSurfaceVariant" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/textView_calories"
                                style="@style/Title4_28"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/roboto_bold"
                                android:textColor="?colorOnSurface"
                                tools:text="330" />

                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:id="@+id/layout_macros"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_12"
                android:baselineAligned="false"
                android:clipToPadding="false"
                android:orientation="horizontal"
                android:padding="1dp">

                <include
                    android:id="@+id/layout_protein"
                    layout="@layout/item_macro_display"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1" />

                <include
                    android:id="@+id/layout_carbs"
                    layout="@layout/item_macro_display"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1" />

                <include
                    android:id="@+id/layout_fats"
                    layout="@layout/item_macro_display"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_ai_health"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/round_lay"
                android:backgroundTint="?colorSurfaceContainerLowest"
                app:cardBackgroundColor="?attr/colorSurfaceContainerLowest"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:id="@+id/layout_advice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/dimen_18"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <TextView
                        style="@style/Text2_15"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ai_dietolog"
                        android:textColor="?colorOnSurfaceVariant" />

                    <TextView
                        android:id="@+id/textView_advice"
                        style="@style/Headline2_16"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dimen_8"
                        android:textColor="?colorOnSurface"
                        tools:text="Bu ovqatni kamroq miqdorda va kechqurun yemaslik maslahat beriladi." />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:id="@+id/health_ball"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/round_lay"
                android:layout_marginTop="@dimen/dimen_12"
                android:backgroundTint="?colorSurfaceContainerLowest"
                android:gravity="center"
                android:paddingVertical="@dimen/dimen_12"
                android:paddingHorizontal="@dimen/dimen_8"
                android:orientation="horizontal">

                <com.airbnb.lottie.LottieAnimationView
                    android:id="@+id/ballanimation"
                    android:layout_width="40dp"
                    android:visibility="gone"
                    android:layout_height="40dp"
                    app:lottie_autoPlay="true"
                    app:lottie_rawRes="@raw/bouncing_fruits"
                    app:lottie_repeatCount="100"
                    app:lottie_repeatMode="restart" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="20dp"
                    android:paddingEnd="@dimen/dimen_18"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/Headline3_15"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/dimen_12"
                        android:layout_height="wrap_content"
                        android:text="@string/sog_liq_bahosi"
                        android:textColor="?colorOnSurface" />


                    <TextView
                        android:id="@+id/ball_count"
                        style="@style/Headline3_15"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="5 ball"
                        android:fontFamily="@font/roboto_bold"
                        android:textColor="?colorOnSurface" />


                </LinearLayout>
            </LinearLayout>

            <FrameLayout
                android:id="@+id/banner_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:minHeight="50dp" />


        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/layout_bottom_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="?colorSurfaceContainer"
        android:elevation="16dp"
        android:orientation="vertical"
        android:padding="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_delete"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="12dp"
            android:fontFamily="@font/roboto_medium"
            android:text="@string/delete"
            android:textColor="?colorError"
            android:visibility="gone"
            app:icon="@drawable/delete_ic"
            app:iconGravity="textStart"
            app:iconTint="?colorError"
            app:strokeColor="?colorError"
            tools:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_re_log_full"
            style="@style/Widget.Material3.Button"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="12dp"
            android:backgroundTint="?colorPrimary"
            android:fontFamily="@font/roboto_medium"
            android:text="@string/retry_or_cancel"
            android:textColor="?colorSurface"
            android:visibility="gone"
            app:icon="@drawable/add_ic"
            app:iconGravity="textStart"
            tools:visibility="visible" />

        <LinearLayout
            android:id="@+id/layout_horizontal_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_re_log"
                style="@style/Widget.Material3.Button.ElevatedButton"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:fontFamily="@font/roboto_medium"
                android:text="@string/cancel"
                android:visibility="gone"
                app:icon="@drawable/arrow_back"
                app:iconGravity="textStart"
                tools:visibility="visible" />

            <FrameLayout
                android:id="@+id/layout_save_container"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_save_to_log"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:backgroundTint="?colorPrimary"
                    android:fontFamily="@font/roboto_medium"
                    android:text="@string/save"
                    android:textColor="?colorSurface"
                    app:icon="@drawable/check_ic"
                    app:iconGravity="textStart" />

                <ProgressBar
                    android:id="@+id/progress_bar_button"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:elevation="4dp"
                    android:indeterminateTint="?colorSurface"
                    android:visibility="gone" />

            </FrameLayout>
        </LinearLayout>
    </LinearLayout>

    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/confetti_animation"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        app:lottie_autoPlay="false"
        app:lottie_loop="false"
        app:lottie_rawRes="@raw/confeti_effect" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>