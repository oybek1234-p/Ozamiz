<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">

    <ImageView
        android:id="@+id/back_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        android:background="?selectableItemBackgroundBorderless"
        android:elevation="@dimen/dimen_2"
        android:padding="@dimen/dimen_12"
        android:src="@drawable/arrow_back"
        app:tint="?colorOnSurface" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingBottom="100dp">


            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="64dp"
                >

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/imageView_illustration"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:layout_gravity="center_horizontal"
                    android:scaleType="centerCrop"
                    android:src="@drawable/breakfast_ic"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:shapeAppearanceOverlay="@style/RadiusImageView12" />

                <TextView
                    android:id="@+id/food_name"
                    style="@style/Title3_17"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginStart="@dimen/dimen_12"
                    android:ellipsize="end"
                    android:lines="2"
                    android:maxLines="2"
                    android:text="2 sih shashlik va oq non"
                    android:textColor="?colorOnSurfaceVariant"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/imageView_illustration"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/textView_estimatedCalories"
                    style="@style/TextAppearance.Material3.TitleLarge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:textColor="?colorPrimary"
                    android:layout_marginStart="@dimen/dimen_12"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/imageView_illustration"
                    tools:text="~ 480 kkal" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <TextView
                android:id="@+id/textView_calorieInsights"
                style="@style/Text1_16"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_24"
                android:lineSpacingMultiplier="1.2"
                android:textColor="?colorOnSurface"
                tools:text="Yog'li bo'lishi mumkin.\nSabzavotlar foydali." />

            <LinearLayout
                android:id="@+id/layout_warnings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/warning_background"
                android:orientation="vertical"
                android:padding="12dp"
                android:visibility="gone"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/warning_24px"
                        app:tint="?colorError" />

                    <TextView
                        style="@style/Headline3_15"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="@string/recommendations_warnings"
                        android:textColor="?colorError" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layout_warnings_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical" />
            </LinearLayout>

            <LinearLayout
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_24"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout style="@style/MacroItemLayout">

                    <TextView
                        style="@style/MacroItemLabel"
                        android:text="@string/protein_short" />

                    <TextView
                        android:id="@+id/textView_estimatedProtein"
                        style="@style/MacroItemValue"
                        tools:text="~ 25.5 g" />
                </LinearLayout>

                <LinearLayout style="@style/MacroItemLayout">

                    <TextView
                        style="@style/MacroItemLabel"
                        android:text="@string/fat_short" />

                    <TextView
                        android:id="@+id/textView_estimatedFat"
                        style="@style/MacroItemValue"
                        tools:text="~ 15.2 g" />
                </LinearLayout>

                <LinearLayout style="@style/MacroItemLayout">


                    <TextView
                        style="@style/MacroItemLabel"
                        android:text="@string/carbs_short" />

                    <TextView
                        android:id="@+id/textView_estimatedCarbs"
                        style="@style/MacroItemValue"
                        tools:text="~ 55.0 g" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                style="@style/Text1_14"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/recognized_ingredients"
                android:textColor="?colorOnSurfaceVariant" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroup_ingredients"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:visibility="gone"
                app:chipSpacingHorizontal="6dp"
                app:chipSpacingVertical="4dp" />

            <TextView
                android:id="@+id/textView_calorieDisclaimer"
                style="@style/Caption2_12"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:visibility="gone"
                android:gravity="center_horizontal"
                android:text="@string/pfc_estimation_disclaimer"
                android:textColor="#979797" />

        </LinearLayout>
    </ScrollView>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="?colorSurfaceContainerLowest"
        android:elevation="4dp"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_retry_analysis"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:visibility="gone"
                android:text="@string/retry_or_cancel" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_save_to_log"
                style="@style/Widget.Material3.Button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                app:icon="@drawable/check_ic"
                app:iconGravity="textStart"
                android:text="@string/save_to_log" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progressBar_save"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_gravity="center"
            android:progressTint="?colorPrimary"
            android:indeterminateTint="?colorPrimary"
            app:indicatorColor="?colorPrimary"
            app:indicatorSize="24dp" />

    </FrameLayout>

</FrameLayout>