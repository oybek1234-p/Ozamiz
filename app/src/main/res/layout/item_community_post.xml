<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginTop="8dp"
    android:layout_marginBottom="6dp"
    app:cardBackgroundColor="?attr/colorSurfaceContainer"
    app:cardCornerRadius="20dp"
    app:cardElevation="0dp"
    app:strokeColor="?attr/colorSurfaceContainerHigh"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- User Header Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingTop="10dp"
            android:paddingBottom="6dp">

            <!-- User Info Clickable Area (Container with ripple) -->
            <LinearLayout
                android:id="@+id/layoutUserInfo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_rounded_soft"
                android:backgroundTint="@android:color/transparent"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="6dp">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/imgUserAvatar"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:scaleType="centerCrop"
                    app:shapeAppearance="@style/CircleImageView"
                    app:srcCompat="@drawable/user_photo_placeholder" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvUserName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/roboto_bold"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="15sp"
                            tools:text="Oybek" />

                        <ImageView
                            android:id="@+id/imgPremium"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_marginStart="4dp"
                            android:visibility="gone"
                            app:srcCompat="@drawable/star_ic"
                            app:tint="?attr/colorStreakActive"
                            tools:visibility="visible" />

                        <TextView
                            android:id="@+id/tvPendingBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_rounded_soft"
                            android:backgroundTint="?attr/colorSurfaceContainerHigh"
                            android:fontFamily="@font/roboto_medium"
                            android:paddingHorizontal="6dp"
                            android:paddingVertical="1dp"
                            android:text="@string/community_post_pending_badge"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textSize="10sp"
                            android:visibility="gone"
                            tools:visibility="visible" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvPostTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="?attr/colorOutline"
                        android:textSize="12sp"
                        tools:text="2 soat oldin" />
                </LinearLayout>
            </LinearLayout>

            <ImageView
                android:id="@+id/btnPostMore"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="More options"
                android:padding="6dp"
                android:visibility="gone"
                app:srcCompat="@drawable/more_vert"
                app:tint="?attr/colorOnSurfaceVariant"
                tools:visibility="visible" />
        </LinearLayout>

        <!-- Post Title (Optional) -->
        <TextView
            android:id="@+id/tvPostTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="4dp"
            android:fontFamily="@font/roboto_bold"
            android:textColor="?attr/colorOnSurface"
            android:textSize="15sp"
            android:visibility="gone"
            tools:text="Ertalabki nonushta rejasi"
            tools:visibility="visible" />

        <!-- Post Description -->
        <TextView
            android:id="@+id/tvPostDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="12dp"
            android:lineSpacingMultiplier="1.25"
            android:textColor="?attr/colorOnSurface"
            android:textSize="14sp"
            tools:text="Bugun ertalab tuxum, bodring va tvorog yedim. Kunni ajoyib boshladim!" />

        <!-- Media Container -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/layoutMediaContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="14dp"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="?attr/colorSurfaceContainerHigh"
            app:strokeWidth="1dp"
            android:visibility="gone"
            tools:visibility="visible">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <!-- Single Photo (Food / General) -->
                <ImageView
                    android:id="@+id/imgSinglePhoto"
                    android:layout_width="match_parent"
                    android:layout_height="300dp"
                    android:scaleType="centerCrop"
                    android:visibility="gone"
                    tools:src="@drawable/placeholder_food"
                    tools:visibility="visible" />

                <!-- Photo Comparison (Weight Loss: Before & After) -->
                <LinearLayout
                    android:id="@+id/layoutPhotoComparison"
                    android:layout_width="match_parent"
                    android:layout_height="260dp"
                    android:orientation="horizontal"
                    android:visibility="gone"
                    tools:visibility="gone">

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1">

                        <ImageView
                            android:id="@+id/imgBefore"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            tools:src="@drawable/user_photo_placeholder" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="bottom|start"
                            android:layout_margin="8dp"
                            android:background="@drawable/bg_rounded_soft"
                            android:backgroundTint="#99000000"
                            android:fontFamily="@font/roboto_bold"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="3dp"
                            android:text="@string/community_photo_oldin"
                            android:textColor="@android:color/white"
                            android:textSize="11sp" />
                    </FrameLayout>

                    <View
                        android:layout_width="2dp"
                        android:layout_height="match_parent"
                        android:background="?attr/colorSurfaceContainerLowest" />

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1">

                        <ImageView
                            android:id="@+id/imgAfter"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            tools:src="@drawable/user_photo_placeholder" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="bottom|end"
                            android:layout_margin="8dp"
                            android:background="@drawable/bg_rounded_soft"
                            android:backgroundTint="?attr/colorPrimary"
                            android:fontFamily="@font/roboto_bold"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="3dp"
                            android:text="@string/community_photo_hozir"
                            android:textColor="@android:color/white"
                            android:textSize="11sp" />
                    </FrameLayout>
                </LinearLayout>
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.divider.MaterialDivider
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginHorizontal="16dp"
            app:dividerColor="?attr/colorSurfaceContainerHigh" />

        <!-- Post Actions Area (Likes & Comments) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp"
            android:paddingVertical="8dp">

            <!-- Like Button -->
            <LinearLayout
                android:id="@+id/btnLike"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/bg_rounded_soft"
                android:backgroundTint="?attr/colorSurfaceContainerLow"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp">

                <ImageView
                    android:id="@+id/imgLike"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    app:srcCompat="@drawable/like_ic"
                    app:tint="?attr/colorOnSurface" />

                <TextView
                    android:id="@+id/tvLikesCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:fontFamily="@font/roboto_bold"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="13sp"
                    tools:text="14" />
            </LinearLayout>

            <!-- Comments Button -->
            <LinearLayout
                android:id="@+id/btnComments"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_rounded_soft"
                android:backgroundTint="?attr/colorSurfaceContainerLow"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp">

                <ImageView
                    android:id="@+id/imgComment"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    app:srcCompat="@drawable/comment_ic"
                    app:tint="?attr/colorOnSurface" />

                <TextView
                    android:id="@+id/tvCommentsCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:fontFamily="@font/roboto_bold"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="13sp"
                    tools:text="8" />
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
