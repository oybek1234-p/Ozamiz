<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginTop="8dp"
    android:layout_marginBottom="6dp"
    app:cardBackgroundColor="?attr/colorSurfaceContainerLowest"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeColor="?attr/colorSurfaceContainerHigh"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- User Header Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingTop="10dp"
            android:paddingBottom="6dp">

            <!-- User Info Clickable Area -->
            <LinearLayout
                android:id="@+id/layoutUserInfo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="6dp">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/imgUserAvatar"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:scaleType="centerCrop"
                    app:shapeAppearance="@style/CircleImageView"
                    app:srcCompat="@drawable/user_photo_placeholder" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvUserName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/roboto_bold"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="15sp"
                            tools:text="Oybek" />

                        <LinearLayout
                            android:id="@+id/layoutPremiumBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:visibility="gone"
                            tools:visibility="visible">

                            <ImageView
                                android:layout_width="12dp"
                                android:layout_height="12dp"
                                app:srcCompat="@drawable/star_ic"
                                app:tint="@color/yellow" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="3dp"
                                android:fontFamily="@font/roboto_bold"
                                android:text="@string/premium_badge"
                                android:textColor="@color/yellow"
                                android:textSize="10sp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvNewBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:background="@drawable/bg_rounded_soft"
                            android:backgroundTint="#4CAF50"
                            android:fontFamily="@font/roboto_bold"
                            android:paddingHorizontal="7dp"
                            android:paddingVertical="2dp"
                            android:text="Yangi"
                            android:textColor="@android:color/white"
                            android:textSize="10sp"
                            android:visibility="gone"
                            tools:visibility="visible" />

                        <TextView
                            android:id="@+id/tvPendingBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_rounded_soft"
                            android:backgroundTint="?attr/colorSurfaceContainerHigh"
                            android:fontFamily="@font/roboto_medium"
                            android:paddingHorizontal="6dp"
                            android:paddingVertical="1dp"
                            android:text="@string/community_post_pending_badge"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textSize="10sp"
                            android:visibility="gone"
                            tools:visibility="visible" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvPostTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="?attr/colorOutline"
                        android:textSize="12sp"
                        tools:text="2 soat oldin" />

                    <TextView
                        android:id="@+id/tvAuthorStats"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/roboto_medium"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="11sp"
                        android:visibility="gone"
                        tools:text="🔥 4.5 kg ozgan • ⚡ 18 kundan beri shug'ullanmoqda"
                        tools:visibility="visible" />
                </LinearLayout>
            </LinearLayout>

            <ImageView
                android:id="@+id/btnPostMore"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="More options"
                android:padding="6dp"
                android:visibility="gone"
                app:srcCompat="@drawable/more_vert"
                app:tint="?attr/colorOnSurfaceVariant"
                tools:visibility="visible" />
        </LinearLayout>

        <!-- Post Title (Optional) -->
        <TextView
            android:id="@+id/tvPostTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="4dp"
            android:fontFamily="@font/roboto_bold"
            android:textColor="?attr/colorOnSurface"
            android:textSize="15sp"
            android:visibility="gone"
            tools:text="Ertalabki nonushta rejasi"
            tools:visibility="visible" />

        <!-- Post Description Container -->
        <LinearLayout
            android:id="@+id/layoutPostDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="10dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvPostDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:lineSpacingMultiplier="1.25"
                android:textColor="?attr/colorOnSurface"
                android:textSize="14sp"
                tools:text="Bugun ertalab tuxum, bodring va tvorog yedim. Kunni ajoyib boshladim!" />

            <TextView
                android:id="@+id/tvReadMore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/roboto_medium"
                android:text="@string/community_post_read_more"
                android:textColor="?attr/colorPrimary"
                android:textSize="13sp"
                android:visibility="gone"
                tools:visibility="visible" />
        </LinearLayout>

        <!-- Media Container (No Inner Border) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/layoutMediaContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="14dp"
            android:layout_marginBottom="10dp"
            android:visibility="gone"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp"
            tools:visibility="visible">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <!-- Single Photo Container -->
                <FrameLayout
                    android:id="@+id/layoutSinglePhotoContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/colorSurfaceContainerLow"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <ImageView
                        android:id="@+id/imgSinglePhotoBlur"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:alpha="0.35"
                        android:visibility="gone"
                        tools:src="@drawable/placeholder_food"
                        tools:visibility="visible" />

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/imgSinglePhoto"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:adjustViewBounds="true"
                        android:scaleType="fitCenter"
                        app:shapeAppearance="@style/RadiusImageView12"
                        tools:src="@drawable/placeholder_food"
                        tools:visibility="visible" />

                </FrameLayout>

                <!-- Photo Comparison (Weight Loss: Before & After) -->
                <LinearLayout
                    android:id="@+id/layoutPhotoComparisonContainer"
                    android:layout_width="match_parent"
                    android:layout_height="260dp"
                    android:orientation="horizontal"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1">

                        <ImageView
                            android:id="@+id/imgBefore"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            tools:src="@drawable/user_photo_placeholder" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="bottom|start"
                            android:layout_margin="8dp"
                            android:background="@drawable/bg_rounded_soft"
                            android:backgroundTint="#99000000"
                            android:fontFamily="@font/roboto_bold"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="3dp"
                            android:text="@string/community_photo_oldin"
                            android:textColor="@android:color/white"
                            android:textSize="11sp" />
                    </FrameLayout>

                    <View
                        android:layout_width="2dp"
                        android:layout_height="match_parent"
                        android:background="?attr/colorSurfaceContainerLowest" />

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1">

                        <ImageView
                            android:id="@+id/imgAfter"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            tools:src="@drawable/user_photo_placeholder" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="bottom|end"
                            android:layout_margin="8dp"
                            android:background="@drawable/bg_rounded_soft"
                            android:backgroundTint="?attr/colorPrimary"
                            android:fontFamily="@font/roboto_bold"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="3dp"
                            android:text="@string/community_photo_hozir"
                            android:textColor="@android:color/white"
                            android:textSize="11sp" />
                    </FrameLayout>
                </LinearLayout>
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Post Actions Area (Likes & Comments - Clean & Transparent) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp"
            android:paddingTop="2dp"
            android:paddingBottom="10dp">

            <!-- Like Button -->
            <LinearLayout
                android:id="@+id/btnLike"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp">

                <ImageView
                    android:id="@+id/imgLike"
                    android:layout_width="19dp"
                    android:layout_height="19dp"
                    app:srcCompat="@drawable/like_ic"
                    app:tint="?attr/colorOnSurface" />

                <!-- Text format: "1 Yoqdi", "14 Foydali", "5 Tabriklayman" -->
                <TextView
                    android:id="@+id/tvLikeAction"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:fontFamily="@font/roboto_medium"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="13.5sp"
                    tools:text="1 Yoqdi" />
            </LinearLayout>

            <!-- Comments Button -->
            <LinearLayout
                android:id="@+id/btnComments"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="14dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp">

                <ImageView
                    android:id="@+id/imgComment"
                    android:layout_width="19dp"
                    android:layout_height="19dp"
                    app:srcCompat="@drawable/comment_ic"
                    app:tint="?attr/colorOnSurface" />

                <!-- Text format: "8 Fikrlar" or "Fikrlar" -->
                <TextView
                    android:id="@+id/tvCommentLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:fontFamily="@font/roboto_medium"
                    android:text="@string/community_post_action_comments"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="13.5sp"
                    tools:text="8 Fikrlar" />
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
