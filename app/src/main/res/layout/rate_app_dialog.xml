<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_bottom_sheet_premium"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="32dp"
        android:paddingBottom="32dp">

        <com.google.android.material.imageview.ShapeableImageView
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_gravity="center"
            android:src="@drawable/ozamiz_logo"
            app:shapeAppearanceOverlay="@style/CircleImageView" />

        <TextView
            style="@style/Title2_20"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="16dp"
            android:text="Ozamiz ilovasi yoqdimi?"
            android:textColor="?colorOnSurface" />

        <TextView
            style="@style/Text2_15"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="8dp"
            android:text="Fikringiz biz uchun juda muhim"
            android:textColor="?colorOnSurfaceVariant" />


        <androidx.appcompat.widget.AppCompatRatingBar
            android:id="@+id/rate_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="24dp"
            android:numStars="5"
            android:progressTint="@color/orange"
            android:secondaryProgressTint="@color/orange"
            android:stepSize="1" />

        <TextView
            android:id="@+id/text_rating_feedback"
            style="@style/Title3_17"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="12dp"
            android:text=""
            android:textColor="@color/orange"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_action"
            style="@style/FilledButton"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="32dp"
            android:text="Baholash"
            android:textAllCaps="false"
            android:textSize="18sp"
            app:cornerRadius="16dp" />

        <TextView
            android:id="@+id/btn_later"
            style="@style/Text2_15"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="16dp"
            android:padding="8dp"
            android:text="Keyinroq"
            android:textColor="?colorOnSurfaceVariant" />


    </LinearLayout>
</layout>