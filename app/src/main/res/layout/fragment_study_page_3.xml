<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:background="?colorSurface"
    android:layout_height="match_parent">

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/button_next_study_page3"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:clipToPadding="false"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <ImageView
                android:id="@+id/image_study_page3"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                android:src="@drawable/exercise_photo"
                android:scaleType="centerCrop"
                android:contentDescription="Harakat illustratsiyasi" />

            <TextView
                android:id="@+id/title_study_page3"
                style="@style/Title2_20"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:text="🏃‍♀️ Harakat qilish – Kaloriya yo‘qotish degani"
                android:textColor="?colorOnSurface" />

            <TextView
                android:id="@+id/explanation_study_page3"
                style="@style/Headline2_16"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:lineSpacingMultiplier="1.3"
                android:text="Tanangiz harakat qilganda kaloriyani yoqadi. Qancha ko‘p harakat – shuncha ko‘p kaloriya kuyadi."
                android:textColor="?colorOnSurface" />

            <!-- Piyoda yurish -->
            <TextView
                style="@style/Title3_17"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="🚶 Piyoda yurish"
                android:textColor="?colorOnSurface" />
            <TextView
                style="@style/Text1_16"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:lineSpacingMultiplier="1.3"
                android:textColor="?colorOnSurface"
                android:text="• 30 daqiqa odatdagi yurish  ~130–150 kaloriya\n• 1 soat yurish  ~250–300 kaloriya\nMisol: Do‘konga borib kelish (15+15 daqiqa) = ~120 kal" />

            <!-- Uy tozalash -->
            <TextView
                style="@style/Title3_17"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="🧹 Uy tozalash (supurish, yuvish)"
                android:textColor="?colorOnSurface" />
            <TextView
                style="@style/Text1_16"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:lineSpacingMultiplier="1.3"
                android:textColor="?colorOnSurface"
                android:text="• 1 soat uy ishlari → ~150–200 kaloriya\nMisol: Pol yuvish + idish yuvish = 160 kal" />

            <!-- Raqsga tushish -->
            <TextView
                style="@style/Title3_17"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="💃 Raqsga tushish (zumba yoki shunchaki uyda musiqa bilan)"
                android:textColor="?colorOnSurface" />
            <TextView
                style="@style/Text1_16"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:lineSpacingMultiplier="1.3"
                android:textColor="?colorOnSurface"
                android:text="• 30 daqiqa raqs → ~200–250 kaloriya\nMisol: TikTok ga 2–3 ta raqs video tayyorlash — 180 kal" />

            <TextView
                style="@style/Title3_17"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="🏃 Yugurish (sekin tempda)"
                android:textColor="?colorOnSurface" />
            <TextView
                style="@style/Text1_16"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:lineSpacingMultiplier="1.3"
                android:textColor="?colorOnSurface"
                android:text="• 30 daqiqa → 250–300 kaloriya\nMisol: Parkda engil yugurish = 280 kal" />

            <!-- Yengil mashqlar -->
            <TextView
                style="@style/Title3_17"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="🧘‍♀️ Yengil mashqlar (stretching, yoga)"
                android:textColor="?colorOnSurface" />
            <TextView
                style="@style/Text1_16"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:lineSpacingMultiplier="1.3"
                android:textColor="?colorOnSurface"
                android:text="• 30 daqiqa → ~100–150 kal" />


            <TextView
                android:id="@+id/key_idea_title_study_page3"
                style="@style/Title3_17"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="📢 Yodda saqlang:"
                android:textColor="?colorOnSurface" />

            <TextView
                android:id="@+id/key_idea_content_study_page3"
                style="@style/Title3_17"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:lineSpacingMultiplier="1.3"
                android:textColor="?colorPrimary"
                android:text="• O‘tirib o‘tgan 1 soat – yo‘qotilgan imkoniyat.\n• Hatto har kuni 100–150 kal yoqsangiz, 1 oyda 1–1.5 kg farq qiladi!" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_next_study_page3"
        style="@style/Widget.Material3.Button"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:text="Keyingisi"
        app:icon="@drawable/arrow_right"
        app:iconGravity="textEnd"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>