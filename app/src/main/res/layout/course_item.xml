<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    app:strokeWidth="2dp"
    app:cardCornerRadius="@dimen/dimen_12"
    android:layout_margin="@dimen/dimen_8"
    app:cardBackgroundColor="?colorSurfaceContainerLowest"
    app:strokeColor="#DBDBDB"
    android:layout_height="wrap_content">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:id="@+id/root_con"
        android:background="?colorSurfaceContainerLowest"
        android:paddingBottom="@dimen/dimen_12"
        >

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/photo_view"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_marginTop="@dimen/dimen_12"
            android:layout_marginStart="@dimen/dimen_12"
            android:scaleType="centerCrop"
            android:background="?colorSurfaceContainerLow"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:shapeAppearanceOverlay="@style/RadiusImageView12" />

        <TextView
            android:id="@+id/title_view"
            style="@style/Headline2_16"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/dimen_12"
            android:text="Qanday semiramiz?"
            android:textColor="?colorOnSurface"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/photo_view"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/aboutView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_4"
            android:maxLines="2"
            style="@style/Text1_14"
            android:text="Tana har kuni yeyilgan ovqatdagi energiyani sarflaydi."
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@+id/title_view"
            app:layout_constraintTop_toBottomOf="@+id/title_view" />

        <TextView
            style="@style/Headline3_15"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawableStart="@drawable/check_ic"
            android:drawablePadding="@dimen/dimen_4"
            android:layout_marginTop="@dimen/dimen_8"
            app:layout_constraintStart_toStartOf="parent"
            android:drawableTint="@color/green"
            android:visibility="gone"
            android:text="Tugatildi"
            android:textColor="@color/green"
            app:layout_constraintTop_toBottomOf="@+id/aboutView" />

        <ImageView
            android:id="@+id/locked_view"
            android:layout_marginTop="@dimen/dimen_8"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:src="@drawable/lock_ic"
            app:tint="?colorPrimary" />
    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>