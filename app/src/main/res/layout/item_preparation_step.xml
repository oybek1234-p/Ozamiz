<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingVertical="8dp">

    <TextView
        android:id="@+id/textView_step_number"
        style="@style/Headline3_15"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="?colorPrimary"
        android:layout_marginEnd="12dp"
        tools:text="1."/>

    <TextView
        android:id="@+id/textView_step_instruction"
        style="@style/Text1_14"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textColor="?colorOnSurface"
        android:lineSpacingMultiplier="1.2"
        tools:text="Tuxumni qaynatib oling. Sovuq suvga solib, qaynab chiqqandan keyin 8-10 daqiqa pishiring."/>
</LinearLayout>