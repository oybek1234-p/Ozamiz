<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:background="?colorSurfaceContainer"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/linearLayout2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:orientation="horizontal"
            android:scrollbarSize="0dp">

            <LinearLayout
                android:layout_marginTop="@dimen/dimen_12"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="@dimen/dimen_18"
                android:clipToPadding="false"
                android:orientation="horizontal">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/img1"
                    android:elevation="@dimen/dimen_4"
                    android:src="@drawable/man_result_photo_1"
                    android:layout_width="200dp"
                    android:layout_height="200dp"
                    app:shapeAppearance="@style/RadiusImageView12" />

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/img2"
                    android:elevation="@dimen/dimen_4"
                    android:layout_width="200dp"
                    android:layout_height="200dp"
                    android:src="@drawable/man_result_photo_2"
                    android:layout_marginStart="@dimen/dimen_18"
                    app:shapeAppearance="@style/RadiusImageView12" />

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/img3"
                    android:layout_width="200dp"
                    android:elevation="@dimen/dimen_4"
                    android:src="@drawable/man_result_photo_3"
                    android:layout_height="200dp"
                    android:layout_marginStart="@dimen/dimen_12"
                    app:shapeAppearance="@style/RadiusImageView12" />
            </LinearLayout>
        </HorizontalScrollView>

        <TextView
            style="@style/Title4_28"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/dimen_18"
            android:layout_marginTop="@dimen/dimen_24"
            android:fontFamily="@font/roboto_bold"
            android:gravity="center"
            android:text="@string/communtity_join"
            android:textColor="?colorOnSurface" />

        <TextView
            style="@style/Title3_17"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_12"
            android:gravity="center"
            android:layout_marginHorizontal="@dimen/dimen_18"
            android:text="@string/people_belivus"
            android:textColor="?colorOnSurface" />
    </LinearLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_24"
        android:scrollbarSize="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/linearLayout2">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingVertical="@dimen/dimen_2"
            android:paddingHorizontal="@dimen/dimen_18"
            android:clipToPadding="false"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="300dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="?colorSurfaceContainerLowest"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:layout_width="300dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:clipToPadding="false"
                    android:padding="@dimen/dimen_18">

                    <TextView
                        style="@style/Headline3_15"
                        android:maxLines="3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/review_1"
                        android:textColor="?colorOnSurface" />

                    <TextView
                        style="@style/Text1_14"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dimen_12"
                        android:text="@string/aziz_28_yosh"
                        android:textColor="?colorOnSurface" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="300dp"
                android:layout_height="wrap_content"
                app:cardElevation="2dp"
                app:cardBackgroundColor="?colorSurfaceContainerLowest"
                android:layout_marginStart="@dimen/dimen_12">

                <LinearLayout
                    android:layout_width="300dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/dimen_18">

                    <TextView
                        style="@style/Headline3_15"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="3"
                        android:text="@string/review_2"
                        android:textColor="?colorOnSurface" />

                    <TextView
                        style="@style/Text1_14"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dimen_12"
                        android:text="@string/madina_24_yosh"
                        android:textColor="?colorOnSurface" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </HorizontalScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/dimen_18"
        android:text="@string/davom_etish"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>