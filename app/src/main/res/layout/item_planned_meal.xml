<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/dimen_12"
    app:cardBackgroundColor="?colorSurfaceContainerLow"
    app:cardCornerRadius="@dimen/dimen_12"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="?colorSurfaceContainerLowest"
        android:padding="@dimen/dimen_12">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/imageView_meal_type_icon_plan"
                android:layout_width="32dp"
                app:shapeAppearance="@style/CircleImageView"
                android:layout_height="32dp"
                android:layout_marginEnd="12dp"
                tools:src="@drawable/breakfast_ic"/>

            <TextView
                android:id="@+id/textView_meal_type_plan"
                style="@style/Title3_17"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:textColor="?colorOnSurface"
                tools:text="Nonushta" />

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_replace_meal_plan"
                    style="@style/Widget.Material3.Button.TextButton.Icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Almashtirish"
                    android:textSize="13sp"
                    app:icon="@drawable/replace_ic"
                    app:iconSize="18dp"
                    app:iconGravity="textStart"
                    app:iconTint="?colorPrimary"
                    />

                <ProgressBar
                    android:id="@+id/progress_replace_meal"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:visibility="gone"
                    android:indeterminateTint="?colorPrimary"
                    tools:visibility="visible" />

            </FrameLayout>

        </LinearLayout>

        <TextView
            android:id="@+id/textView_meal_name_plan"
            style="@style/Headline3_15"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:drawablePadding="@dimen/dimen_8"
            android:drawableTint="?colorOnSurfaceVariant"
            android:layout_marginTop="@dimen/dimen_8"
            android:textColor="?colorOnSurface"
            tools:text="Suli yormasi (banan va yong'oqlar bilan)" />

        <!-- Nutrients Horizontal Layout -->
        <!-- Ingredients Section (Expandable) -->
        <TextView
            android:id="@+id/textView_ingredients_title_plan"
            style="@style/Subtitle2_14"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Masalliqlar"
            app:drawableTint="?colorOnSurfaceVariant"
            android:textColor="?colorOnSurface"/>

        <LinearLayout
            android:layout_marginTop="@dimen/dimen_8"
            android:id="@+id/layout_ingredients_plan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            tools:visibility="visible">

        </LinearLayout>

        <TextView
            android:id="@+id/textView_preparation_title_plan"
            style="@style/Subtitle2_14"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Tayyorlanishi"
            app:drawableTint="?colorOnSurfaceVariant"
            android:textColor="?colorOnSurface"/>

        <LinearLayout
            android:id="@+id/layout_preparation_plan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_8"
            android:orientation="vertical"
            tools:visibility="visible">

        </LinearLayout>

        <TextView
            android:id="@+id/textView_health_benefits_title_plan"
            style="@style/Subtitle2_14"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Foydali jihatlari"
            app:drawableTint="?colorOnSurfaceVariant"
            android:textColor="?colorOnSurface"/>

        <TextView
            android:id="@+id/textView_health_benefits_plan"
            style="@style/Text2_15"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingMultiplier="1.1"
            android:textColor="?colorOnSurface"
            android:layout_marginTop="@dimen/dimen_8"
            tools:visibility="visible"
            tools:text="Bu ovqat kletchatkaga boy va uzoq vaqt to'q tutadi."/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="horizontal"
            android:baselineAligned="false">

            <LinearLayout style="@style/MacroItemLayout">
                <TextView style="@style/MacroItemLabel"
                    android:text="Kaloriya"/>
                <TextView
                    android:id="@+id/textView_calories_plan"
                    style="@style/MacroItemValue"
                    android:textColor="?colorOnSurface"
                    android:fontFamily="@font/roboto_medium"
                    tools:text="300 kkal"/>
            </LinearLayout>
            <LinearLayout style="@style/MacroItemLayout">
                <TextView style="@style/MacroItemLabel" android:text="@string/protein_short"/>
                <TextView android:id="@+id/textView_protein_plan" style="@style/MacroItemValue" tools:text="8.0 g"/>
            </LinearLayout>
            <LinearLayout style="@style/MacroItemLayout">
                <TextView style="@style/MacroItemLabel" android:text="@string/fat_short"/>
                <TextView android:id="@+id/textView_fat_plan" style="@style/MacroItemValue" tools:text="10 g"/>
            </LinearLayout>
            <LinearLayout style="@style/MacroItemLayout">
                <TextView style="@style/MacroItemLabel" android:text="@string/carbs_short"/>
                <TextView android:id="@+id/textView_carbs_plan" style="@style/MacroItemValue" tools:text="50 g"/>
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>