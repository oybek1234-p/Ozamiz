<!-- res/layout/item_planned_meal.xml -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/dimen_12"
    app:cardBackgroundColor="?colorSurfaceContainer"
    app:cardCornerRadius="@dimen/dimen_12"
    app:cardElevation="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/dimen_12">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/imageView_meal_type_icon_plan"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginEnd="12dp"
                app:tint="?colorPrimary"
                tools:src="@drawable/breakfast_ic"/>

            <TextView
                android:id="@+id/textView_meal_type_plan"
                style="@style/Title3_17"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:textColor="?colorOnSurface"
                tools:text="Nonushta" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_replace_meal_plan"
                style="@style/Widget.Material3.Button.TextButton.Icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Almashtirish"
                android:textSize="13sp"
                app:icon="@drawable/ic_replace_meal"
                app:iconSize="18dp"
                app:iconGravity="textStart"
                app:iconTint="?colorPrimary"
                android:visibility="gone"
                tools:visibility="visible"/>
        </LinearLayout>

        <TextView
            android:id="@+id/textView_meal_name_plan"
            style="@style/Headline2_16"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_8"
            android:textColor="?colorOnSurface"
            tools:text="Suli yormasi (banan va yong'oqlar bilan)" />

        <!-- Nutrients Horizontal Layout -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:baselineAligned="false">

            <LinearLayout style="@style/MacroItemLayout">
                <TextView style="@style/MacroItemLabel" android:text="Kaloriya"/>
                <TextView android:id="@+id/textView_calories_plan" style="@style/MacroItemValue" tools:text="300 kkal"/>
            </LinearLayout>
            <LinearLayout style="@style/MacroItemLayout">
                <TextView style="@style/MacroItemLabel" android:text="@string/protein_short"/>
                <TextView android:id="@+id/textView_protein_plan" style="@style/MacroItemValue" tools:text="8.0 g"/>
            </LinearLayout>
            <LinearLayout style="@style/MacroItemLayout">
                <TextView style="@style/MacroItemLabel" android:text="@string/fat_short"/>
                <TextView android:id="@+id/textView_fat_plan" style="@style/MacroItemValue" tools:text="10 g"/>
            </LinearLayout>
            <LinearLayout style="@style/MacroItemLayout">
                <TextView style="@style/MacroItemLabel" android:text="@string/carbs_short"/>
                <TextView android:id="@+id/textView_carbs_plan" style="@style/MacroItemValue" tools:text="50 g"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Ingredients Section (Expandable) -->
        <TextView
            android:id="@+id/textView_ingredients_title_plan"
            style="@style/Headline3_15"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Masalliqlar"
            android:drawableEnd="@drawable/ic_expand_more"
            app:drawableTint="?colorOnSurfaceVariant"
            android:textColor="?colorOnSurfaceVariant"/>

        <LinearLayout
            android:id="@+id/layout_ingredients_plan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">
            <!-- Ingredients will be added programmatically or via RecyclerView -->
            <TextView style="@style/Text1_14" android:layout_marginTop="4dp" android:textColor="?colorOnSurfaceVariant" tools:text="- 50g suli yormasi"/>
            <TextView style="@style/Text1_14" android:layout_marginTop="2dp" android:textColor="?colorOnSurfaceVariant" tools:text="- 250ml suv"/>
            <TextView style="@style/Text1_14" android:layout_marginTop="2dp" android:textColor="?colorOnSurfaceVariant" tools:text="- 10g yong'oq"/>
        </LinearLayout>

        <!-- Preparation Steps Section (Expandable) -->
        <TextView
            android:id="@+id/textView_preparation_title_plan"
            style="@style/Headline3_15"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Tayyorlanishi"
            android:drawableEnd="@drawable/ic_expand_more"
            app:drawableTint="?colorOnSurfaceVariant"
            android:textColor="?colorOnSurfaceVariant"/>

        <LinearLayout
            android:id="@+id/layout_preparation_plan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">
            <!-- Preparation steps will be added programmatically or via RecyclerView -->
            <TextView style="@style/Text1_14" android:layout_marginTop="4dp" android:textColor="?colorOnSurfaceVariant" tools:text="1. Suli yormasini suvda quyuqlashguncha pishiring."/>
        </LinearLayout>

        <!-- Health Benefits Section (Expandable) -->
        <TextView
            android:id="@+id/textView_health_benefits_title_plan"
            style="@style/Headline3_15"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Foydali jihatlari"
            android:drawableEnd="@drawable/ic_expand_more"
            app:drawableTint="?colorOnSurfaceVariant"
            android:textColor="?colorOnSurfaceVariant"/>

        <TextView
            android:id="@+id/textView_health_benefits_plan"
            style="@style/Text1_14"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:lineSpacingMultiplier="1.1"
            android:textColor="?colorOnSurfaceVariant"
            android:visibility="gone"
            tools:visibility="visible"
            tools:text="Bu ovqat kletchatkaga boy va uzoq vaqt to'q tutadi."/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_log_food_plan"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Logga qo'shish"
            app:icon="@drawable/add_circle_ic"
            app:iconGravity="textStart"/>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>