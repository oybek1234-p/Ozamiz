<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_bottom_sheet_top_rounded"
        android:backgroundTint="?attr/colorSurfaceContainer"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="24dp">

        <!-- Drag Handle -->
        <View
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_rounded_8"
            android:backgroundTint="?attr/colorOutlineVariant" />

        <!-- Title -->
        <TextView
            android:id="@+id/boglanish"
            style="@style/TextAppearance.Material3.TitleMedium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:drawableStart="@drawable/help_ic"
            android:drawablePadding="10dp"
            android:fontFamily="@font/roboto_bold"
            android:gravity="center"
            android:text="@string/help_and_support"
            android:textColor="?attr/colorOnSurface"
            app:drawableTint="?attr/colorOnSurface" />

        <!-- Call Operator Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/callview"
            style="@style/Widget.Material3.Button"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:fontFamily="@font/roboto_bold"
            android:text="@string/support_sheet_call"
            android:textSize="15sp"
            app:cornerRadius="16dp"
            app:icon="@drawable/call_ic"
            app:iconGravity="textStart"
            app:iconPadding="10dp"
            app:iconSize="20dp" />

        <!-- Telegram Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/request_button"
            style="@style/Widget.Material3.Button"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/roboto_bold"
            android:text="@string/support_sheet_telegram"
            android:textSize="15sp"
            app:cornerRadius="16dp"
            app:icon="@drawable/telegram_ic"
            app:iconGravity="textStart"
            app:iconPadding="10dp"
            app:iconSize="20dp" />

    </LinearLayout>
</layout>
