<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_rounded"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

        <TextView
            android:id="@+id/text_achievement_emoji"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="72sp"
            android:text="🥇" />

        <TextView
            android:id="@+id/text_achievement_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/roboto_bold"
            android:text="Mashg'ulot qahramoni!"
            android:textColor="?colorOnSurface"
            android:textSize="20sp"
            android:textAlignment="center" />

        <TextView
            android:id="@+id/text_achievement_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/roboto_regular"
            android:text="Siz bugungi rejalashtirilgan kaloriya sarfining 70% idan ko'prog'ini yoqdingiz!"
            android:textColor="?colorOnSurfaceVariant"
            android:textSize="14sp"
            android:textAlignment="center" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_ajoyib"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Ajoyib!"
            app:cornerRadius="16dp" />

    </LinearLayout>

