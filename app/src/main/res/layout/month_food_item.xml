<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_marginTop="@dimen/dimen_12"
    app:cardBackgroundColor="?colorSurface"
    app:cardElevation="@dimen/dimen_2"
    android:layout_margin="@dimen/dimen_8"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?colorSurface"
        android:padding="@dimen/dimen_18"
        android:orientation="vertical">
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            >
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/day_count"
                android:text="2-kun"
                style="@style/Title3_17"
                android:textColor="?colorOnSurface"
                />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/premium"
                android:text="Premium"
                android:layout_gravity="end"
                style="@style/Title3_17"
                android:textColor="?colorPrimary"
                />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/foods_con"
            android:orientation="vertical"
            >
            <TextView
                style="@style/Headline2_16"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nonushta"
                android:layout_marginTop="@dimen/dimen_12"
                android:textColor="?colorOnSurface" />

            <TextView
                style="@style/Text1_16"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_8"
                android:text="Grechka + qatiq + bodring"
                android:textColor="?colorOnSurface" />

            <TextView
                style="@style/Headline2_16"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_8"
                android:text="Tushlik"
                android:textColor="?colorOnSurface" />

            <TextView
                style="@style/Text1_16"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_8"
                android:text="Tovuq sho'rva + bodring"
                android:textColor="?colorOnSurface" />

            <TextView
                style="@style/Headline2_16"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_12"
                android:text="Kechki ovqat"
                android:textColor="?colorOnSurface" />

            <TextView
                style="@style/Text1_16"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_8"
                android:text="Qatiq(200ml) + bodring"
                android:textColor="?colorOnSurface" />
        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
