<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:background="?colorSurfaceContainerLowest"
    android:layout_height="match_parent"
    android:paddingVertical="@dimen/dimen_12">

    <ImageView
        android:id="@+id/back_button"
        android:layout_width="@dimen/dimen_48"
        android:layout_height="@dimen/dimen_48"
        android:scaleType="center"
        android:src="@drawable/arrow_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="?colorOnSurface" />

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/container_child"
        android:layout_width="match_parent"
        android:name="androidx.navigation.fragment.NavHostFragment"
        android:layout_height="0dp"
        app:navGraph="@navigation/onboarding_nav"
        android:layout_marginTop="@dimen/dimen_24"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/progress_bar" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progress_bar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dimen_12"
        android:progress="50"
        app:indicatorTrackGapSize="0dp"
        android:indeterminateTint="?colorSecondary"
        app:indicatorColor="@color/green"
        app:trackColor="@color/green_alpha_10"
        app:layout_constraintBottom_toBottomOf="@+id/back_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/back_button"
        app:layout_constraintTop_toTopOf="@+id/back_button"
        app:trackStopIndicatorPadding="0dp"
        app:trackStopIndicatorSize="0dp"
        app:trackThickness="@dimen/dimen_12" />

</androidx.constraintlayout.widget.ConstraintLayout>