<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:background="?colorSurfaceContainerLowest"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/back_view"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_margin="@dimen/dimen_12"
        android:scaleType="center"
        android:src="@drawable/arrow_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/anim_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintDimensionRatio="1:0.9"
        android:layout_marginTop="@dimen/dimen_24"
        android:scaleType="centerCrop"
        android:src="@drawable/placeholder_workout"
        app:layout_constraintTop_toBottomOf="@+id/back_view" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/ready_to_go_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:padding="@dimen/dimen_24"
        android:clipToPadding="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/anim_view">

        <LinearLayout
            android:id="@+id/linearLayout2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:layout_marginBottom="@dimen/dimen_24"
            app:layout_constraintBottom_toTopOf="@+id/ready_progress"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/ready_to_go_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/roboto_bold"
                android:text="@string/ready_to_go"
                android:textColor="?colorOnSurface"
                android:textSize="40sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/name_view"
                style="@style/Title4_24"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_12"
                android:text="Jumping squats"
                android:textColor="?colorOnSurfaceVariant"
                app:layout_constraintEnd_toEndOf="@+id/ready_to_go_text"
                app:layout_constraintStart_toStartOf="@+id/ready_to_go_text"
                app:layout_constraintTop_toBottomOf="@+id/ready_to_go_text" />
        </LinearLayout>

        <TextView
            android:id="@+id/textView2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/roboto_medium"
            android:text="8"
            android:textColor="?colorOnSurface"
            android:textSize="70dp"
            app:layout_constraintBottom_toBottomOf="@+id/ready_progress"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/ready_progress" />

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/ready_progress"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:indeterminate="false"
            android:progress="100"
            app:indicatorDirectionCircular="clockwise"
            app:indicatorSize="130dp"
            app:indicatorTrackGapSize="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@+id/textView2"
            app:layout_constraintStart_toStartOf="@+id/textView2"
            app:trackCornerRadius="@dimen/dimen_8"
            app:trackThickness="@dimen/dimen_6" />

        <ImageView
            android:id="@+id/skip_ready_to_go"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:scaleType="centerCrop"
            android:src="@drawable/arrow_right"
            app:layout_constraintBottom_toBottomOf="@+id/textView2"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/ready_progress"
            app:layout_constraintTop_toTopOf="@+id/textView2"
            app:tint="?colorOnSurfaceVariant" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/working_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        android:padding="@dimen/dimen_24"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/anim_view"
        app:layout_constraintVertical_bias="0.0">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_marginBottom="@dimen/dimen_24"
            android:orientation="vertical"
            app:layout_constraintBottom_toTopOf="@+id/materialButton"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <TextView
                android:id="@+id/working_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/roboto_bold"
                android:text="Jumping squats"
                android:textColor="?colorOnSurfaceVariant"
                android:textSize="28sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/working_count_view"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/roboto_bold"
                android:text="00:30"
                android:textColor="?colorOnSurface"
                android:textSize="50sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/working_name" />

        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/materialButton"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingHorizontal="80dp"
            android:layout_marginBottom="@dimen/dimen_24"
            android:paddingVertical="@dimen/dimen_20"
            android:text="Pause"
            android:textSize="20sp"
            app:icon="@drawable/pause_ic"
            app:iconGravity="textStart"
            app:layout_constraintBottom_toTopOf="@+id/linearLayout"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <LinearLayout
            android:id="@+id/linearLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/dimen_24"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/working_prev"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Oldingi"
                android:textColor="?colorOnSurfaceVariant"
                android:textSize="18sp"
                app:icon="@drawable/arrow_back"
                app:iconGravity="textStart" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/working_next"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dimen_24"
                android:layout_weight="1"
                android:text="Keyingi"
                android:textColor="?colorOnSurfaceVariant"
                android:textSize="18sp"
                app:icon="@drawable/arrow_right"
                app:iconGravity="textEnd" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <TextView
        android:id="@+id/exercise_size_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dimen_12"
        android:fontFamily="@font/roboto_medium"
        android:text="7/13"
        android:textColor="?colorOnSurfaceVariant"
        android:textSize="20sp"
        app:layout_constraintBottom_toBottomOf="@+id/back_view"
        app:layout_constraintStart_toEndOf="@+id/back_view"
        app:layout_constraintTop_toTopOf="@+id/back_view" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/rest_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:background="#332F38"
       >

        <TextView
            android:id="@+id/rest_count_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/roboto_bold"
            android:text="29"
            android:textColor="@color/white"
            android:textSize="50sp"
            app:layout_constraintBottom_toTopOf="@+id/constraintLayout"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/textView3" />

        <TextView
            android:id="@+id/add_rest_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/round_lay_stroke"
            android:backgroundTint="#27FFFFFF"
            android:paddingHorizontal="@dimen/dimen_12"
            android:paddingVertical="@dimen/dimen_8"
            android:fontFamily="@font/roboto_medium"
            android:text="+20s"
            android:textColor="@color/white"
            android:textSize="25sp"
            app:layout_constraintBottom_toBottomOf="@+id/rest_progress"
            app:layout_constraintEnd_toStartOf="@+id/rest_progress"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/rest_progress" />

        <TextView
            android:id="@+id/skip_rest_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/roboto_medium"
            android:background="@drawable/round_lay_stroke"
            android:backgroundTint="#27FFFFFF"
            android:paddingHorizontal="@dimen/dimen_12"
            android:paddingVertical="@dimen/dimen_8"
            android:text="Keyingi"
            android:textColor="@color/white"
            android:textSize="20sp"
            app:layout_constraintBottom_toBottomOf="@+id/rest_progress"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/rest_progress"
            app:layout_constraintTop_toTopOf="@+id/rest_progress" />

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/rest_progress"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:indeterminate="false"
            android:progress="100"
            app:indicatorDirectionCircular="clockwise"
            app:indicatorSize="120dp"
            app:indicatorTrackGapSize="0dp"
            app:layout_constraintBottom_toBottomOf="@+id/rest_count_view"
            app:layout_constraintEnd_toEndOf="@+id/rest_count_view"
            app:layout_constraintStart_toStartOf="@+id/rest_count_view"
            app:layout_constraintTop_toTopOf="@+id/rest_count_view"
            app:trackCornerRadius="@dimen/dimen_8"
            app:trackThickness="@dimen/dimen_4" />

        <TextView
            android:id="@+id/textView3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_48"
            android:fontFamily="@font/roboto_bold"
            android:text="@string/tts_rest"
            android:textColor="#8BC34A"
            android:textSize="30sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />


        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/constraintLayout"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:background="@drawable/round_lay"
            android:backgroundTint="?colorSurfaceContainerLowest"
            android:padding="@dimen/dimen_24"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <TextView
                android:id="@+id/next_count_view"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/roboto_medium"
                android:text="Keyingisi 8/13"
                android:textColor="?colorOnSurfaceVariant"
                android:textSize="18sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/rest_next_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/roboto_bold"
                android:text="Jumping squats 00:26"
                android:textColor="?colorOnSurface"
                android:textSize="24sp"
                app:layout_constraintStart_toStartOf="@+id/next_count_view"
                app:layout_constraintTop_toBottomOf="@+id/next_count_view" />

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/next_image_view"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_margin="@dimen/dimen_48"
                android:scaleType="center"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/rest_next_name"
                tools:background="?colorSurfaceContainerLow"
                tools:shapeAppearanceOverlay="@style/RadiusImageView12" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>