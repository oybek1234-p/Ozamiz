<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_file_picker"
    style="@style/Widget.Material3.CardView.Outlined"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="56dp"
    app:cardCornerRadius="8dp"
    app:strokeWidth="1dp"
    app:strokeColor="?colorOutlineVariant"
    android:clickable="true"
    android:focusable="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp">

        <ImageView
            android:id="@+id/icon_file_type"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/mic_ic"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:tint="?colorOnSurfaceVariant" />

        <LinearLayout
            android:id="@+id/layout_file_info"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintStart_toEndOf="@id/icon_file_type"
            app:layout_constraintEnd_toStartOf="@+id/button_remove_file"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <TextView
                android:id="@+id/textView_file_picker_title"
                style="@style/TextLabelMedium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?colorOnSurfaceVariant"
                tools:text="Mashq nomi audiosi (ixtiyoriy)" />

            <TextView
                android:id="@+id/textView_file_picker_status"
                style="@style/TextBodyMedium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Audio fayl tanlang"
                android:textColor="?colorPrimary"
                android:visibility="visible" />

        </LinearLayout>

        <ImageButton
            android:id="@+id/button_remove_file"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/close_ic"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Tanlangan faylni olib tashlash"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:tint="?colorError"
            tools:visibility="visible"/>

        <ProgressBar
            android:id="@+id/progressBar_file_upload"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:indeterminate="true"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            tools:visibility="visible" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>