<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?selectableItemBackground"
    app:cardBackgroundColor="?colorSurfaceContainer"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="14dp">

        <!-- Food details: Title + subtitle (e.g. "350 g • 420 kkal • Kletchatkaga boy") in natural vertical flow -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textView_ingredient_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/roboto_bold"
                android:maxLines="1"
                android:textColor="?colorOnSurface"
                android:textSize="16sp"
                tools:text="Choyxona palovi" />

            <!-- Subtitle: Amount & Calories (14sp) + Traffic light indicator dot + Nutrient tag -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/textView_ingredient_amount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/roboto_regular"
                    android:textColor="?colorOnSurfaceVariant"
                    android:textSize="14sp"
                    tools:text="350 g • 420 kkal" />

                <!-- Traffic Light Dot -->
                <View
                    android:id="@+id/view_status_dot"
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/round_lay"
                    android:visibility="gone"
                    tools:backgroundTint="#4CAF50"
                    tools:visibility="visible" />

                <!-- Nutrient Tag (e.g. Kletchatka, Toza oqsil, Yog') -->
                <TextView
                    android:id="@+id/textView_nutrient_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/roboto_regular"
                    android:textSize="13.5sp"
                    android:visibility="gone"
                    tools:text="Kletchatka"
                    tools:textColor="#4CAF50"
                    tools:visibility="visible" />
            </LinearLayout>

            <!-- Tags container -->
            <HorizontalScrollView
                android:id="@+id/scroll_tags"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:scrollbars="none"
                android:visibility="gone"
                tools:visibility="visible">

                <LinearLayout
                    android:id="@+id/layout_tags_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <!-- Hidden stub for binding compatibility -->
            <TextView
                android:id="@+id/textView_ingredient_advice"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

        </LinearLayout>

        <!-- Right Side: Edit Icon Button Only -->
        <ImageView
            android:id="@+id/button_edit_ingredient"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="@string/edit"
            android:focusable="true"
            android:padding="7dp"
            android:src="@drawable/edit"
            app:tint="?colorOnSurfaceVariant" />

        <!-- Hidden compatibility stubs for binding -->
        <ImageView
            android:id="@+id/button_delete_ingredient"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
        <TextView
            android:id="@+id/textView_ingredient_calories"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/layout_tags"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/textView_suitability_badge"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layout_ingredient_advice"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/textView_ingredient_macros"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>