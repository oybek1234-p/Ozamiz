<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/round_lay"
    android:backgroundTint="?colorSurfaceContainerHigh"
    android:layout_marginBottom="8dp"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp"
    android:paddingVertical="12dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/textView_ingredient_name"
            style="@style/Text1_16"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/roboto_medium"
            android:textColor="?colorOnSurface"
            tools:text="Lettuce" />

        <TextView
            android:id="@+id/textView_ingredient_calories"
            style="@style/Text2_15"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textColor="?colorOnSurfaceVariant"
            tools:text="• 20 cal" />
    </LinearLayout>

    <TextView
        android:id="@+id/textView_ingredient_amount"
        style="@style/Text2_15"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/round_lay"
        android:backgroundTint="?colorSurface"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp"
        android:textColor="?colorOnSurfaceVariant"
        tools:text="1.5 cups" />

</LinearLayout>