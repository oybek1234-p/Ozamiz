<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="16dp"
        android:visibility="gone"
        app:cardBackgroundColor="?attr/colorSurfaceContainer"
        app:cardCornerRadius="20dp"
        android:clipChildren="false"
        app:cardElevation="0dp"
        android:clipToPadding="false"
        app:strokeWidth="0dp"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="horizontal">

                <TextView

                    android:id="@+id/text_limit_emoji"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dimen_8"
                    android:layout_gravity="top"
                    android:includeFontPadding="false"
                    android:textSize="20sp"
                    tools:text="🎉" />

                <TextView
                    android:id="@+id/text_limit_reached_message"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top"
                    android:layout_marginStart="@dimen/dimen_12"
                    android:layout_weight="1"
                    android:fontFamily="@font/roboto_medium"
                    android:includeFontPadding="false"
                    android:lineSpacingExtra="2dp"
                    android:paddingBottom="4dp"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="15sp"
                    tools:text="Maqsad bajarildi, tez orada tanangiz yog' yoqishga o'tadi, ertagacha faqat suv ichishingiz mumkin" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_how_fat_burned"
                style="@style/FilledButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="12dp"
                android:backgroundTint="?attr/colorPrimary"
                android:paddingHorizontal="@dimen/dimen_12"
                android:text="@string/home_progress_fat_burned_btn"
                android:textAllCaps="false"
                android:textColor="?attr/colorOnPrimary"
                android:textSize="13sp"
                android:visibility="gone"
             />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_hungry_what_to_eat"
                style="@style/FilledButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="12dp"
                android:backgroundTint="?attr/colorPrimary"
                android:paddingHorizontal="@dimen/dimen_12"
                android:text="@string/home_progress_hungry_btn"
                android:textAllCaps="false"
                android:textColor="?attr/colorOnPrimary"
                app:icon="@drawable/chat_ic"
                app:iconGravity="textStart"
                app:iconPadding="8dp"
                app:iconSize="18dp"
                app:iconTint="?attr/colorOnPrimary" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</layout>
