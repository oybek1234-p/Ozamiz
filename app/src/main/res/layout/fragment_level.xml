<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?colorSurface">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar_level"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?colorSurface"
        app:navigationIcon="@drawable/arrow_back"
        app:title="Mening darajam"
        app:titleCentered="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/layout_current_level_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingHorizontal="24dp"
        android:paddingTop="24dp"
        android:paddingBottom="16dp"
        app:layout_constraintTop_toBottomOf="@id/toolbar_level"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/text_current_emoji"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="72sp"
            android:gravity="center"
            tools:text="🔥" />

        <TextView
            android:id="@+id/text_current_level_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/roboto_bold"
            android:textColor="?colorOnSurface"
            android:textSize="26sp"
            android:gravity="center"
            tools:text="Iroda" />

        <TextView
            android:id="@+id/text_current_points"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/roboto_medium"
            android:textColor="?colorPrimary"
            android:textSize="16sp"
            android:gravity="center"
            tools:text="500 ball" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progress_to_next_level"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:trackCornerRadius="6dp"
            app:trackThickness="12dp"
            app:indicatorTrackGapSize="0dp"
            app:trackStopIndicatorSize="0dp"
            app:trackStopIndicatorPadding="0dp"
            app:trackColor="?colorSurfaceContainerHigh"
            app:indicatorColor="?colorPrimary"
            tools:progress="60" />

        <TextView
            android:id="@+id/text_next_level_points"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="@font/roboto_regular"
            android:textColor="?colorOnSurfaceVariant"
            android:textSize="13sp"
            android:gravity="center"
            tools:text="Keyingi darajaga 400 ball qoldi" />

    </LinearLayout>

    <TextView
        android:id="@+id/text_all_levels_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/roboto_bold"
        android:text="Barcha darajalar"
        android:textColor="?colorOnSurface"
        android:textSize="18sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layout_current_level_info" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_levels"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:clipToPadding="false"
        android:paddingHorizontal="16dp"
        android:paddingBottom="32dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintTop_toBottomOf="@id/text_all_levels_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        tools:itemCount="10"
        tools:listitem="@layout/item_level" />

</androidx.constraintlayout.widget.ConstraintLayout>
