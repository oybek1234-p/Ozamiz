<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?colorSurfaceContainerLowest">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
    android:background="?colorSurfaceContainerLowest">
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar_level"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@drawable/arrow_back"
            app:title="Mening darajam"
            app:titleCentered="true" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_current_level"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="20dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="4dp"
            app:strokeWidth="0dp"
            app:cardBackgroundColor="?attr/colorSurfaceContainerLow">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="20dp"
                android:paddingVertical="24dp">

                <TextView
                    android:id="@+id/text_current_emoji"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:textSize="54sp"
                    android:gravity="center"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    tools:text="🌱" />

                <TextView
                    android:id="@+id/text_current_level_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:fontFamily="@font/roboto_bold"
                    android:textColor="?colorOnSurface"
                    android:textSize="22sp"
                    app:layout_constraintTop_toTopOf="@+id/text_current_emoji"
                    app:layout_constraintBottom_toTopOf="@id/text_current_points"
                    app:layout_constraintStart_toEndOf="@id/text_current_emoji"
                    app:layout_constraintEnd_toEndOf="parent"
                    tools:text="Boshlovchi" />

                <TextView
                    android:id="@+id/text_current_points"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/roboto_medium"
                    android:textColor="?colorPrimary"
                    android:textSize="16sp"
                    app:layout_constraintTop_toBottomOf="@id/text_current_level_name"
                    app:layout_constraintBottom_toBottomOf="@+id/text_current_emoji"
                    app:layout_constraintStart_toStartOf="@id/text_current_level_name"
                    app:layout_constraintEnd_toEndOf="parent"
                    tools:text="350 ball" />

                <!-- Daraja Haqida Ma'lumot (Description / Motivation Text) -->
                <TextView
                    android:id="@+id/text_current_description"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:fontFamily="@font/roboto_regular"
                    android:textColor="?colorOnSurface"
                    android:textSize="14sp"
                    android:lineSpacingMultiplier="1.2"
                    app:layout_constraintTop_toBottomOf="@id/text_current_emoji"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    tools:text="Birinchi qadamni tashladingiz, endi orqaga qaytish yo'q!" />

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/progress_to_next_level"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:trackStopIndicatorSize="0dp"
                    android:layout_marginTop="16dp"
                    app:trackCornerRadius="6dp"
                    app:trackThickness="10dp"
                    app:indicatorTrackGapSize="0dp"
                    app:trackColor="?colorSurfaceContainerHigh"
                    app:indicatorColor="?colorPrimary"
                    app:layout_constraintTop_toBottomOf="@id/text_current_description"
                    tools:progress="60" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/text_all_levels_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginBottom="12dp"
            android:fontFamily="@font/roboto_bold"
            android:text="Keyingi bosqich"
            android:textColor="?colorOnSurface"
            android:textSize="16sp" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_levels"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:clipToPadding="false"
        android:paddingHorizontal="16dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        tools:listitem="@layout/item_level" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>