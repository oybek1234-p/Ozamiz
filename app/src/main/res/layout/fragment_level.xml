<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?colorSurface">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?colorSurface"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar_level"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@drawable/arrow_back"
            app:title="Mening darajam"
            app:titleCentered="true" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_current_level"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp"
            app:cardCornerRadius="32dp"
            app:cardElevation="4dp"
            app:strokeWidth="0dp"
            app:cardBackgroundColor="?colorSurfaceContainerLowest">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="24dp"
                android:paddingVertical="32dp">

                <TextView
                    android:id="@+id/text_current_emoji"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="80sp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    tools:text="🔥" />

                <TextView
                    android:id="@+id/text_current_level_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:fontFamily="@font/roboto_bold"
                    android:textColor="?colorOnPrimaryContainer"
                    android:textSize="28sp"
                    app:layout_constraintTop_toBottomOf="@id/text_current_emoji"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    tools:text="Iroda" />

                <TextView
                    android:id="@+id/text_current_points"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/roboto_bold"
                    android:textColor="?colorPrimary"
                    android:textSize="20sp"
                    app:layout_constraintTop_toBottomOf="@id/text_current_level_name"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    tools:text="500 ball" />

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/progress_to_next_level"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    app:trackCornerRadius="8dp"
                    app:trackThickness="12dp"
                    app:indicatorTrackGapSize="0dp"
                    app:trackStopIndicatorSize="0dp"
                    app:trackStopIndicatorPadding="0dp"
                    app:trackColor="?colorSurfaceContainerHighest"
                    app:indicatorColor="?colorPrimary"
                    app:layout_constraintTop_toBottomOf="@id/text_current_points"
                    tools:progress="60" />

                <TextView
                    android:id="@+id/text_next_level_points"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:fontFamily="@font/roboto_medium"
                    android:textColor="?colorOnSurfaceVariant"
                    android:textSize="14sp"
                    android:gravity="center"
                    app:layout_constraintTop_toBottomOf="@id/progress_to_next_level"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    tools:text="Keyingi darajaga 400 ball qoldi" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/text_all_levels_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginBottom="12dp"
            android:fontFamily="@font/roboto_bold"
            android:text="Barcha bosqichlar"
            android:textColor="?colorOnSurface"
            android:textSize="18sp" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_levels"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingHorizontal="16dp"
        android:paddingBottom="24dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        tools:listitem="@layout/item_level" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
