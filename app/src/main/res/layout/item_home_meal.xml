<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/meal_root_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="16dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/image_meal_icon"
            android:layout_width="50dp"
            app:shapeAppearance="@style/CircleImageView"
            android:layout_height="50dp"
            app:strokeColor="#D2D2D2"
            app:strokeWidth="2dp"
            android:padding="@dimen/dimen_2"
            android:scaleType="centerCrop"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:src="@drawable/breakfast_ic" />

        <TextView
            android:id="@+id/text_meal_name"
            style="@style/Subtitle2_14"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:textColor="?colorOnSurface"
            app:layout_constraintStart_toEndOf="@+id/image_meal_icon"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"
            tools:text="Nonushta" />

        <TextView
            android:id="@+id/text_meal_calories"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_2"
            android:textColor="?colorOnSurfaceVariant"
            android:textSize="13sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/button_add_meal"
            app:layout_constraintStart_toStartOf="@+id/text_meal_name"
            app:layout_constraintTop_toBottomOf="@+id/text_meal_name"
            tools:text="250 kal" />

        <TextView
            android:id="@+id/text_meal_reminder_time"
            style="@style/Caption1_13"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/dimen_12"
            android:textColor="?colorOnSurfaceVariant"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@+id/button_add_meal"
            app:layout_constraintEnd_toEndOf="@+id/text_meal_calories"
            app:layout_constraintTop_toTopOf="@+id/button_add_meal"
            tools:text="07:00"
            tools:visibility="visible" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_add_meal"
            style="@style/Widget.Material3.Button.IconButton.Filled"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:paddingVertical="@dimen/dimen_2"
            android:src="@drawable/add_ic"
            android:textSize="13sp"
            app:icon="@drawable/add_ic"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <LinearLayout
        android:id="@+id/layout_meal_logs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        android:paddingTop="8dp"/>

</LinearLayout>