<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp"
    android:paddingVertical="12dp">

    <FrameLayout
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/round_lay"
        android:backgroundTint="?colorSurfaceContainer">

        <ImageView
            android:id="@+id/icon_section_profile"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            app:tint="?attr/colorOnSurfaceVariant"
            tools:src="@drawable/settings_ic" />
    </FrameLayout>

    <TextView
        android:id="@+id/text_section_title_profile"
        style="@style/Text1_16"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textColor="?attr/colorOnSurface"
        tools:text="Sozlamalar" />

    <ImageView
        android:id="@+id/icon_chevron_right_profile"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/arrow_right"
        app:tint="?attr/colorOnSurfaceVariant" />
</LinearLayout>