<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurfaceContainer">

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefreshNatija"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="100dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- 1. Hero Main Progress Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardMainProgress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardBackgroundColor="?attr/colorSurfaceContainerLowest"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="0dp"
                    app:strokeColor="?attr/colorOutlineVariant"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <!-- Row 1: Hozirgi vazn -->
                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:paddingVertical="8dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_alignParentStart="true"
                                    android:layout_centerVertical="true"
                                    android:fontFamily="@font/roboto_medium"
                                    android:text="Hozirgi"
                                    android:textColor="?attr/colorOnSurface"
                                    android:textSize="15sp" />

                                <TextView
                                    android:id="@+id/tvCurrentWeight"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_alignParentEnd="true"
                                    android:layout_centerVertical="true"
                                    android:fontFamily="@font/roboto_bold"
                                    android:textColor="?attr/colorOnSurface"
                                    android:textSize="16sp"
                                    tools:text="71.5 kg" />
                            </RelativeLayout>

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:layout_marginVertical="8dp"
                                android:background="?attr/colorOutlineVariant" />

                            <!-- Row 2: Maqsad -->
                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:paddingVertical="8dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_alignParentStart="true"
                                    android:layout_centerVertical="true"
                                    android:fontFamily="@font/roboto_medium"
                                    android:text="Maqsad"
                                    android:textColor="?attr/colorOnSurface"
                                    android:textSize="15sp"/>

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_alignParentEnd="true"
                                    android:layout_centerVertical="true"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal">

                                    <ImageView
                                        android:id="@+id/btnEditGoalWeight"
                                        android:layout_width="22dp"
                                        android:layout_height="22dp"
                                        android:layout_marginStart="8dp"
                                        android:background="?attr/selectableItemBackgroundBorderless"
                                        android:clickable="true"
                                        android:focusable="true"
                                        android:layout_marginEnd="@dimen/dimen_12"
                                        android:padding="2dp"
                                        app:srcCompat="@drawable/edit"
                                        app:tint="?attr/colorOnSurface" />

                                    <TextView
                                        android:id="@+id/tvGoalWeight"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:fontFamily="@font/roboto_bold"
                                        android:textColor="?attr/colorOnSurface"
                                        android:textSize="16sp"
                                        tools:text="65 kg" />

                                </LinearLayout>
                            </RelativeLayout>

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:layout_marginVertical="8dp"
                                android:background="?attr/colorOutlineVariant" />

                            <!-- Row 3: Boshlang'ich -->
                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:paddingVertical="8dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_alignParentStart="true"
                                    android:layout_centerVertical="true"
                                    android:fontFamily="@font/roboto_medium"
                                    android:text="Boshlang'ich"
                                    android:textColor="?attr/colorOnSurface"
                                    android:textSize="15sp" />

                                <TextView
                                    android:id="@+id/tvStartWeight"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_alignParentEnd="true"
                                    android:layout_centerVertical="true"
                                    android:fontFamily="@font/roboto_bold"
                                    android:textColor="?attr/colorOnSurface"
                                    android:textSize="16sp"
                                    tools:text="77.5 kg" />
                            </RelativeLayout>

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:layout_marginVertical="8dp"
                                android:background="?attr/colorOutlineVariant" />

                            <!-- Row 4: Natija -->
                            <RelativeLayout
                                android:id="@+id/layoutWeightDiff"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:paddingVertical="8dp">

                                <TextView
                                    android:id="@+id/tvTotalChangeLabel"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_alignParentStart="true"
                                    android:layout_centerVertical="true"
                                    android:fontFamily="@font/roboto_medium"
                                    android:text="Natija"
                                    android:textColor="?attr/colorOnSurface"
                                    android:textSize="15sp" />

                                <TextView
                                    android:id="@+id/tvWeightDiff"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_alignParentEnd="true"
                                    android:layout_centerVertical="true"
                                    android:fontFamily="@font/roboto_bold"
                                    android:textColor="?attr/colorOnSurface"
                                    android:textSize="16sp"
                                    tools:text="8.5 kg ozildi" />
                            </RelativeLayout>

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:layout_marginVertical="12dp"
                                android:background="?attr/colorOutlineVariant" />

                            <!-- Prediction summary text with info icon -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <TextView
                                    android:id="@+id/tvPredictionSummary"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:fontFamily="@font/roboto_regular"
                                    android:lineSpacingExtra="4dp"
                                    android:textColor="?attr/colorOnSurface"
                                    android:textSize="16sp"
                                    tools:text="Tog'ri ovqatlansangiz har hafta 0.5 kg ozasiz, oyiga 1.5 kg ozasiz, 3 oy 26 kunda maqsadingizga erishasiz." />

                                <ImageView
                                    android:id="@+id/btnPredictionInfo"
                                    android:layout_width="22dp"
                                    android:layout_height="22dp"
                                    android:layout_marginStart="8dp"
                                    android:layout_gravity="top|end"
                                    android:background="?attr/selectableItemBackgroundBorderless"
                                    android:clickable="true"
                                    android:focusable="true"
                                    app:srcCompat="@drawable/info_ic"
                                    app:tint="?attr/colorOnSurfaceVariant" />
                            </LinearLayout>
                        </LinearLayout>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 2. Add Weight CTA Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardAddWeight"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardBackgroundColor="?attr/colorSurfaceContainerLowest"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="0dp"
                    app:strokeColor="?attr/colorOutlineVariant"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/roboto_bold"
                                android:text="Yangi vazn kiritish"
                                android:textColor="?attr/colorOnSurface"
                                android:textSize="15sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Har hafta vaznignizni o'lchab boring"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                android:textSize="14sp" />
                        </LinearLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnAddWeight"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:text="Kiritish"
                            app:icon="@drawable/add_ic"
                            android:textColor="?attr/colorOnPrimary" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>



                <!-- 4. Photos & History Section Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardPhotos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardBackgroundColor="?attr/colorSurfaceContainerLowest"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="0dp"
                    app:strokeColor="?attr/colorOutlineVariant"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp">

                            <TextView
                                android:id="@+id/tvPhotosTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_centerVertical="true"
                                android:fontFamily="@font/roboto_bold"
                                android:text="Fotolarim"
                                android:textColor="?attr/colorOnSurface"
                                android:textSize="18sp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnWeightHistory"
                                style="@style/Widget.Material3.Button.TextButton"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true"
                                android:text="Vazn tarixi"
                                android:textColor="?attr/colorPrimary"
                                android:textSize="13sp"
                                app:icon="@drawable/history_24px"
                                app:iconSize="18dp"
                                app:iconPadding="4dp" />
                        </RelativeLayout>

                        <LinearLayout
                            android:id="@+id/layoutPhotosContent"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:baselineAligned="false"
                                android:gravity="center"
                                android:orientation="horizontal">

                                <!-- Before Photo -->
                                <LinearLayout
                                    android:id="@+id/layoutPhotoBefore"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginEnd="8dp"
                                    android:layout_weight="1"
                                    android:gravity="center_horizontal"
                                    android:orientation="vertical">

                                    <com.google.android.material.imageview.ShapeableImageView
                                        android:id="@+id/imgPhotoBefore"
                                        android:layout_width="match_parent"
                                        android:layout_height="160dp"
                                        android:background="?attr/colorSurfaceContainerHigh"
                                        android:scaleType="centerCrop"
                                        app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Medium" />

                                    <TextView
                                        android:id="@+id/tvPhotoBeforeLabel"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_gravity="center_horizontal"
                                        android:layout_marginTop="8dp"
                                        android:background="@drawable/round_lay"
                                        android:fontFamily="@font/roboto_medium"
                                        android:paddingHorizontal="10dp"
                                        android:paddingVertical="2dp"
                                        android:text="Oldin"
                                        android:textColor="?attr/colorOnSurface"
                                        android:textSize="12sp" />
                                </LinearLayout>

                                <!-- After Photo -->
                                <LinearLayout
                                    android:id="@+id/layoutPhotoAfter"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="8dp"
                                    android:layout_weight="1"
                                    android:gravity="center_horizontal"
                                    android:orientation="vertical">

                                    <com.google.android.material.imageview.ShapeableImageView
                                        android:id="@+id/imgPhotoAfter"
                                        android:layout_width="match_parent"
                                        android:layout_height="160dp"
                                        android:background="?attr/colorSurfaceContainerHigh"
                                        android:scaleType="centerCrop"
                                        app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Medium" />

                                    <TextView
                                        android:id="@+id/tvPhotoAfterLabel"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_gravity="center_horizontal"
                                        android:layout_marginTop="8dp"
                                        android:background="@drawable/round_lay"
                                        android:fontFamily="@font/roboto_medium"
                                        android:paddingHorizontal="10dp"
                                        android:paddingVertical="2dp"
                                        android:text="Hozir"
                                        android:textColor="?attr/colorOnSurface"
                                        android:textSize="12sp" />
                                </LinearLayout>

                                <!-- Spacer to balance when only one photo is visible -->
                                <Space
                                    android:id="@+id/spacerPhotoBalance"
                                    android:layout_width="0dp"
                                    android:layout_height="1dp"
                                    android:layout_weight="1"
                                    android:visibility="gone" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 5. Consolidated Analytics Card (BMI, Gradient, Legend) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardBmi"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardBackgroundColor="?attr/colorSurfaceContainerLowest"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="0dp"
                    app:strokeColor="?attr/colorOutlineVariant"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/roboto_bold"
                            android:text="Sizning BMI"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="18sp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvBmiValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/roboto_bold"
                                android:textColor="?attr/colorOnSurface"
                                android:textSize="36sp"
                                tools:text="19.13" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:text="Vazningiz"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                android:textSize="14sp" />

                            <TextView
                                android:id="@+id/tvBmiStatus"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:background="@drawable/round_lay"
                                android:backgroundTint="?attr/colorPrimary"
                                android:fontFamily="@font/roboto_medium"
                                android:paddingHorizontal="12dp"
                                android:paddingVertical="4dp"
                                android:textColor="?attr/colorOnPrimary"
                                android:textSize="13sp"
                                tools:text="Sog'lom" />

                            <Space
                                android:layout_width="0dp"
                                android:layout_height="0dp"
                                android:layout_weight="1" />

                            <ImageView
                                android:id="@+id/btnBmiInfo"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:background="?attr/selectableItemBackgroundBorderless"
                                android:clickable="true"
                                android:focusable="true"
                                app:srcCompat="@drawable/info_ic"
                                app:tint="?attr/colorOnSurfaceVariant" />

                        </LinearLayout>

                        <!-- Gradient Scale -->
                        <FrameLayout
                            android:id="@+id/layoutBmiScale"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="24dp">

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="12dp"
                                android:layout_gravity="center_vertical"
                                android:background="@drawable/bg_bmi_gradient" />

                            <!-- Marker (Vertical Line) -->
                            <View
                                android:id="@+id/viewBmiMarker"
                                android:layout_width="4dp"
                                android:layout_height="24dp"
                                android:layout_gravity="center_vertical|start"
                                android:background="?attr/colorOnSurface"
                                tools:layout_marginStart="100dp" />

                        </FrameLayout>

                        <!-- Legend -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="8dp"
                                android:layout_height="8dp"
                                app:srcCompat="@drawable/circle_shape"
                                app:tint="#2196F3" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:text="Kam vazn"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                android:textSize="12sp" />

                            <Space
                                android:layout_width="12dp"
                                android:layout_height="0dp" />

                            <ImageView
                                android:layout_width="8dp"
                                android:layout_height="8dp"
                                app:srcCompat="@drawable/circle_shape"
                                app:tint="#4CAF50" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:text="Sog'lom"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                android:textSize="12sp" />

                            <Space
                                android:layout_width="12dp"
                                android:layout_height="0dp" />

                            <ImageView
                                android:layout_width="8dp"
                                android:layout_height="8dp"
                                app:srcCompat="@drawable/circle_shape"
                                app:tint="#FFC107" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:text="Ortiqcha"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                android:textSize="12sp" />

                            <Space
                                android:layout_width="12dp"
                                android:layout_height="0dp" />

                            <ImageView
                                android:layout_width="8dp"
                                android:layout_height="8dp"
                                app:srcCompat="@drawable/circle_shape"
                                app:tint="#F44336" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:text="Semizlik"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                android:textSize="12sp" />

                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
