<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurfaceContainerLowest">

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefreshNatija"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="32dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- 1. VAZN MAQSADI CARD (No graph, uniform card structure) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardMainProgress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardBackgroundColor="?attr/colorSurfaceContainerLowest"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    app:strokeColor="?attr/colorOutlineVariant"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/tvTotalChangeLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/roboto_medium"
                            android:text="Vazn"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tvWeightDiff"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:fontFamily="@font/roboto_bold"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="18sp"
                            tools:text="-6.0 kg ozildi" />

                        <!-- 3 Metric Numbers Row -->
                        <LinearLayout
                            android:id="@+id/layoutMetricsRow"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:baselineAligned="false"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <!-- Boshlang'ich -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="start"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/roboto_medium"
                                    android:text="Boshlang'ich"
                                    android:textColor="?attr/colorOnSurfaceVariant"
                                    android:textSize="14sp" />

                                <TextView
                                    android:id="@+id/tvStartWeight"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:fontFamily="@font/roboto_bold"
                                    android:textColor="?attr/colorOnSurface"
                                    android:textSize="16sp"
                                    tools:text="77.5 kg" />
                            </LinearLayout>

                            <!-- Hozirgi -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/roboto_medium"
                                    android:text="Hozirgi"
                                    android:textColor="?attr/colorPrimary"
                                    android:textSize="14sp" />

                                <TextView
                                    android:id="@+id/tvCurrentWeight"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:fontFamily="@font/roboto_bold"
                                    android:textColor="?attr/colorPrimary"
                                    android:textSize="16sp"
                                    tools:text="71.5 kg" />
                            </LinearLayout>

                            <!-- Maqsad -->
                            <LinearLayout
                                android:id="@+id/layoutGoalWeight"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:background="?attr/selectableItemBackground"
                                android:clickable="true"
                                android:focusable="true"
                                android:gravity="end"
                                android:orientation="vertical"
                                android:padding="2dp">

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:fontFamily="@font/roboto_medium"
                                        android:text="Maqsad"
                                        android:textColor="?attr/colorOnSurfaceVariant"
                                        android:textSize="14sp" />

                                    <ImageView
                                        android:id="@+id/btnEditGoalWeight"
                                        android:layout_width="16dp"
                                        android:layout_height="16dp"
                                        android:layout_marginStart="4dp"
                                        android:background="?attr/selectableItemBackgroundBorderless"
                                        app:srcCompat="@drawable/edit"
                                        app:tint="?attr/colorPrimary" />
                                </LinearLayout>

                                <TextView
                                    android:id="@+id/tvGoalWeight"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:fontFamily="@font/roboto_bold"
                                    android:textColor="?attr/colorOnSurface"
                                    android:textSize="16sp"
                                    tools:text="65.0 kg" />
                            </LinearLayout>

                        </LinearLayout>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 2. YANGI VAZN KIRITISH CTA CARD (Tepadagi carddan bitta pastda) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardAddWeight"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardBackgroundColor="?attr/colorSurfaceContainerLowest"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    app:strokeColor="?attr/colorOutlineVariant"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/roboto_bold"
                                android:text="Yangi vazn kiritish"
                                android:textColor="?attr/colorOnSurface"
                                android:textSize="15sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:fontFamily="@font/roboto_regular"
                                android:text="Har hafta vazningizni o'lchab boring"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                android:textSize="13sp" />
                        </LinearLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnAddWeight"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:text="Kiritish"
                            android:textColor="?attr/colorOnPrimary"
                            app:icon="@drawable/add_ic" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 3. TAXMIN CARD -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/layoutPredictionCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardBackgroundColor="?attr/colorSurfaceContainerLowest"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    app:strokeColor="?attr/colorOutlineVariant"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/roboto_medium"
                            android:text="Maqsadga erishasiz"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textSize="15sp" />

                        <TextView
                            android:id="@+id/tvPredictionHighlight"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:fontFamily="@font/roboto_bold"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="18sp"
                            tools:text="2 oy 5 kun" />

                        <TextView
                            android:id="@+id/tvPredictionSummary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:fontFamily="@font/roboto_regular"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="15sp"
                            tools:text="To'g'ri ovqatlansangiz har hafta 0.5 kg ozasiz." />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardPhotos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardBackgroundColor="?attr/colorSurfaceContainerLowest"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    app:strokeColor="?attr/colorOutlineVariant"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp">

                            <TextView
                                android:id="@+id/tvPhotosTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_centerVertical="true"
                                android:fontFamily="@font/roboto_medium"
                                android:text="Fotolarim"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                android:textSize="15sp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnWeightHistory"
                                style="@style/Widget.Material3.Button.TextButton"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true"
                                android:text="Vazn tarixi"
                                android:textColor="?attr/colorPrimary"
                                android:textSize="13sp"
                                app:icon="@drawable/history_24px"
                                app:iconPadding="4dp"
                                app:iconSize="18dp" />
                        </RelativeLayout>

                        <LinearLayout
                            android:id="@+id/layoutPhotosContent"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:baselineAligned="false"
                                android:gravity="center"
                                android:orientation="horizontal">

                                <!-- Before Photo -->
                                <LinearLayout
                                    android:id="@+id/layoutPhotoBefore"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginEnd="8dp"
                                    android:layout_weight="1"
                                    android:gravity="center_horizontal"
                                    android:orientation="vertical">

                                    <com.google.android.material.imageview.ShapeableImageView
                                        android:id="@+id/imgPhotoBefore"
                                        android:layout_width="match_parent"
                                        android:layout_height="150dp"
                                        android:background="?attr/colorSurfaceContainerHigh"
                                        android:scaleType="centerCrop"
                                        app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Medium" />

                                    <TextView
                                        android:id="@+id/tvPhotoBeforeLabel"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_gravity="center_horizontal"
                                        android:layout_marginTop="8dp"
                                        android:background="@drawable/round_lay"
                                        android:fontFamily="@font/roboto_medium"
                                        android:paddingHorizontal="10dp"
                                        android:paddingVertical="2dp"
                                        android:text="Oldin"
                                        android:textColor="?attr/colorOnSurface"
                                        android:textSize="12sp" />
                                </LinearLayout>

                                <!-- After Photo -->
                                <LinearLayout
                                    android:id="@+id/layoutPhotoAfter"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="8dp"
                                    android:layout_weight="1"
                                    android:gravity="center_horizontal"
                                    android:orientation="vertical">

                                    <com.google.android.material.imageview.ShapeableImageView
                                        android:id="@+id/imgPhotoAfter"
                                        android:layout_width="match_parent"
                                        android:layout_height="150dp"
                                        android:background="?attr/colorSurfaceContainerHigh"
                                        android:scaleType="centerCrop"
                                        app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Medium" />

                                    <TextView
                                        android:id="@+id/tvPhotoAfterLabel"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_gravity="center_horizontal"
                                        android:layout_marginTop="8dp"
                                        android:background="@drawable/round_lay"
                                        android:fontFamily="@font/roboto_medium"
                                        android:paddingHorizontal="10dp"
                                        android:paddingVertical="2dp"
                                        android:text="Hozir"
                                        android:textColor="?attr/colorOnSurface"
                                        android:textSize="12sp" />
                                </LinearLayout>

                                <Space
                                    android:id="@+id/spacerPhotoBalance"
                                    android:layout_width="0dp"
                                    android:layout_height="1dp"
                                    android:layout_weight="1"
                                    android:visibility="gone" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <!-- 4. IDEAL VAZN CARD (Eng pasida) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardIdealWeight"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardBackgroundColor="?attr/colorSurfaceContainerLowest"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    app:strokeColor="?attr/colorOutlineVariant"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/roboto_medium"
                            android:text="Sizga mos ideal vazn"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textSize="15sp" />

                        <TextView
                            android:id="@+id/tvIdealWeightRange"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:fontFamily="@font/roboto_bold"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="18sp"
                            tools:text="58 - 72 kg" />

                        <TextView
                            android:id="@+id/tvIdealWeightSubtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:fontFamily="@font/roboto_regular"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="15sp"
                            tools:text="Bo'yingiz uchun eng maqbul va sog'lom vazn oralig me'yori." />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 5. PHOTOS SECTION CARD -->

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
