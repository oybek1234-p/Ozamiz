<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/dimen_12"
    android:layout_marginTop="@dimen/dimen_8"
    app:cardBackgroundColor="?colorSurface"
    app:cardElevation="@dimen/dimen_2"
    app:contentPadding="@dimen/dimen_12">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/day_count"
                style="@style/Title3_17"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start|center_vertical"
                android:textColor="?colorOnSurface"
                tools:text="2-kun" />

            <TextView
                android:id="@+id/premium_view"
                style="@style/TextLabelMedium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end|center_vertical"
                android:background="@drawable/chip_background_calories"
                android:drawablePadding="4dp"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:text="Premium"
                android:textColor="?colorOnErrorContainer"
                android:visibility="gone"
                app:drawableStartCompat="@drawable/star_ic"
                app:drawableTint="?colorOnErrorContainer"
                tools:visibility="visible" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/foods_con"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/breakfast_text"
                style="@style/Text1_16"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_8"
                android:textColor="?colorOnSurface"
                tools:text="Nonushta: Grechka + qatiq + bodring (300 kkal)" />

            <TextView
                android:id="@+id/lunch_text"
                style="@style/Text1_16"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_8"
                android:textColor="?colorOnSurface"
                tools:text="Tushlik: Tovuq sho'rva + bodring (450 kkal)" />

            <TextView
                android:id="@+id/dinnerText"
                style="@style/Text1_16"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_8"
                android:textColor="?colorOnSurface"
                tools:text="Kechki ovqat: Qatiq (200ml) + bodring (150 kkal)" />
        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>