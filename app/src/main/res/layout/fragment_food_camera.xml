<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:keepScreenOn="true"
    android:orientation="vertical">

    <!-- Top Camera View Area -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.camera.view.PreviewView
            android:id="@+id/viewFinder"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <uz.oybek.ozamiz.ui.feature.log.food.CameraOverlayView
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Top Header Bar -->
        <LinearLayout
            android:id="@+id/header_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <ImageButton
                android:id="@+id/button_back"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_circle_dark_translucent"
                android:contentDescription="@string/cancel"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/arrow_back"
                app:tint="@android:color/white" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingHorizontal="4dp">

                <TextView
                    android:id="@+id/text_instruction"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/roboto_bold"
                    android:gravity="center"
                    android:shadowColor="#80000000"
                    android:shadowDx="2"
                    android:shadowDy="2"
                    android:shadowRadius="4"
                    android:text="@string/log_food_camera_instruction"
                    android:textColor="@android:color/white"
                    android:textSize="17sp" />

                <TextView
                    android:id="@+id/tv_limit_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:background="@drawable/bg_camera_limit_badge"
                    android:fontFamily="@font/roboto_medium"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="2dp"
                    android:text="3/3 ta limit qoldi"
                    android:textColor="#E0E0E0"
                    android:textSize="12sp" />

            </LinearLayout>

            <ImageButton
                android:id="@+id/button_flash"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_circle_dark_translucent"
                android:contentDescription="Flash"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_flash_off"
                app:tint="@android:color/white" />

        </LinearLayout>

    </FrameLayout>

    <!-- Bottom Solid Black Control Bar -->
    <LinearLayout
        android:id="@+id/bottom_control_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/black"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="14dp"
        android:paddingBottom="36dp">

        <!-- Variant Options List (Scrollable horizontal buttons row) -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="22dp"
            android:clipToPadding="false"
            android:paddingHorizontal="16dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

                <!-- 1. Yozish -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_write"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="46dp"
                    android:layout_marginEnd="10dp"
                    android:backgroundTint="#242424"
                    android:fontFamily="@font/roboto_bold"
                    android:paddingHorizontal="16dp"
                    android:text="@string/log_food_text_title"
                    android:textColor="@android:color/white"
                    android:textSize="14sp"
                    app:cornerRadius="23dp"
                    app:icon="@drawable/edit"
                    app:iconGravity="textStart"
                    app:iconPadding="8dp"
                    app:iconSize="18dp"
                    app:iconTint="@android:color/white"
                    app:strokeColor="#40FFFFFF"
                    app:strokeWidth="1dp" />

                <!-- 2. Qidirish / Ro'yxat -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_list"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="46dp"
                    android:layout_marginEnd="10dp"
                    android:backgroundTint="#242424"
                    android:fontFamily="@font/roboto_bold"
                    android:paddingHorizontal="16dp"
                    android:text="@string/log_food_camera_list"
                    android:textColor="@android:color/white"
                    android:textSize="14sp"
                    app:cornerRadius="23dp"
                    app:icon="@drawable/ic_search"
                    app:iconGravity="textStart"
                    app:iconPadding="8dp"
                    app:iconSize="18dp"
                    app:iconTint="@android:color/white"
                    app:strokeColor="#40FFFFFF"
                    app:strokeWidth="1dp" />

                <!-- 3. Saqlanganlar -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_saved"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="46dp"
                    android:backgroundTint="#242424"
                    android:fontFamily="@font/roboto_bold"
                    android:paddingHorizontal="16dp"
                    android:text="Saqlanganlar"
                    android:textColor="@android:color/white"
                    android:textSize="14sp"
                    app:cornerRadius="23dp"
                    app:icon="@drawable/ic_bookmark_filled"
                    app:iconGravity="textStart"
                    app:iconPadding="8dp"
                    app:iconSize="18dp"
                    app:iconTint="@android:color/white"
                    app:strokeColor="#40FFFFFF"
                    app:strokeWidth="1dp" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Record Button (Oppoq) -->
        <ImageButton
            android:id="@+id/button_capture"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:background="@drawable/bg_camera_shutter"
            android:contentDescription="@string/log_food_camera_title" />

    </LinearLayout>

</LinearLayout>
