<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?colorSurfaceContainer"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    tools:context=".ui.feature.profile.ProfileFragment">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="32dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp">

            <!-- HEADER: Avatar + Ism + Level -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="20dp"
                app:cardBackgroundColor="?attr/colorSurface"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <FrameLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/imageView_user_avatar"
                            android:layout_width="100dp"
                            android:layout_height="100dp"
                            android:scaleType="centerCrop"
                            android:padding="4dp"
                            app:strokeWidth="2dp"
                            app:strokeColor="?attr/colorPrimary"
                            app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
                            tools:src="@drawable/user_photo_placeholder" />

                    </FrameLayout>

                    <TextView
                        android:id="@+id/textView_user_name"
                        style="@style/TextAppearance.Material3.TitleLarge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:fontFamily="@font/roboto_bold"
                        android:textColor="?colorOnSurface"
                        tools:text="Ali Valiyev" />

                    <!-- Level Badge -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/card_user_level"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="1dp"
                        app:strokeColor="?attr/colorOutlineVariant"
                        app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?selectableItemBackground">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="6dp">

                            <TextView
                                android:id="@+id/text_profile_level_emoji"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="16sp"
                                tools:text="🔥" />

                            <TextView
                                android:id="@+id/text_profile_level_name"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:fontFamily="@font/roboto_medium"
                                android:textColor="?attr/colorPrimary"
                                android:textSize="14sp"
                                tools:text="Iroda" />

                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Premium Status (agar kerak bo'lsa) -->
            <LinearLayout
                android:id="@+id/premium_active_c"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingBottom="16dp"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:id="@+id/premiumExpireDate"
                    style="@style/TextAppearance.Material3.LabelLarge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="?colorPrimary"
                    tools:text="Premium 25.02.2026 gacha" />

            </LinearLayout>

            <!-- Premium Banner (hidden by default) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/premium_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:visibility="gone"
                app:cardBackgroundColor="?colorPrimaryContainer"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/star_ic"
                            app:tint="?colorOnPrimaryContainer" />

                        <TextView
                            style="@style/TextAppearance.Material3.TitleMedium"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:text="Premium a'zolik"
                            android:fontFamily="@font/roboto_bold"
                            android:textColor="?colorOnPrimaryContainer" />

                    </LinearLayout>

                    <TextView
                        style="@style/TextAppearance.Material3.BodyMedium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:alpha="0.8"
                        android:text="Barcha imkoniyatlardan cheklovsiz foydalaning:"
                        android:textColor="?colorOnPrimaryContainer" />

                    <!-- Benefits List -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="vertical">

                        <TextView
                            style="@style/TextAppearance.Material3.BodyMedium"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:drawablePadding="12dp"
                            android:text="Cheklovsiz AI Tahlil"
                            android:textColor="?colorOnPrimaryContainer"
                            app:drawableStartCompat="@drawable/check_ic"
                            app:drawableTint="?colorOnPrimaryContainer" />

                        <TextView
                            style="@style/TextAppearance.Material3.BodyMedium"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:drawablePadding="12dp"
                            android:text="Shaxsiy AI Dietolog"
                            android:textColor="?colorOnPrimaryContainer"
                            app:drawableStartCompat="@drawable/check_ic"
                            app:drawableTint="?colorOnPrimaryContainer" />

                        <TextView
                            style="@style/TextAppearance.Material3.BodyMedium"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:drawablePadding="12dp"
                            android:text="Reklamasiz"
                            android:textColor="?colorOnPrimaryContainer"
                            app:drawableStartCompat="@drawable/check_ic"
                            app:drawableTint="?colorOnPrimaryContainer" />

                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/premium_button"
                        style="@style/Widget.Material3.Button"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:backgroundTint="?colorOnPrimaryContainer"
                        android:text="Faollashtirish"
                        android:textColor="?colorPrimaryContainer"
                        app:cornerRadius="12dp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- MENU BO'LIMI 1: Asosiy -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="?attr/colorSurface"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <include
                        android:id="@+id/section_my_info"
                        layout="@layout/item_profile_section" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="52dp"
                        android:background="?colorSurfaceContainerHighest" />

                    <include
                        android:id="@+id/section_weight_history"
                        layout="@layout/item_profile_section" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- MENU BO'LIMI 2: Yordam -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="?attr/colorSurface"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <include
                        android:id="@+id/section_support"
                        layout="@layout/item_profile_section" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="52dp"
                        android:background="?colorSurfaceContainerHighest" />

                    <include
                        android:id="@+id/section_rate_app"
                        layout="@layout/item_profile_section" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- MENU BO'LIMI 3: Darsliklar -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/container_admin_lessons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:visibility="gone"
                app:cardBackgroundColor="?attr/colorSurface"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp"
                tools:visibility="visible">

                <include
                    android:id="@+id/section_admin_lessons"
                    layout="@layout/item_profile_section" />

            </com.google.android.material.card.MaterialCardView>

            <!-- Admin bo'limi (Hidden) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/section_admin_premium_users"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:visibility="gone"
                app:cardBackgroundColor="?attr/colorSurface"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <include
                        android:id="@+id/section_admin_premium_users_content"
                        layout="@layout/item_profile_section" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="52dp"
                        android:background="?colorSurfaceContainerHighest" />

                    <include
                        android:id="@+id/section_admin_all_users"
                        layout="@layout/item_profile_section" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Chiqish tugmasi -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_logout"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="32dp"
                android:text="@string/logout"
                android:textColor="?colorError"
                android:visibility="gone"
                tools:visibility="visible" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>