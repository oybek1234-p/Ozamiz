<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="?colorSurfaceContainer"
        android:paddingHorizontal="@dimen/dimen_24"
        android:paddingTop="@dimen/dimen_12"
        android:paddingBottom="@dimen/dimen_24">

        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="@dimen/dimen_12"
            android:background="?colorOutlineVariant"/>

        <TextView
            android:id="@+id/textView17"
            style="@style/Title4_24"
            android:fontFamily="@font/roboto_bold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/premium"
            android:layout_gravity="center_horizontal"
            android:drawablePadding="@dimen/dimen_12"
            android:textColor="?colorPrimary"
            app:drawableStartCompat="@drawable/star_ic"
            app:drawableTint="?colorPrimary" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="@dimen/dimen_18" >

            <TextView
                style="@style/Headline2_16"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawableStart="@drawable/check_ic"
                android:drawablePadding="8dp"
                android:text="Sun'iy intellekt bilan ovqat tahlili"
                android:layout_marginTop="@dimen/dimen_12"
                android:textSize="18sp"
                android:textColor="?colorOnSurface"
                app:drawableTint="@color/green" />

            <TextView
                style="@style/Text1_16"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawablePadding="8dp"
                android:text="Yegan ovqatingizni rasmga olib, AI yordamida kaloriya va ozuqaviy qiymatini bilib oling."
                android:textColor="?colorOnSurfaceVariant" />

            <TextView
                style="@style/Headline2_16"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawableStart="@drawable/check_ic"
                android:drawablePadding="8dp"
                android:text="@string/ovqatlar_bo_yicha_cheksiz_maslahatlar"
                android:layout_marginTop="@dimen/dimen_12"
                android:textSize="18sp"
                android:textColor="?colorOnSurface"
                app:drawableTint="@color/green" />

            <TextView
                style="@style/Text1_16"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawablePadding="8dp"
                android:text="Har kuni foydali maslahatlar, tavsiyalar va ogohlantirishlar."
                android:textColor="?colorOnSurfaceVariant" />


            <TextView
                style="@style/Headline3_15"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawablePadding="8dp"
                android:text="@string/reklama_yo_q"
                android:layout_marginTop="@dimen/dimen_12"
                android:textColor="?colorOnSurface"
                app:drawableStartCompat="@drawable/check_ic"
                app:drawableTint="@color/green" />


            <TextView
                android:id="@+id/price_view"
                style="@style/Title2_20"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="@dimen/dimen_24"
                android:textColor="?colorPrimary"
                tools:text="35000 so'm / oyiga" />


            <com.google.android.material.button.MaterialButton
                android:id="@+id/button"
                style="@style/Widget.Material3.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_24"
                android:text="@string/sotib_olish" />
        </LinearLayout>
    </LinearLayout>
</layout>