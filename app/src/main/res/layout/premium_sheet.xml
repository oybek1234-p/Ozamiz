<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="?colorSurfaceContainer"
        android:paddingHorizontal="@dimen/dimen_24"
        android:paddingTop="@dimen/dimen_12"
        android:paddingBottom="@dimen/dimen_24">


        <TextView
            android:id="@+id/textView17"
            style="@style/Title4_24"
            android:fontFamily="@font/roboto_bold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/premium"
            android:layout_gravity="center_horizontal"
            android:drawablePadding="@dimen/dimen_12"
            android:textColor="?colorPrimary"
            app:drawableStartCompat="@drawable/star_ic"
            app:drawableTint="?colorPrimary" />

        <LinearLayout
            android:id="@+id/layout_benefits"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible"
            android:layout_marginTop="@dimen/dimen_18" >

            <TextView
                style="@style/Headline2_16"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawableStart="@drawable/check_ic"
                android:drawablePadding="8dp"
                android:text="Cheklovsiz AI Tahlil"
                android:layout_marginTop="@dimen/dimen_12"
                android:textSize="18sp"
                android:textColor="?colorOnSurface"
                app:drawableTint="@color/green" />

            <TextView
                style="@style/Text1_16"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawablePadding="8dp"
                android:layout_marginTop="@dimen/dimen_8"
                android:text="Ovqatlarni rasmga oling va bir zumda kaloriya hamda makrolarni aniqlang."
                android:textColor="?colorOnSurfaceVariant" />

            <TextView
                style="@style/Headline2_16"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawableStart="@drawable/check_ic"
                android:drawablePadding="8dp"
                android:text="Shaxsiy AI Dietolog"
                android:layout_marginTop="@dimen/dimen_18"
                android:textSize="18sp"
                android:textColor="?colorOnSurface"
                app:drawableTint="@color/green" />

            <TextView
                style="@style/Text1_16"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawablePadding="8dp"
                android:layout_marginTop="@dimen/dimen_8"
                android:text="Sog'lom ovqatlanish, retseptlar va maslahatlar bo'yicha AI bilan cheklovsiz suhbat."
                android:textColor="?colorOnSurfaceVariant" />


            <TextView
                style="@style/Headline3_15"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawablePadding="8dp"
                android:drawableStart="@drawable/check_ic"
                android:text="@string/reklama_yo_q"
                android:layout_marginTop="@dimen/dimen_18"
                android:textSize="18sp"
                android:textColor="?colorOnSurface"
                app:drawableTint="@color/green" />


            <TextView
                android:id="@+id/price_view"
                style="@style/Title2_20"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="@dimen/dimen_24"
                android:textColor="?colorPrimary"
                tools:text="35000 so'm / oyiga" />


            <com.google.android.material.button.MaterialButton
                android:id="@+id/button"
                style="@style/Widget.Material3.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_24"
                android:text="@string/sotib_olish" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layout_verification_pending"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone"
            android:backgroundTint="?colorSurfaceContainerHigh"
            tools:visibility="visible"
            android:layout_marginTop="@dimen/dimen_24">

            <ImageView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:src="@drawable/admin_ic"
                app:tint="?colorPrimary"
                android:padding="16dp" />

            <TextView
                style="@style/Title2_20"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_24"
                android:text="To'lov Tekshirilmoqda"
                android:fontFamily="@font/roboto_bold"
                android:textColor="?colorOnSurface"
                android:textAlignment="center" />

            <TextView
                style="@style/Text1_16"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_12"
                android:text="Sizning to'lov chekingiz qabul qilindi. Operatorlarimiz uni 24 soat ichida tekshirib chiqadilar."
                android:textColor="?colorOnSurfaceVariant"
                android:textAlignment="center"
                android:lineSpacingMultiplier="1.2" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                app:cardBackgroundColor="?colorSecondaryContainer"
                app:cardCornerRadius="12dp"
                app:strokeWidth="0dp">


            </com.google.android.material.card.MaterialCardView>


            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_close"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_24"
                android:text="@string/tushunarli" />

        </LinearLayout>
    </LinearLayout>
</layout>