<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="?colorSurfaceContainer"
    android:paddingBottom="32dp">

    <!-- Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:background="@drawable/round_lay"
        android:backgroundTint="?colorOutlineVariant" />

    <!-- Header with icon -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/img_macro_icon"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@drawable/gosht_ic"
            app:shapeAppearance="@style/CircleImageView" />

        <TextView
            android:id="@+id/text_macro_title"
            style="@style/Title2_20"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/roboto_bold"
            android:text="Oqsil (Protein)"
            android:textColor="?colorOnSurface" />

        <TextView
            android:id="@+id/text_macro_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Muskullar uchun muhim"
            android:textColor="?colorOnSurfaceVariant"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Description -->
    <TextView
        android:id="@+id/text_macro_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:lineSpacingExtra="6dp"
        android:text="Oqsil — tananing asosiy qurilish materiali. U muskullarni tiklash, immunitet tizimini mustahkamlash va to'yimlilik hissini oshirishda muhim rol o'ynaydi."
        android:textColor="?colorOnSurface"
        android:textSize="15sp" />

    <!-- Foods Section Title -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:paddingHorizontal="20dp"
        android:fontFamily="@font/roboto_bold"
        android:text="🥗 Qaysi ovqatlarda ko'p?"
        android:textColor="?colorOnSurface"
        android:textSize="16sp" />

    <!-- Food Items Container -->
    <LinearLayout
        android:id="@+id/foods_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:layout_marginTop="12dp">


    </LinearLayout>

    <!-- Daily Recommendation -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="20dp"
        app:cardBackgroundColor="?colorPrimaryContainer"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/roboto_bold"
                android:text="💡 Kunlik tavsiya"
                android:textColor="?colorOnPrimaryContainer"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/text_daily_recommendation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="4dp"
                android:text="Vazningizning har 1 kg uchun 1.6-2.2 g oqsil iste'mol qiling. 70 kg odam uchun bu 112-154 g."
                android:textColor="?colorOnPrimaryContainer"
                android:textSize="14sp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Close Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_close"
        style="@style/FilledButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="20dp"
        android:text="Tushundim"
        app:cornerRadius="16dp" />
</LinearLayout>
