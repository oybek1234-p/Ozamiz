<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:background="?colorSurface"
    android:layout_height="match_parent">

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/button_next_study_page1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:clipToPadding="false"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <ImageView
                android:id="@+id/image_study_page1"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="16dp"
                android:scaleType="centerCrop"
                android:src="@drawable/calorie_photo"
                android:contentDescription="Kaloriya illustratsiyasi" />

            <TextView
                android:id="@+id/title_study_page1"
                style="@style/Title2_20"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:text="Kaloriya nima?"
                android:textColor="?colorOnSurface" />

            <TextView
                android:id="@+id/explanation_study_page1"
                style="@style/Headline2_16"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:lineSpacingMultiplier="1.3"
                android:text="Har bir ovqatda energiya bor. Ushbu energiya tanamiz tomonidan harakat qilish, nafas olish, o‘ylash, va yurak urishi uchun ishlatiladi.\nBu energiya kaloriya deb ataladi."
                android:textColor="?colorOnSurface" />

            <TextView
                android:id="@+id/key_idea_title_study_page1"
                style="@style/Title2_20"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="🔥 Qanday semiramiz ?"
                android:textColor="?colorOnSurface" />

            <TextView
                android:id="@+id/key_idea_content_study_page1"
                style="@style/Text1_16"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:lineSpacingMultiplier="1.3"
                android:textColor="?colorOnSurface"
                android:text="Kun davomida sizga kerakli miqdordan ko‘proq kaloriya tushsa — tanangiz uni yog‘ga aylantiradi, semirasiz\nKamroq tushsa — tanangiz zaxirani (yog‘ni) yoqadi, ya’ni ozasiz." />

            <TextView
                style="@style/Title2_20"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Semirishga misol:"
                android:textColor="?colorOnSurface" />

            <TextView
                style="@style/Text1_16"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:lineSpacingMultiplier="1.3"
                android:textColor="?colorOnSurface"
                android:text="Siz kuniga 1600 kaloriya sarflaysiz. Lekin siz 2000 kaloriya yesangiz. Ortiqcha 400 kal tanangizda yog‘ga aylanadi, va semirishga olib keladi" />

            <TextView
                style="@style/Title2_20"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Kaloriya qanday yo'qoladi:"
                android:textColor="?colorOnSurface" />

            <TextView
                style="@style/Text1_16"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:lineSpacingMultiplier="1.3"
                android:textColor="?colorOnSurface"
                android:text="Sog'lom ovqatlar yeyish, Yurish, yugurish, Uy ishlari, Sport, mashqlar orqali" />

            <TextView
                style="@style/Title2_20"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="🎯 Va eng muhimi:"
                android:textColor="?colorOnSurface" />

            <TextView
                style="@style/Text1_16"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:lineSpacingMultiplier="1.3"
                android:textColor="?colorOnSurface"
                android:text="• Parhez bu och qolish emas \n• Sizga kerakli miqdorda, to‘g‘ri ovqatlarni tanlab, mazali ovqatlanib ham ozish mumkin." />

            <TextView
                style="@style/Text1_16"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="?colorOnSurface"
                android:text="Misol:\n• 1 dona tuxum = 70 kaloriya\n• 1 stakan kola = 140 kaloriya \n• 1 bo‘lak tort = 300-400 kaloriya \n• 1 kosa osh = 500-600 kaloriya" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_next_study_page1"
        style="@style/Widget.Material3.Button"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:text="Keyingisi"
        app:icon="@drawable/arrow_right"
        app:iconGravity="textEnd"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>