<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="16dp"
    app:cardBackgroundColor="?attr/colorSurfaceContainerLowest"
    app:cardCornerRadius="24dp"
    app:cardElevation="8dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="?colorSurfaceContainerLowest"
        android:padding="20dp">

        <!-- Top Header Bar: Icon on Left + Title in Middle + Close Button on Right -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:importantForAccessibility="no"
                android:src="@drawable/new_logo" />

            <TextView
                android:id="@+id/title_step_1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:fontFamily="@font/roboto_bold"
                android:text="Ilovamiz sizga manzur bo'lyaptimi?"
                android:textColor="?attr/colorOnSurface"
                android:textSize="17sp" />

            <ImageView
                android:id="@+id/button_close"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:importantForAccessibility="no"
                android:padding="4dp"
                android:src="@drawable/ic_close_24"
                app:tint="?attr/colorOnSurfaceVariant" />
        </LinearLayout>

        <!-- STEP 1 Layout: Equal Side-by-Side Buttons -->
        <LinearLayout
            android:id="@+id/layout_step_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="vertical"
            android:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- Left Equal Button: Negative -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_negative"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:fontFamily="@font/roboto_bold"
                    android:text="👎 Yaxshi emas"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="14sp"
                    app:cornerRadius="16dp"
                    app:strokeColor="?attr/colorOutline"
                    app:strokeWidth="1dp" />

                <!-- Right Equal Button: Positive -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_positive"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:fontFamily="@font/roboto_bold"
                    android:text="👍 Yaxshi, yoqdi"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="14sp"
                    app:cornerRadius="16dp"
                    app:strokeColor="?attr/colorOutline"
                    app:strokeWidth="1dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- STEP 2A (Negative Feedback Input) Layout -->
        <LinearLayout
            android:id="@+id/layout_step_2_negative"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/roboto_bold"
                android:text="Fikringiz biz uchun muhim!"
                android:textColor="?attr/colorOnSurface"
                android:textSize="18sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="@font/roboto_regular"
                android:text="Iltimos, ilovaning qayerini to'g'rilashimiz kerakligi va qanday kamchiliklari borligini bizga ochiq yozing."
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="14sp" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/input_layout_feedback"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:boxCornerRadiusBottomEnd="14dp"
                app:boxCornerRadiusBottomStart="14dp"
                app:boxCornerRadiusTopEnd="14dp"
                app:boxCornerRadiusTopStart="14dp"
                app:hintEnabled="false">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edit_text_feedback"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/roboto_regular"
                    android:gravity="top|start"
                    android:hint="Taklif va e'tirozlaringizni yozing..."
                    android:inputType="textMultiLine"
                    android:minLines="3"
                    android:textColor="?attr/colorOnSurface"
                    android:textColorHint="?attr/colorOnSurfaceVariant"
                    android:textSize="14sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_submit_feedback"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/roboto_bold"
                android:text="Jo'natish"
                android:textSize="15sp"
                app:cornerRadius="16dp" />
        </LinearLayout>

        <!-- STEP 2B (Positive Feedback / Rate) Layout -->
        <LinearLayout
            android:id="@+id/layout_step_2_positive"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/roboto_bold"
                android:text="Rahmat! Biz bundan juda xursandmiz. 🎉"
                android:textColor="?attr/colorOnSurface"
                android:textSize="18sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="@font/roboto_regular"
                android:text="Ilovamiz rivojlanishi uchun Google Play'da bizga 5 yulduz qo'yib, qo'llab-quvvatlang!"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="14sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_rate_app"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/roboto_bold"
                android:text="⭐️⭐️⭐️⭐️⭐️ Baho berish"
                android:textSize="15sp"
                app:cornerRadius="16dp" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
