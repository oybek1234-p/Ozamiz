<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="24dp"
    android:background="@drawable/bg_dialog_rounded"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/tv_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="@font/roboto_medium"
        android:gravity="center"
        android:textColor="?colorOnSurface"
        android:textSize="20sp"
        android:text="Kunlik limit tugadi" />

    <TextView
        android:id="@+id/tv_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:textColor="?colorOnSurfaceVariant"
        android:textSize="14sp"
        android:text="Siz bugun 3 ta ovqat kiritdingiz. Ilovadan to'liq va cheksiz foydalanish uchun Premium obunachisi bo'ling!" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_positive"
        style="@style/Widget.Material3.Button"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="24dp"
        app:icon="@drawable/star_ic"
        android:fontFamily="@font/roboto_medium"
        android:text="Premium"
        app:iconGravity="textStart"
        android:textColor="?colorSurface"
        app:backgroundTint="?colorPrimary"
        app:cornerRadius="16dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_search_list"
        style="@style/OutlineButton"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="8dp"
        app:iconGravity="textStart"
        app:icon="@drawable/food_ic"
        android:fontFamily="@font/roboto_medium"
        android:text="Ovqatlar ro'yhati"
        android:textColor="?colorPrimary"
        app:cornerRadius="16dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_negative"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/roboto_medium"
        android:text="@string/delete_cancel"
        android:textColor="?colorOutline"
        app:cornerRadius="16dp" />

</LinearLayout>
