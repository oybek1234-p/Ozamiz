<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?colorSurface">

    <!-- Header -->
    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:padding="16dp"
        android:elevation="4dp"
        android:background="?colorSurfaceContainer"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/oval_back"
            android:backgroundTint="?colorSurfaceContainerHigh"
            android:src="@drawable/arrow_back"
            android:contentDescription="Back"
            android:padding="8dp"
            app:tint="?colorOnSurface"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Kategoriyalarni boshqarish"
            android:textSize="18sp"
            android:fontFamily="@font/roboto_bold"
            android:textColor="?colorOnSurface"
            android:layout_marginEnd="40dp"/>
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/headerLayout"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="80dp">

            <!-- Add New -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="?colorSurface">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="YANGI KATEGORIYA QO'SHISH"
                    android:textSize="12sp"
                    android:textColor="?colorOnSurfaceVariant"
                    android:fontFamily="@font/roboto_medium"
                    android:layout_marginBottom="8dp"/>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <EditText
                        android:id="@+id/editNewCategory"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/round_lay_stroke"
                        android:hint="Kategoriya nomini kiriting..."
                        android:paddingStart="16dp"
                        android:paddingEnd="50dp"
                        android:textSize="16sp"
                        android:inputType="textCapSentences"/>

                    <ImageButton
                        android:id="@+id/btnAdd"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_gravity="end|center_vertical"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/round_lay"
                        android:backgroundTint="?attr/colorPrimary"
                        android:src="@drawable/add_ic"
                        app:tint="?colorOnPrimary"
                        android:padding="8dp"/>
                </FrameLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="8dp">

                    <CheckBox
                        android:id="@+id/checkIsSecondary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ikkilamchi kategoriya (Oson, Oqsilga boy...)"
                        android:textSize="12sp"
                        android:textColor="?colorOnSurface"/>
                </LinearLayout>
            </LinearLayout>

            <!-- List Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="16dp"
                android:paddingBottom="8dp"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="MAVJUD KATEGORIYALAR"
                    android:textSize="14sp"
                    android:fontFamily="@font/roboto_bold"
                    android:textColor="?colorOnSurface"/>

                <TextView
                    android:id="@+id/textCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 TA"
                    android:textSize="10sp"
                    android:textColor="?attr/colorPrimary"
                    android:background="@drawable/round_lay"
                    android:backgroundTint="?attr/colorSecondaryContainer"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"/>
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerCategories"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Kategoriyani o'zgartirish uchun qalam belgisini, o'chirish uchun esa X belgisini bosing."
                android:gravity="center"
                android:padding="24dp"
                android:textSize="12sp"
                android:textColor="?colorOnSurfaceVariant"/>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
