<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet_top_rounded"
    android:backgroundTint="?attr/colorSurfaceContainer"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingTop="12dp"
    android:paddingBottom="28dp">

    <!-- Top Bar with Drag Handle and Food List Button -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp">

        <!-- Drag Handle in Center -->
        <View
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_gravity="center"
            android:alpha="0.25"
            android:background="@drawable/drag_handle" />

        <!-- Food List Text Button on Top Right (Light color) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_food_list"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_gravity="end|center_vertical"
            android:fontFamily="@font/roboto_medium"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:paddingHorizontal="8dp"
            android:paddingVertical="0dp"
            android:text="@string/premium_sheet_food_list"
            android:textAllCaps="false"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="13sp" />
    </FrameLayout>

    <TextView
        android:id="@+id/text_limit_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/roboto_bold"
        android:gravity="center"
        android:text="@string/ai_chat_limit_title"
        android:textColor="?attr/colorOnSurface"
        android:textSize="21sp" />

    <!-- Subtitle -->
    <TextView
        android:id="@+id/text_limit_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fontFamily="@font/roboto_regular"
        android:gravity="center"
        android:lineSpacingExtra="3dp"
        android:paddingHorizontal="4dp"
        android:text="@string/ai_chat_limit_hint"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="15sp" />

    <!-- Action Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_ok"
        style="@style/Widget.Material3.Button"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="24dp"
        android:fontFamily="@font/roboto_bold"
        android:text="@string/tushunarli"
        android:textAllCaps="false"
        android:textColor="?attr/colorOnPrimary"
        android:textSize="15sp"
        app:backgroundTint="?attr/colorPrimary"
        app:cornerRadius="18dp" />

</LinearLayout>
