<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?colorSurfaceContainer">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?colorSurfaceContainer"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="?colorSurfaceContainer"
            app:navigationIcon="@drawable/arrow_back"
            app:title="Qanday ishlaydi?"
            app:titleCentered="true"
            app:titleTextAppearance="@style/Title2_20"
            app:titleTextColor="?attr/colorOnSurface" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="32dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="16dp">

            <!-- Hero Section -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="?colorSurfaceContainerLowest"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <ImageView
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:src="@drawable/fire_ic"
                        app:tint="?attr/colorPrimary" />

                    <TextView
                        style="@style/Title2_20"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:fontFamily="@font/roboto_bold"
                        android:text="Kaloriya sanash nima?"
                        android:textAlignment="center"
                        android:textColor="?attr/colorOnSurface" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:alpha="0.8"
                        android:text="Vazn yo'qotish va sog'lom hayotning asosi"
                        android:textAlignment="center"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="14sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Section 1: Kaloriya nima? -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="?colorSurfaceContainerLowest"
                app:cardCornerRadius="20dp"
                app:cardElevation="1dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:background="@drawable/round_lay"
                            android:backgroundTint="@color/orange_alpha_10"
                            android:padding="10dp"
                            android:src="@drawable/fire_ic"
                            app:tint="@color/orange" />

                        <TextView
                            style="@style/Headline2_16"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:fontFamily="@font/roboto_bold"
                            android:text="Kaloriya nima?"
                            android:textColor="?attr/colorOnSurface" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:lineSpacingExtra="6dp"
                        android:text="Kaloriya — bu energiya o'lchov birligi. Tana har kuni yurish, nafas olish, fikrlash va boshqa barcha faoliyatlar uchun energiya sarflaydi.\n\nOvqatdan oladigan energiyangiz kaloriya sifatida hisoblanadi. Agar siz sarflaganingizdan ko'proq kaloriya iste'mol qilsangiz — vazn ortadi. Kamroq iste'mol qilsangiz — vazn kamayadi."
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="16sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Section 2: Qanday ozish mumkin? -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="?colorSurfaceContainerLowest"
                app:cardCornerRadius="20dp"
                app:cardElevation="1dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:background="@drawable/round_lay"
                            android:backgroundTint="@color/green_alpha_10"
                            android:padding="10dp"
                            android:src="@drawable/trending_down"
                            app:tint="@color/green" />

                        <TextView
                            style="@style/Headline2_16"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:fontFamily="@font/roboto_bold"
                            android:text="Qanday ozish mumkin?"
                            android:textColor="?attr/colorOnSurface" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:lineSpacingExtra="6dp"
                        android:text="Ozish uchun kaloriya defitsiti kerak. Bu degani, tana sarflaydigandan kamroq kaloriya yeyish kerak."
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="16sp" />

                    <!-- Deficit Info -->
                    <TextView
                        style="@style/Headline3_15"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:fontFamily="@font/roboto_bold"
                        android:text="📊 Masalan:"
                        android:textColor="?attr/colorOnSurface" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:lineSpacingExtra="8dp"
                        android:text="• Sizning tanangiz kuniga 2000 kaloriya sarflaydi\n• Siz 1500 kaloriya iste'mol qilasiz\n• Defitsit: 500 kaloriya\n• Natija: Haftasiga ~0.5 kg yo'qotasiz"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="15sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Section 3: Har kuni nima qilish kerak? -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="?colorSurfaceContainerLowest"
                app:cardCornerRadius="20dp"
                app:cardElevation="1dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:background="@drawable/round_lay"
                            android:backgroundTint="@color/yellow_alpha_10"
                            android:padding="10dp"
                            android:src="@drawable/check_ic"
                            app:tint="@color/yellow" />

                        <TextView
                            style="@style/Headline2_16"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:fontFamily="@font/roboto_bold"
                            android:text="Har kuni nima qilish kerak?"
                            android:textColor="?attr/colorOnSurface" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="vertical">

                        <!-- Step 1 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingVertical="8dp">

                            <TextView
                                style="@style/Headline2_16"
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:background="@drawable/round_lay"
                                android:backgroundTint="?attr/colorPrimary"
                                android:fontFamily="@font/roboto_bold"
                                android:gravity="center"
                                android:text="1"
                                android:textColor="?attr/colorOnPrimary" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:layout_weight="1"
                                android:text="Yegan ovqatlaringizni yozib boring"
                                android:textColor="?attr/colorOnSurface"
                                android:textSize="16sp" />
                        </LinearLayout>

                        <!-- Step 2 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingVertical="8dp">

                            <TextView
                                style="@style/Headline2_16"
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:background="@drawable/round_lay"
                                android:backgroundTint="?attr/colorPrimary"
                                android:fontFamily="@font/roboto_bold"
                                android:gravity="center"
                                android:text="2"
                                android:textColor="?attr/colorOnPrimary" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:layout_weight="1"
                                android:text="Kunlik kaloriya limitingizdan oshmang"
                                android:textColor="?attr/colorOnSurface"
                                android:textSize="16sp" />
                        </LinearLayout>

                        <!-- Step 3 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingVertical="8dp">

                            <TextView
                                style="@style/Headline2_16"
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:background="@drawable/round_lay"
                                android:backgroundTint="?attr/colorPrimary"
                                android:fontFamily="@font/roboto_bold"
                                android:gravity="center"
                                android:text="3"
                                android:textColor="?attr/colorOnPrimary" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:layout_weight="1"
                                android:text="Kuniga 2 litr suv iching"
                                android:textColor="?attr/colorOnSurface"
                                android:textSize="16sp" />
                        </LinearLayout>

                        <!-- Step 4 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingVertical="8dp">

                            <TextView
                                style="@style/Headline2_16"
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:background="@drawable/round_lay"
                                android:backgroundTint="?attr/colorPrimary"
                                android:fontFamily="@font/roboto_bold"
                                android:gravity="center"
                                android:text="4"
                                android:textColor="?attr/colorOnPrimary" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:layout_weight="1"
                                android:text="Harakatlarni kuzatib boring (yurish, yugurish)"
                                android:textColor="?attr/colorOnSurface"
                                android:textSize="16sp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Section 4: Makronutrientlar -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="?colorSurfaceContainerLowest"
                app:cardCornerRadius="20dp"
                app:cardElevation="1dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:background="@drawable/round_lay"
                            android:backgroundTint="?attr/colorPrimaryContainer"
                            android:padding="10dp"
                            android:src="@drawable/gosht_ic" />

                        <TextView
                            style="@style/Headline2_16"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:fontFamily="@font/roboto_bold"
                            android:text="Makronutrientlar"
                            android:textColor="?attr/colorOnSurface" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:lineSpacingExtra="6dp"
                        android:text="Faqat kaloriya emas, balkim nima yeyishingiz ham muhim:"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="16sp" />

                    <!-- Protein -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:src="@drawable/gosht_ic"
                            app:shapeAppearance="@style/CircleImageView" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/Headline3_15"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Oqsil (Protein)"
                                android:textColor="?attr/colorOnSurface" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Muskullarni saqlaydi va to'yimlilikni oshiradi"
                                android:textColor="?attr/colorOnSurface"
                                android:textSize="14sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Fat -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:src="@drawable/yongoq_ic"
                            app:shapeAppearance="@style/CircleImageView" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/Headline3_15"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Yog' (Fat)"
                                android:textColor="?attr/colorOnSurface" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Sog'lom yog'lar gormonlar uchun kerak"
                                android:textColor="?attr/colorOnSurface"
                                android:textSize="14sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Carbs -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:src="@drawable/non_ic"
                            app:shapeAppearance="@style/CircleImageView" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/Headline3_15"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Uglevodlar (Carbs)"
                                android:textColor="?attr/colorOnSurface" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Asosiy energiya manbai, lekin ortiqchasi yog'ga aylanadi"
                                android:textColor="?attr/colorOnSurface"
                                android:textSize="14sp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Tips Section -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="?colorSurfaceContainerLowest"
                app:cardCornerRadius="20dp"
                app:cardElevation="1dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:background="@drawable/round_lay"
                            android:backgroundTint="@color/green_alpha_10"
                            android:padding="10dp"
                            android:src="@drawable/star_ic"
                            app:tint="@color/green" />

                        <TextView
                            style="@style/Headline2_16"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:fontFamily="@font/roboto_bold"
                            android:text="Muhim maslahatlar"
                            android:textColor="?attr/colorOnSurface" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:lineSpacingExtra="8dp"
                        android:text="✅ Har kuni bir xil vaqtda ovqatlaning\n\n✅ Yeyotganingizni darhol yozib qo'ying\n\n✅ Suv ichishni unutmang — ochlik hissini kamaytiradi\n\n✅ Tez natija kutmang — haftasiga 0.5-1 kg optimal\n\n✅ Uyquni yetarlicha olish muhim — 7-8 soat\n\n✅ Stress kaloriya sarflashni qiyinlashtiradi"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="16sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Bottom CTA -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_got_it"
                style="@style/FilledButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="24dp"
                android:text="Tushundim"
                app:cornerRadius="16dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
