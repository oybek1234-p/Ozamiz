<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet_top_rounded"
    android:backgroundTint="?attr/colorSurfaceContainer"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingTop="12dp"
    android:paddingBottom="24dp">

    <!-- Drag Handle -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:alpha="0.3"
        android:background="@drawable/drag_handle" />

    <!-- Food Title & Calories Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/text_view_food_name_detail"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/roboto_bold"
            android:textColor="?attr/colorOnSurface"
            android:textSize="20sp"
            tools:text="Osh (Palov)" />

        <TextView
            android:id="@+id/text_view_calories_detail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/roboto_bold"
            android:textColor="?attr/colorPrimary"
            android:textSize="20sp"
            tools:text="450 kkal" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"
        android:background="?attr/colorOutlineVariant" />

    <!-- Mode Selector: Porsiya vs Gramm -->
    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/toggle_group_unit_mode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:checkedButton="@id/btn_mode_portion"
        app:selectionRequired="true"
        app:singleSelection="true">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_mode_portion"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:fontFamily="@font/roboto_medium"
            android:text="@string/food_detail_portion_mode"
            android:textAllCaps="false"
            android:textSize="13sp"
            app:cornerRadius="14dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_mode_grams"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:fontFamily="@font/roboto_medium"
            android:text="@string/food_detail_grams_mode"
            android:textAllCaps="false"
            android:textSize="13sp"
            app:cornerRadius="14dp" />
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <!-- 1. Portion Mode Container -->
    <LinearLayout
        android:id="@+id/layout_portion_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Unified Portion Stepper: [- 1 +] -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:background="@drawable/round_lay_stroke"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="4dp">

            <ImageButton
                android:id="@+id/button_minus"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?selectableItemBackgroundBorderless"
                android:contentDescription="@string/food_detail_decrease_amount"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_minus"
                app:tint="?attr/colorOnSurface" />

            <EditText
                android:id="@+id/edit_text_quantity"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:fontFamily="@font/roboto_bold"
                android:gravity="center"
                android:inputType="numberDecimal"
                android:textColor="?attr/colorOnSurface"
                android:textSize="17sp"
                tools:text="1" />

            <ImageButton
                android:id="@+id/button_plus"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?selectableItemBackgroundBorderless"
                android:contentDescription="@string/food_detail_increase_amount"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/add_ic"
                app:tint="?attr/colorOnSurface" />
        </LinearLayout>

        <!-- Serving Size Dropdown -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1.2"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusTopStart="12dp"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu">

            <AutoCompleteTextView
                android:id="@+id/auto_complete_serving_size"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:fontFamily="@font/roboto_medium"
                android:inputType="none"
                android:paddingVertical="0dp"
                android:paddingHorizontal="12dp"
                android:textColor="?attr/colorOnSurface"
                android:textSize="14sp" />
        </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>

    <!-- 2. Grams Mode Container -->
    <LinearLayout
        android:id="@+id/layout_gram_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Unified Stepper for Grams -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:background="@drawable/round_lay_stroke"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="6dp">

            <ImageButton
                android:id="@+id/button_minus_grams"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="?selectableItemBackgroundBorderless"
                android:contentDescription="@string/food_detail_decrease_amount"
                android:padding="11dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_minus"
                app:tint="?attr/colorOnSurface" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/edit_text_grams"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:background="@null"
                    android:fontFamily="@font/roboto_bold"
                    android:gravity="center"
                    android:inputType="numberDecimal"
                    android:minWidth="50dp"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="20sp"
                    tools:text="150" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:fontFamily="@font/roboto_medium"
                    android:text="@string/food_detail_grams_suffix"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="16sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/button_plus_grams"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="?selectableItemBackgroundBorderless"
                android:contentDescription="@string/food_detail_increase_amount"
                android:padding="11dp"
                android:scaleType="fitCenter"
                android:src="@drawable/add_ic"
                app:tint="?attr/colorOnSurface" />
        </LinearLayout>

        <!-- Quick Gram Chips -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chip_group_quick_grams"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:singleLine="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_50g"
                    style="@style/Widget.Material3.Chip.Suggestion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/food_detail_chip_50g" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_100g"
                    style="@style/Widget.Material3.Chip.Suggestion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/food_detail_chip_100g" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_150g"
                    style="@style/Widget.Material3.Chip.Suggestion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/food_detail_chip_150g" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_200g"
                    style="@style/Widget.Material3.Chip.Suggestion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/food_detail_chip_200g" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_250g"
                    style="@style/Widget.Material3.Chip.Suggestion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/food_detail_chip_250g" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_300g"
                    style="@style/Widget.Material3.Chip.Suggestion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/food_detail_chip_300g" />
            </com.google.android.material.chip.ChipGroup>
        </HorizontalScrollView>
    </LinearLayout>

    <!-- Log Food Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_log_food"
        style="@style/Widget.Material3.Button"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="20dp"
        android:fontFamily="@font/roboto_bold"
        android:text="@string/add"
        android:textAllCaps="false"
        android:textColor="?attr/colorOnPrimary"
        android:textSize="16sp"
        app:backgroundTint="?attr/colorPrimary"
        app:cornerRadius="18dp" />

</LinearLayout>