<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:elevation="@dimen/dimen_2"
    android:layout_marginHorizontal="@dimen/dimen_8"
    android:layout_marginTop="@dimen/dimen_12"
    app:cardCornerRadius="@dimen/dimen_12"
    app:cardElevation="@dimen/dimen_2"
    app:cardBackgroundColor="?colorSurface"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/dimen_18"
        android:orientation="vertical"
        >
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Osh"
            android:id="@+id/name_view"
            style="@style/Title3_17"
            android:textColor="?colorOnSurface"
            />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="@dimen/dimen_8"
            >
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Yeyish mumkin"
                android:textColor="?colorOnSurface"
                style="@style/Text2_15"
                />
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:id="@+id/when"
                android:text="Har 10–14 kunda 1 marta"
                android:textColor="?colorOnSurface"
                style="@style/Headline3_15"
                />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="@dimen/dimen_12"
            >
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Miqdori"
                android:textColor="?colorOnSurface"
                style="@style/Text2_15"
                />
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:id="@+id/amount"
                android:text="1 kosa (150–200g)"
                android:textColor="?colorOnSurface"
                style="@style/Headline3_15"
                />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="@dimen/dimen_12"
            >
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Vaqti"
                android:textColor="?colorOnSurface"
                style="@style/Text2_15"
                />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Faqat tushlikda"
                android:id="@+id/mealtime"
                android:textColor="?colorOnSurface"
                style="@style/Headline3_15"
                />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>