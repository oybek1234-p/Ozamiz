<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurfaceContainerLowest">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="@string/home_title"
            app:titleCentered="true"
            app:titleTextAppearance="@style/Title2_20"
            app:titleTextColor="?attr/colorOnSurface">

            <!-- Streak Display Elements -->
            <LinearLayout
                android:id="@+id/streak_display_layout"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="end"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:paddingHorizontal="@dimen/dimen_18"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone"
                tools:visibility="visible">

                <ImageView
                    android:id="@+id/image_streak_icon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/fire_ic"
                    app:tint="?attr/colorOnSurfaceVariant" />

                <TextView
                    android:id="@+id/text_streak_count"
                    style="@style/Headline3_15"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="0"
                    android:textColor="?attr/colorPrimary"
                    tools:text="3" />
            </LinearLayout>
        </com.google.android.material.appbar.MaterialToolbar>

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefreshLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/contentScrollView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="88dp"> <!-- Padding bottom for Nav -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="16dp"
                android:clipToPadding="false"
                android:background="?colorSurfaceContainerLow"
                android:paddingBottom="16dp">

                <!-- Calorie Goal -->
                <TextView
                    android:id="@+id/text_daily_summary_title"
                    style="@style/Title3_17"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginEnd="16dp"
                    android:text="@string/daily_calorie_goal_title"
                    android:textColor="?attr/colorOnSurface"
                    android:visibility="gone" />


                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"

                    android:layout_marginEnd="16dp"
                    app:cardBackgroundColor="?attr/colorSurfaceContainerLowest"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="4dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingBottom="@dimen/dimen_18"
                        android:background="?colorSurfaceContainerLowest"
                        android:paddingHorizontal="18sp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            >
                            <TextView
                                android:id="@+id/text_target_calories"
                                style="@style/Text1_16"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="18dp"
                                android:layout_marginEnd="16dp"
                                android:textColor="?attr/colorOnSurface"
                                android:textSize="18sp"
                                android:text="Ovqat nazorati"
                                />

                            <TextView
                                android:id="@+id/text_consumed"
                                style="@style/Headline2_16"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:gravity="end"
                                android:layout_gravity="bottom|end"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="16dp"
                                tools:text="850 / 1750 kkal" />

                        </LinearLayout>

                        <TextView
                            android:id="@+id/text_consumed_calories"
                            style="@style/Headline2_16"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="16dp"
                            android:layout_marginTop="4dp"
                            tools:text="850 / 1750 kkal" />


                        <com.google.android.material.progressindicator.LinearProgressIndicator
                            android:id="@+id/progress_calories"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:layout_marginEnd="16dp"
                            app:indicatorColor="?attr/colorPrimary"
                            app:indicatorTrackGapSize="0dp"
                            app:trackColor="?attr/colorSurfaceContainerHighest"
                            app:trackCornerRadius="12dp"
                            android:layout_marginBottom="@dimen/dimen_12"
                            app:trackStopIndicatorSize="0dp"
                            app:trackThickness="16dp"
                            tools:progress="60" />

                        <TextView
                            style="@style/Subtitle1_14"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/add_meal_description"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:visibility="gone" />

                        <include
                            android:id="@+id/layout_breakfast"
                            layout="@layout/item_home_meal" />

                        <include
                            android:id="@+id/layout_lunch"
                            layout="@layout/item_home_meal" />

                        <include
                            android:id="@+id/layout_dinner"
                            layout="@layout/item_home_meal" />

                        <include
                            android:id="@+id/layout_snack"
                            layout="@layout/item_home_meal" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Food List Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_food_list"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    android:layout_marginHorizontal="@dimen/dimen_18"
                    android:layout_marginTop="16dp"
                    android:text="@string/food_list_button"
                    android:textColor="?colorPrimary"
                    app:icon="@drawable/food_ic"
                    app:iconGravity="textStart"
                    app:iconTint="?attr/colorPrimary" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginEnd="16dp"
                    app:cardBackgroundColor="?attr/colorSurfaceContainerLowest"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="4dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?colorSurfaceContainerLowest"
                        android:orientation="vertical"
                        android:padding="@dimen/dimen_18">

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <ImageView
                                android:id="@+id/icon_water"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/water_full_24px"
                                app:layout_constraintBottom_toBottomOf="@id/title_water"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="@id/title_water"
                                app:tint="@color/blue" />

                            <TextView
                                android:id="@+id/title_water"
                                style="@style/Headline2_16"
                                android:layout_width="0dp"
                                android:fontFamily="@font/roboto_bold"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:text="@string/water_intake_title"
                                android:textColor="?attr/colorPrimary"
                                app:layout_constraintEnd_toStartOf="@id/button_add_water"
                                app:layout_constraintStart_toEndOf="@id/icon_water"
                                app:layout_constraintTop_toTopOf="parent" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/button_add_water"
                                style="@style/Widget.Material3.Button.IconButton.Filled"
                                android:layout_width="wrap_content"
                                android:layout_height="40dp"
                                android:contentDescription="@string/add"
                                android:paddingVertical="0dp"
                                android:paddingEnd="@dimen/dimen_18"
                                android:text="Suv ichdim"
                                android:textSize="14sp"
                                app:icon="@drawable/add_ic"
                                app:iconGravity="textStart"
                                app:iconPadding="@dimen/dimen_8"
                                app:iconSize="20dp"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintTop_toTopOf="parent" />

                        </androidx.constraintlayout.widget.ConstraintLayout>

                        <TextView
                            android:id="@+id/text_target_water"
                            style="@style/Text1_16"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:textColor="?attr/colorOnSurface"
                            tools:text="Kunlik maqsad: 2.5 litr" />

                        <TextView
                            android:id="@+id/text_consumed_water"
                            style="@style/Headline3_15"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:textColor="?colorOnSurface"
                            tools:text="1000 / 2500 ml" />

                        <com.google.android.material.progressindicator.LinearProgressIndicator
                            android:id="@+id/progress_water"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            app:indicatorColor="?attr/colorPrimary"
                            app:indicatorTrackGapSize="0dp"
                            app:trackColor="?attr/colorSurfaceContainerHighest"
                            app:trackCornerRadius="4dp"
                            app:trackStopIndicatorSize="0dp"
                            app:trackThickness="12dp"
                            tools:progress="40" />

                        <TextView
                            style="@style/Caption1_13"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:text="Suv ichish tanani tozalaydi, ishtahani kamaytiradi va vazn tashlashni osonlashtiradi."
                            android:textColor="?attr/colorOnSurfaceVariant"
                      />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>


                <!-- Exercise Section Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginEnd="16dp"
                    app:cardBackgroundColor="?attr/colorSurfaceContainerLowest"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="4dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="?colorSurfaceContainerLowest"
                        android:padding="18sp">

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <ImageView
                                android:id="@+id/icon_exercise"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/fire_ic"
                                app:layout_constraintBottom_toBottomOf="@id/title_exercise"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="@id/title_exercise"
                                app:tint="@color/yellow" /> <!-- Changed tint -->


                            <TextView
                                android:id="@+id/title_exercise"
                                style="@style/Headline2_16"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:text="Harakat"
                                android:fontFamily="@font/roboto_bold"
                                android:textColor="?attr/colorPrimary"
                                app:layout_constraintEnd_toStartOf="@id/button_add_exercise_log"
                                app:layout_constraintStart_toEndOf="@id/icon_exercise"
                                app:layout_constraintTop_toTopOf="parent" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/button_add_exercise_log"
                                style="@style/Widget.Material3.Button.IconButton.Filled"
                                android:layout_width="wrap_content"
                                android:layout_height="40dp"
                                android:paddingVertical="0dp"
                                android:paddingEnd="@dimen/dimen_18"
                                android:text="Mashq qildim"
                                android:textSize="14sp"
                                app:icon="@drawable/add_ic"
                                app:iconGravity="textStart"
                                app:iconPadding="@dimen/dimen_8"
                                app:iconSize="20dp"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintTop_toTopOf="parent" />

                        </androidx.constraintlayout.widget.ConstraintLayout>

                        <TextView
                            android:id="@+id/text_target_exercise"
                            style="@style/Text1_14"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:drawablePadding="@dimen/dimen_8"
                            android:text="🕒 Mashq qiling \n🚶‍♀️ Piyoda yuring\n🕺 Raqsga tushing"
                            android:gravity="center_vertical"
                            android:textColor="?attr/colorOnSurface"
                            app:drawableTint="?colorOnSurfaceVariant"
                            tools:ignore="UseCompatTextViewDrawableXml"
                        />

                        <TextView
                            android:id="@+id/text_burned_calories"
                            style="@style/Headline3_15"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:textColor="?colorOnSurface"
                            tools:text="150 / 500 kkal yoqildi" />

                        <com.google.android.material.progressindicator.LinearProgressIndicator
                            android:id="@+id/progress_exercise"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            app:indicatorColor="?attr/colorPrimary"
                            app:indicatorTrackGapSize="0dp"
                            app:trackColor="?attr/colorSurfaceContainerHighest"
                            app:trackCornerRadius="4dp"
                            app:trackStopIndicatorSize="0dp"
                            app:trackThickness="12dp"
                            tools:progress="30" />

                        <LinearLayout
                            android:id="@+id/layout_exercise_logs"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:orientation="vertical"
                            android:visibility="gone"
                            tools:visibility="visible" />

                        <TextView
                            android:id="@+id/text_no_exercise_logs"
                            style="@style/Text1_14"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:gravity="center_horizontal"
                            android:text="@string/no_exercise_logs_yet"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:visibility="gone"
                            tools:visibility="visible" />

                        <TextView
                            style="@style/Caption1_13"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:text="Harakat yog‘ni eritab, ozishga va sog‘lom bo‘lishga yordam beradi."
                            android:textColor="?attr/colorOnSurfaceVariant"
                  />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_weight_goal_progress_section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginEnd="16dp"
                    app:cardBackgroundColor="?attr/colorSurfaceContainerLowest"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="4dp"
                    app:strokeWidth="0dp"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?colorSurfaceContainerLowest"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <TextView
                                android:id="@+id/text_weight_goal_title"
                                style="@style/Title3_17"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:text="Vazn"
                                android:textColor="?colorOnSurface"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent"
                                app:layout_constraintEnd_toStartOf="@+id/icon_weight_goal_arrow"/>

                            <ImageView
                                android:id="@+id/icon_weight_goal_arrow"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:src="@drawable/arrow_right"
                                app:tint="?colorOnSurfaceVariant"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintTop_toTopOf="@id/text_weight_goal_title"
                                app:layout_constraintBottom_toBottomOf="@id/text_weight_goal_title"/>

                        </androidx.constraintlayout.widget.ConstraintLayout>


                        <TextView
                            android:id="@+id/text_current_weight_on_goal_card"
                            style="@style/Title4_24"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:textColor="?colorOnSurface"
                            tools:text="80.0 kg" />

                        <com.google.android.material.progressindicator.LinearProgressIndicator
                            android:id="@+id/progress_weight_goal_bar"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            app:indicatorColor="?attr/colorPrimary"
                            app:indicatorTrackGapSize="0dp"
                            app:trackColor="?attr/colorSurfaceContainerHighest"
                            app:trackCornerRadius="8dp"
                            app:trackStopIndicatorSize="0dp"
                            app:trackThickness="12dp"
                            tools:progress="0" />

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp">

                            <TextView
                                android:id="@+id/text_initial_weight_goal_label"
                                style="@style/Text2_15"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentStart="true"
                                android:textColor="?colorOnSurfaceVariant"
                                tools:text="80.0 kg" />

                            <TextView
                                android:id="@+id/text_target_weight_goal_label"
                                style="@style/Text2_15"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:textColor="?colorOnSurfaceVariant"
                                tools:text="70.0 kg" />
                        </RelativeLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:orientation="horizontal">

                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginEnd="8dp"
                                app:cardBackgroundColor="?colorSurfaceContainer"
                                app:cardCornerRadius="8dp"
                                app:cardElevation="0dp">
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical"
                                    android:gravity="center"
                                    android:padding="12dp">
                                    <TextView
                                        style="@style/TextLabelMedium"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Progress" />
                                    <TextView
                                        android:id="@+id/text_weight_lost_on_goal"
                                        style="@style/Title3_17"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:textColor="?colorPrimary"
                                        tools:text="0.0 kg" />
                                </LinearLayout>
                            </com.google.android.material.card.MaterialCardView>

                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="8dp"
                                app:cardBackgroundColor="?colorSurfaceContainer"
                                app:cardCornerRadius="8dp"
                                app:cardElevation="0dp">
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical"
                                    android:gravity="center"
                                    android:padding="12dp">
                                    <TextView
                                        style="@style/TextLabelMedium"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Qoldi" />
                                    <TextView
                                        android:id="@+id/text_weight_remaining_on_goal"
                                        style="@style/Title3_17"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:textColor="?colorOnSurface"
                                        tools:text="10.0 kg" />
                                </LinearLayout>
                            </com.google.android.material.card.MaterialCardView>
                        </LinearLayout>

                        <TextView
                            android:id="@+id/text_goal_start_date_on_goal"
                            style="@style/Caption2_12"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:visibility="gone"
                            android:gravity="start"
                            android:textColor="?colorOnSurfaceVariant"
                            tools:text="Boshlangan sana: 15-Avgust, 2023"/>

                        <TextView
                            android:id="@+id/text_active_days_on_goal"
                            style="@style/Caption2_12"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:visibility="gone"
                            android:gravity="start"
                            android:textColor="?colorOnSurfaceVariant"
                            tools:text="Aktiv kunlar: 5 kun"/>


                        <TextView
                            style="@style/Headline3_15"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:text="Ozasiz"
                            android:textColor="?colorPrimary" />

                        <TextView
                            android:id="@+id/text_timeline1_on_goal"
                            style="@style/Text1_14"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textColor="?colorOnSurface"
                            tools:text="1-hafta: ~0.8 kg"/>

                        <TextView
                            android:id="@+id/text_timeline3_on_goal"
                            style="@style/Text1_14"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textColor="?colorOnSurface"
                            tools:text="1 oyda: ~3–4 kg"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <!-- END OF NEW WEIGHT GOAL SECTION -->


                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:visibility="gone"
                    android:layout_marginTop="16dp"
                    android:layout_marginEnd="16dp"
                    app:cardBackgroundColor="?attr/colorSurfaceContainerLowest"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="4dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone"
                        android:background="?colorSurfaceContainerLowest"
                        android:padding="18sp">

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <ImageView
                                android:id="@+id/icon_reminder"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/notify_ic"
                                app:layout_constraintBottom_toBottomOf="@id/title_reminder"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="@id/title_reminder"
                                app:tint="?attr/colorPrimary" />

                            <TextView
                                android:id="@+id/title_reminder"
                                style="@style/Headline2_16"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:text="@string/reminders_title"
                                android:textColor="?attr/colorOnSurface"
                                app:layout_constraintEnd_toStartOf="@id/button_add_reminder"
                                app:layout_constraintStart_toEndOf="@id/icon_reminder"
                                app:layout_constraintTop_toTopOf="parent" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/button_add_reminder"
                                style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:contentDescription="@string/edit_reminders_button_desc"
                                app:icon="@drawable/edit"
                                app:iconGravity="textStart"
                                app:iconSize="20dp"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintTop_toTopOf="parent" />

                        </androidx.constraintlayout.widget.ConstraintLayout>

                        <LinearLayout
                            android:id="@+id/layout_reminders"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:orientation="vertical"
                            android:visibility="gone"
                            tools:visibility="visible" />

                        <TextView
                            android:id="@+id/text_no_reminders"
                            style="@style/Text1_14"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:gravity="center_horizontal"
                            android:text="@string/no_upcoming_reminders"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:visibility="gone"
                            tools:visibility="visible" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/progressBarOverall"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:indeterminate="true"
        android:visibility="gone"
        tools:visibility="visible" />

    <!-- Container for the First Log Congratulation Dialog -->
    <FrameLayout
        android:id="@+id/first_log_congratulation_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        tools:visibility="gone"/>

    <!-- Container for the Streak Dialog -->
    <FrameLayout
        android:id="@+id/streak_info_dialog_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        tools:visibility="gone"/>

</androidx.coordinatorlayout.widget.CoordinatorLayout>