<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?colorSurfaceContainer">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?colorSurfaceContainerLowest"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="?colorSurfaceContainerLowest"
            app:title="Bugun"
            app:titleCentered="true"
            app:titleTextAppearance="@style/Title2_20"
            app:titleTextColor="?attr/colorOnSurface">

            <LinearLayout
                android:id="@+id/streak_display_layout"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="end"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/dimen_18"
                tools:visibility="visible">

                <ImageView
                    android:id="@+id/image_streak_icon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/fire_ic"
                    app:tint="?attr/colorOnSurfaceVariant" />

                <TextView
                    android:id="@+id/text_streak_count"
                    style="@style/Headline3_15"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:textColor="?attr/colorPrimary"
                    tools:text="3" />
            </LinearLayout>
        </com.google.android.material.appbar.MaterialToolbar>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/date_scroller_recycler_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:paddingBottom="@dimen/dimen_12"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:background="?colorSurfaceContainerLowest"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:itemCount="10"
            tools:listitem="@layout/item_date_scroller" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefreshLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/contentScrollView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="88dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:orientation="vertical"
                android:paddingTop="16dp"
                android:paddingBottom="200dp">

                <include
                    android:id="@+id/main_progress"
                    layout="@layout/home_main_progress" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginTop="@dimen/dimen_8"
                    android:layout_marginEnd="12dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="1dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="?colorSurfaceContainerLowest"
                        android:paddingBottom="@dimen/dimen_18">

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingStart="@dimen/dimen_18">

                            <ImageView
                                android:id="@+id/icon_water"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/water_full_24px"
                                app:layout_constraintBottom_toBottomOf="@+id/title_water"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="@id/title_water"
                                app:tint="@color/blue" />

                            <TextView
                                android:id="@+id/title_water"
                                style="@style/Headline2_16"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:layout_marginTop="@dimen/dimen_18"
                                android:text="@string/water_intake_title"
                                android:textColor="@color/blue"
                                app:layout_constraintEnd_toStartOf="@id/button_add_water"
                                app:layout_constraintStart_toEndOf="@id/icon_water"
                                app:layout_constraintTop_toTopOf="parent" />

                            <ImageView
                                android:id="@+id/button_add_water"
                                style="@style/Widget.Material3.Button.IconButton"
                                android:layout_width="@dimen/dimen_48"
                                android:layout_height="48dp"
                                android:src="@drawable/add_ic"
                                android:textSize="14sp"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintTop_toTopOf="parent"
                                app:tint="?colorPrimary" />

                        </androidx.constraintlayout.widget.ConstraintLayout>

                        <TextView
                            android:id="@+id/text_consumed_water"
                            style="@style/Text1_14"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="@dimen/dimen_18"
                            android:textColor="?colorOnSurface"
                            tools:text="250 ml ichildi" />

                        <com.google.android.material.progressindicator.LinearProgressIndicator
                            android:id="@+id/progress_water"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="@dimen/dimen_18"
                            app:indicatorColor="@color/blue"
                            android:layout_marginTop="@dimen/dimen_12"
                            app:indicatorTrackGapSize="0dp"
                            app:trackColor="?attr/colorSurfaceContainer"
                            app:trackCornerRadius="20dp"
                            app:trackStopIndicatorSize="0dp"
                            app:trackThickness="12dp"
                            tools:progress="40" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dimen_12"
                    android:layout_marginTop="@dimen/dimen_12"
                    android:layout_marginEnd="12dp"
                    app:cardBackgroundColor="?attr/colorSurfaceContainerLowest"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="1dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?colorSurfaceContainerLowest"
                        android:orientation="vertical">

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <ImageView
                                android:id="@+id/icon_exercise"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_marginStart="@dimen/dimen_18"
                                android:layout_marginTop="@dimen/dimen_18"
                                android:src="@drawable/fire_ic"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent"
                                app:tint="@color/yellow" />


                            <TextView
                                android:id="@+id/title_exercise"
                                style="@style/Text1_16"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:text="Harakat"
                                android:textColor="#E99C02"
                                app:layout_constraintBottom_toBottomOf="@+id/icon_exercise"
                                app:layout_constraintEnd_toStartOf="@id/button_add_exercise_log"
                                app:layout_constraintStart_toEndOf="@id/icon_exercise"
                                app:layout_constraintTop_toTopOf="@+id/icon_exercise" />

                            <ImageView
                                android:id="@+id/button_add_exercise_log"
                                style="@style/Widget.Material3.Button.IconButton"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:padding="@dimen/dimen_18"
                                android:src="@drawable/add_ic"
                                android:textSize="14sp"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintTop_toTopOf="parent" />

                        </androidx.constraintlayout.widget.ConstraintLayout>

                        <TextView
                            style="@style/Text1_16"
                            android:visibility="gone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="@dimen/dimen_18"
                            android:text="Tavsiya kamida 300 kaloriya yoqing"
                            android:textColor="?attr/colorOnSurfaceVariant" />

                        <TextView
                            android:id="@+id/text_burned_calories"
                            style="@style/Text1_14"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="@dimen/dimen_18"
                            android:layout_marginBottom="@dimen/dimen_12"
                            android:textColor="?colorOnSurface"
                            tools:text="50 yoqildi" />


                        <com.google.android.material.progressindicator.LinearProgressIndicator
                            android:id="@+id/progress_exercise"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="@dimen/dimen_18"
                            app:indicatorColor="@color/yellow"
                            android:layout_marginBottom="@dimen/dimen_12"
                            app:indicatorTrackGapSize="0dp"
                            app:trackColor="?attr/colorSurfaceContainer"
                            app:trackCornerRadius="20dp"
                            app:trackStopIndicatorSize="0dp"
                            app:trackThickness="12dp"
                            tools:progress="30" />

                        <LinearLayout
                            android:id="@+id/layout_exercise_logs"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:orientation="vertical"
                            android:visibility="gone"
                            tools:visibility="visible" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/progressBarOverall"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:indeterminate="true"
        android:visibility="gone"
        tools:visibility="visible" />
</androidx.coordinatorlayout.widget.CoordinatorLayout>