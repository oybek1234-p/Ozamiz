<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?colorSurfaceContainerLowest">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?colorSurfaceContainerLowest"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="?colorSurfaceContainerLowest"
            app:contentInsetStart="0dp"
            app:contentInsetStartWithNavigation="0dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <LinearLayout
                    android:id="@+id/app_logo_layout"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/dimen_18"
                    android:paddingEnd="4dp"
                    android:visibility="gone"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/new_logo" />

                    <TextView
                        style="@style/Headline2_16"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:fontFamily="@font/roboto_bold"
                        android:text="@string/app_name"
                        android:textColor="?colorOnSurface" />
                </LinearLayout>

                <TextView
                    android:id="@+id/toolbar_title"
                    style="@style/Title2_20"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:drawableEnd="@drawable/ic_arrow_down"
                    android:drawablePadding="6dp"
                    android:drawableTint="?attr/colorOnSurface"
                    android:ellipsize="end"
                    android:focusable="true"
                    android:gravity="center"
                    android:maxLines="1"
                    android:textColor="?attr/colorOnSurface"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:text="Bugun" />

                <LinearLayout
                    android:id="@+id/streak_display_layout"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/dimen_18"
                    android:visibility="gone"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:visibility="visible">

                    <ImageView
                        android:id="@+id/image_streak_icon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/fire_ic"
                        app:tint="@color/yellow" />

                    <TextView
                        android:id="@+id/text_streak_count"
                        style="@style/Headline2_16"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:fontFamily="@font/roboto_bold"
                        android:textColor="#FFA100"
                        tools:text="3" />
                </LinearLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.appbar.MaterialToolbar>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/date_scroller_recycler_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?colorSurfaceContainerLowest"
            android:clipToPadding="false"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingBottom="@dimen/dimen_12"
            android:visibility="gone"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:itemCount="10"
            tools:listitem="@layout/item_date_scroller" />

    </com.google.android.material.appbar.AppBarLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipeRefreshLayout"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.core.widget.NestedScrollView
                android:id="@+id/contentScrollView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingBottom="88dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:gravity="end"
                    android:orientation="vertical"
                    android:paddingTop="16dp"
                    android:paddingBottom="100dp">

                    <include
                        android:id="@+id/main_progress"
                        layout="@layout/home_main_progress" />

                    <!-- Premium Payment Verification Pending Card -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/card_premium_checking"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="16dp"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="4dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?selectableItemBackground"
                        android:visibility="gone"
                        app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="0dp"
                        app:strokeColor="?attr/colorOutlineVariant"
                        app:strokeWidth="1dp"
                        tools:visibility="visible">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:padding="16dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="24sp"
                                android:text="⌛" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="14dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/roboto_bold"
                                    android:text="To'lov tekshirilmoqda"
                                    android:textColor="?attr/colorOnSurface"
                                    android:textSize="15sp" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:fontFamily="@font/roboto_regular"
                                    android:text="24 soat ichida chekni tekshirib, premiumga o'tkazamiz"
                                    android:textColor="?attr/colorOnSurfaceVariant"
                                    android:textSize="13sp" />
                            </LinearLayout>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/card_app_feedback"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="16dp"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="4dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?selectableItemBackground"
                        android:visibility="gone"
                        app:cardBackgroundColor="?attr/colorSurfaceContainerLowest"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="1dp"
                        tools:visibility="visible">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:padding="16dp">

                            <ImageView
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:importantForAccessibility="no"
                                android:padding="2dp"
                                android:src="@drawable/new_logo" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="14dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    style="@style/TextAppearance.Material3.TitleMedium"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/roboto_bold"
                                    android:text="Ilovamiz sizga manzur bo'lyaptimi? ⭐"
                                    android:textColor="?attr/colorOnSurface"
                                    android:textSize="16sp" />

                                <TextView
                                    style="@style/Text1_14"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="Fikringizni qoldiring"
                                    android:textColor="?attr/colorOnSurfaceVariant"
                                    android:textSize="13sp" />
                            </LinearLayout>

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:importantForAccessibility="no"
                                android:rotation="-90"
                                android:src="@drawable/ic_arrow_down"
                                app:tint="?attr/colorOnSurfaceVariant" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/layout_meal_cards"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="8dp"
                        app:cardBackgroundColor="?attr/colorSurfaceContainerLowest"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="0dp"
                        app:strokeColor="?attr/colorOutlineVariant"
                        app:strokeWidth="0dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <include
                                android:id="@+id/card_breakfast"
                                layout="@layout/item_home_meal_card" />

                            <include
                                android:id="@+id/card_lunch"
                                layout="@layout/item_home_meal_card" />

                            <include
                                android:id="@+id/card_dinner"
                                layout="@layout/item_home_meal_card" />

                            <include
                                android:id="@+id/card_snack"
                                layout="@layout/item_home_meal_card" />

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:background="?colorSurfaceContainer" />
                            <!-- Water item -->
                            <androidx.constraintlayout.widget.ConstraintLayout
                                android:id="@+id/card_water"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="?selectableItemBackground"
                                android:clickable="true"
                                android:focusable="true"
                                android:minHeight="68dp"
                                android:paddingHorizontal="@dimen/dimen_24"
                                android:paddingVertical="18dp">

                                <FrameLayout
                                    android:id="@+id/layout_water_progress_container"
                                    android:layout_width="48dp"
                                    android:layout_height="48dp"
                                    app:layout_constraintBottom_toBottomOf="parent"
                                    app:layout_constraintStart_toStartOf="parent"
                                    app:layout_constraintTop_toTopOf="parent">

                                    <com.google.android.material.progressindicator.CircularProgressIndicator
                                        android:id="@+id/progress_water"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_gravity="center"
                                        app:indicatorColor="#1E88E5"
                                        app:indicatorSize="48dp"
                                        app:indicatorTrackGapSize="0dp"
                                        app:trackColor="?attr/colorSurfaceContainerHigh"
                                        app:trackCornerRadius="3dp"
                                        app:trackThickness="4dp"
                                        tools:progress="40" />

                                    <ImageView
                                        android:layout_width="26dp"
                                        android:layout_height="26dp"
                                        android:layout_gravity="center"
                                        android:importantForAccessibility="no"
                                        android:src="@drawable/ic_water_drop_blue" />
                                </FrameLayout>

                                <ImageButton
                                    android:id="@+id/btn_add_water"
                                    android:layout_width="40dp"
                                    android:layout_height="40dp"
                                    android:background="@drawable/bg_circle_primary"
                                    android:padding="10dp"
                                    android:src="@drawable/add_ic"
                                    android:visibility="visible"
                                    app:layout_constraintBottom_toBottomOf="parent"
                                    app:layout_constraintEnd_toEndOf="parent"
                                    app:layout_constraintTop_toTopOf="parent"
                                    app:tint="?attr/colorOnPrimary" />

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="12dp"
                                    android:layout_marginEnd="12dp"
                                    android:orientation="vertical"
                                    app:layout_constraintBottom_toBottomOf="parent"
                                    app:layout_constraintEnd_toStartOf="@+id/btn_add_water"
                                    app:layout_constraintStart_toEndOf="@id/layout_water_progress_container"
                                    app:layout_constraintTop_toTopOf="parent">

                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:gravity="center_vertical"
                                        android:orientation="horizontal">

                                        <TextView
                                            android:id="@+id/title_water"
                                            style="@style/TextAppearance.Material3.TitleMedium"
                                            android:layout_width="0dp"
                                            android:layout_height="wrap_content"
                                            android:layout_weight="1"
                                            android:fontFamily="@font/roboto_bold"
                                            android:textColor="?attr/colorOnSurface"
                                            android:textSize="15sp"
                                            tools:text="Suv" />

                                        <TextView
                                            android:id="@+id/text_water_value"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:fontFamily="@font/roboto_medium"
                                            android:textColor="?attr/colorOnSurface"
                                            android:textSize="15sp"
                                            tools:text="0.8 ichildi" />
                                    </LinearLayout>

                                    <TextView
                                        android:id="@+id/text_current_water_liters"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="2dp"
                                        android:ellipsize="end"
                                        android:fontFamily="@font/roboto_regular"
                                        android:maxLines="1"
                                        android:textColor="?attr/colorOnSurfaceVariant"
                                        android:textSize="14sp"
                                        tools:text="Maqsad 2.5 litr" />
                                </LinearLayout>
                            </androidx.constraintlayout.widget.ConstraintLayout>

                            <!-- Exercise item -->
                            <androidx.constraintlayout.widget.ConstraintLayout
                                android:id="@+id/card_exercise"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="?selectableItemBackground"
                                android:clickable="true"
                                android:focusable="true"
                                android:minHeight="68dp"
                                android:paddingHorizontal="24dp"
                                android:paddingVertical="@dimen/dimen_18">

                                <FrameLayout
                                    android:id="@+id/layout_exercise_progress_container"
                                    android:layout_width="48dp"
                                    android:layout_height="48dp"
                                    app:layout_constraintBottom_toBottomOf="parent"
                                    app:layout_constraintStart_toStartOf="parent"
                                    app:layout_constraintTop_toTopOf="parent">

                                    <com.google.android.material.progressindicator.CircularProgressIndicator
                                        android:id="@+id/progress_exercise"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_gravity="center"
                                        app:indicatorColor="@color/orange"
                                        app:indicatorSize="48dp"
                                        app:indicatorTrackGapSize="0dp"
                                        app:trackColor="?attr/colorSurfaceContainerHigh"
                                        app:trackCornerRadius="3dp"
                                        app:trackThickness="4dp"
                                        tools:progress="60" />

                                    <ImageView
                                        android:layout_width="26dp"
                                        android:layout_height="26dp"
                                        android:layout_gravity="center"
                                        android:importantForAccessibility="no"
                                        android:src="@drawable/fire_ic"
                                        app:tint="#FF6D00" />
                                </FrameLayout>

                                <ImageButton
                                    android:id="@+id/btn_add_exercise"
                                    android:layout_width="40dp"
                                    android:layout_height="40dp"
                                    android:background="@drawable/bg_circle_primary"
                                    android:padding="10dp"
                                    android:src="@drawable/add_ic"
                                    android:visibility="visible"
                                    app:layout_constraintBottom_toBottomOf="parent"
                                    app:layout_constraintEnd_toEndOf="parent"
                                    app:layout_constraintTop_toTopOf="parent"
                                    app:tint="?attr/colorOnPrimary" />

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="12dp"
                                    android:layout_marginEnd="12dp"
                                    android:orientation="vertical"
                                    app:layout_constraintBottom_toBottomOf="parent"
                                    app:layout_constraintEnd_toStartOf="@+id/btn_add_exercise"
                                    app:layout_constraintStart_toEndOf="@id/layout_exercise_progress_container"
                                    app:layout_constraintTop_toTopOf="parent">

                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:gravity="center_vertical"
                                        android:orientation="horizontal">

                                        <TextView
                                            android:id="@+id/title_exercise"
                                            style="@style/TextAppearance.Material3.TitleMedium"
                                            android:layout_width="0dp"
                                            android:layout_height="wrap_content"
                                            android:layout_weight="1"
                                            android:fontFamily="@font/roboto_bold"
                                            android:textColor="?attr/colorOnSurface"
                                            android:textSize="15sp"
                                            tools:text="Harakat" />

                                        <TextView
                                            android:id="@+id/text_exercise_value"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:fontFamily="@font/roboto_medium"
                                            android:textColor="?attr/colorOnSurface"
                                            android:textSize="15sp"
                                            tools:text="75 kal yoqildi" />
                                    </LinearLayout>

                                    <TextView
                                        android:id="@+id/text_exercise_progress"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="2dp"
                                        android:ellipsize="end"
                                        android:fontFamily="@font/roboto_regular"
                                        android:maxLines="1"
                                        android:textColor="?attr/colorOnSurfaceVariant"
                                        android:textSize="14sp"
                                        tools:text="Maqsad 300 kal" />
                                </LinearLayout>
                            </androidx.constraintlayout.widget.ConstraintLayout>

                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="?colorSurfaceContainer" />

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/card_what_to_eat"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="16dp"
                        android:layout_marginTop="8dp"
                        android:visibility="gone"
                        app:cardBackgroundColor="?attr/colorSurfaceContainerLowest"
                        app:cardCornerRadius="24dp"
                        app:cardElevation="0dp"
                        app:strokeColor="?attr/colorOutlineVariant"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:padding="16dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:importantForAccessibility="no"
                                android:text="🥗"
                                android:textSize="28sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:fontFamily="@font/roboto_bold"
                                android:text="@string/btn_what_to_eat_title"
                                android:textColor="?colorOnSurface"
                                android:textSize="15sp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>


                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/card_weight_log"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="16dp"
                        android:layout_marginTop="16dp"
                        android:visibility="gone"
                        app:cardBackgroundColor="?attr/colorSurfaceContainerLowest"
                        app:cardCornerRadius="24dp"
                        app:cardElevation="0dp"
                        app:strokeColor="?attr/colorOutlineVariant"
                        app:strokeWidth="1dp"
                        tools:visibility="visible">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:padding="20dp">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/roboto_bold"
                                    android:text="Vazningizni qo'shing"
                                    android:textColor="?attr/colorOnSurface"
                                    android:textSize="17sp" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:text="Yangi natijani bugun qayd eting."
                                    android:textColor="?attr/colorOnSurfaceVariant"
                                    android:textSize="14sp" />
                            </LinearLayout>

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_add_weight_home"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="16dp"
                                android:text="Qo'shish"
                                android:textColor="?attr/colorOnPrimary"
                                app:icon="@drawable/camera_ic" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Shaxsiy AI Dietolog Card -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/card_dietologist_home"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="16dp"
                        android:layout_marginTop="10dp"
                        app:cardBackgroundColor="?attr/colorSurfaceContainerLowest"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="0dp"
                        app:strokeColor="?attr/colorOutlineVariant"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <ImageView
                                    android:layout_width="36dp"
                                    android:layout_height="36dp"
                                    android:background="@drawable/bg_circle_primary"
                                    android:padding="8dp"
                                    android:backgroundTint="?colorSurfaceContainer"
                                    android:src="@drawable/chat_ic"
                                    app:tint="?attr/colorOnSurface" />

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="12dp"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:fontFamily="@font/roboto_bold"
                                        android:text="@string/card_dietolog_title"
                                        android:textColor="?attr/colorOnSurface"
                                        android:textSize="16sp" />

                                </LinearLayout>

                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="44dp"
                                android:layout_marginTop="12dp"
                                android:background="@drawable/rounded_bg_surface_variant"
                                android:backgroundTint="?colorSurfaceContainerLow"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:paddingHorizontal="14dp">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:fontFamily="@font/roboto_regular"
                                    android:text="Ozish bo'yicha savolingizni bering..."
                                    android:textColor="?attr/colorOnSurface"
                                    android:textSize="13sp" />

                                <ImageView
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:src="@drawable/arrow_right"
                                    app:tint="?attr/colorPrimary" />
                            </LinearLayout>

                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Vazn Tashlaganlar Card -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/card_community_home"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="16dp"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="16dp"
                        app:cardBackgroundColor="?attr/colorSurfaceContainerLowest"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="0dp"
                        app:strokeColor="?attr/colorOutlineVariant"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:padding="16dp">

                            <ImageView
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:background="@drawable/bg_circle_surface"
                                android:padding="8dp"
                                android:src="@drawable/group_ic"
                                app:tint="?attr/colorOnSurface" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/roboto_bold"
                                    android:text="@string/card_others_title"
                                    android:textColor="?attr/colorOnSurface"
                                    android:textSize="16sp" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:fontFamily="@font/roboto_regular"
                                    android:text="@string/card_others_subtitle"
                                    android:textColor="?attr/colorOnSurfaceVariant"
                                    android:textSize="12sp" />
                            </LinearLayout>

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/arrow_right"
                                app:tint="?attr/colorOnSurfaceVariant" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/card_goal_prediction"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="16dp"
                        android:layout_marginTop="8dp"
                        android:visibility="gone"
                        app:cardBackgroundColor="?attr/colorSurfaceContainerLowest"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="0dp"
                        tools:visibility="gone">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <TextView
                                    style="@style/TextAppearance.Material3.TitleMedium"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:fontFamily="@font/roboto_bold"
                                    android:text="Bugun ajoyib ketyapsiz! 🌟"
                                    android:textColor="?attr/colorOnSurface"
                                    android:textSize="16sp" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="🎯"
                                    android:textSize="24sp" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/text_goal_time_remaining"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:fontFamily="@font/roboto_bold"
                                android:textColor="?attr/colorPrimary"
                                android:textSize="15sp"
                                tools:text="Maqsadgacha: 1 oy 12 kun qoldi" />

                            <TextView
                                android:id="@+id/text_goal_target_date"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:fontFamily="@font/roboto_regular"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                android:textSize="13sp"
                                tools:text="Shu ketishda 25-avgustga borib maqsadingizga erishasiz!" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>
            </androidx.core.widget.NestedScrollView>
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    </LinearLayout>

    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/progressBarOverall"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:indeterminate="true"
        android:visibility="gone"
        tools:visibility="visible" />

    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/animation_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:visibility="gone"
        app:lottie_autoPlay="false"
        app:lottie_loop="false"
        app:lottie_rawRes="@raw/confeti_effect" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>