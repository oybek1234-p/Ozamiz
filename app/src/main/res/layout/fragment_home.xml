<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?colorSurfaceContainerLowest">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?colorSurfaceContainerLowest"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="?colorSurfaceContainerLowest"
            app:contentInsetStart="0dp"
            app:contentInsetStartWithNavigation="0dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <!-- Top Left Notification Button with Badge -->
                <FrameLayout
                    android:id="@+id/btn_home_notifications"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:clipToPadding="false"
                    android:paddingHorizontal="@dimen/dimen_18"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <ImageView
                        android:id="@+id/icon_home_notifications"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/notifications_ic"
                        app:tint="?attr/colorOnSurface" />

                    <TextView
                        android:id="@+id/badge_notification_count"
                        android:layout_width="wrap_content"
                        android:layout_height="16dp"
                        android:minWidth="16dp"
                        android:translationY="@dimen/dimen_6"
                        android:layout_gravity="center_vertical|end"
                        android:translationX="@dimen/dimen_6"
                        android:background="@drawable/bg_badge_notification"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:paddingHorizontal="4dp"
                        android:fontFamily="@font/roboto_bold"
                        android:textColor="@color/white"
                        android:textSize="10sp"
                        android:visibility="gone"
                        tools:text="3"
                        tools:visibility="visible" />
                </FrameLayout>

                <LinearLayout
                    android:id="@+id/app_logo_layout"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/dimen_18"
                    android:paddingEnd="4dp"
                    android:visibility="gone"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/new_logo" />

                    <TextView
                        style="@style/Headline2_16"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:fontFamily="@font/roboto_bold"
                        android:text="@string/app_name"
                        android:textColor="?colorOnSurface" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layout_calendar_toggle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="8dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <TextView
                        android:id="@+id/toolbar_title"
                        style="@style/Title2_20"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:maxLines="1"
                        android:textColor="?attr/colorOnSurface"
                        tools:text="Bugun, 8-oktabr" />

                    <ImageView
                        android:id="@+id/icon_calendar_arrow"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginStart="6dp"
                        android:src="@drawable/ic_calendar"
                        app:tint="?attr/colorOnSurfaceVariant" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/streak_display_layout"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/dimen_18"
                    android:visibility="visible"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <ImageView
                        android:id="@+id/image_streak_icon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/fire_ic"
                        app:tint="?colorStreakActive" />

                    <TextView
                        android:id="@+id/text_streak_count"
                        style="@style/Headline2_16"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:fontFamily="@font/roboto_bold"
                        android:textColor="?attr/colorStreakActive"
                        android:visibility="gone"
                        tools:text="3"
                        tools:visibility="visible" />
                </LinearLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.appbar.MaterialToolbar>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/date_scroller_recycler_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?colorSurfaceContainerLowest"
            android:clipToPadding="false"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingBottom="@dimen/dimen_12"
            android:visibility="gone"
            tools:visibility="visible"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:itemCount="10"
            tools:listitem="@layout/item_date_scroller" />

    </com.google.android.material.appbar.AppBarLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipeRefreshLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.core.widget.NestedScrollView
                android:id="@+id/contentScrollView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingBottom="88dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:gravity="end"
                    android:orientation="vertical"
                    android:paddingTop="16dp"
                    android:paddingBottom="50dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="16dp"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="12dp"
                        android:fontFamily="@font/roboto_bold"
                        android:text="@string/home_section_daily_norm"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="18sp" />

                    <include
                        android:id="@+id/main_progress"
                        layout="@layout/home_main_progress" />

                    <!-- Notification Permission Banner (Top) -->
                    <include
                        android:id="@+id/layoutNotificationBanner"
                        layout="@layout/layout_notification_permission_banner"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="16dp"
                        android:layout_marginTop="16dp"
                        android:visibility="gone" />

                    <!-- Premium Payment Verification Pending Card -->
                    <include
                        android:id="@+id/card_premium_checking"
                        layout="@layout/layout_home_premium_checking" />

                    <!-- App Feedback Card -->
                    <include
                        android:id="@+id/card_app_feedback"
                        layout="@layout/layout_home_app_feedback" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="16dp"
                        android:layout_marginTop="28dp"
                        android:layout_marginBottom="12dp"
                        android:fontFamily="@font/roboto_bold"
                        android:text="@string/home_section_nutrition"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="18sp" />

                    <!-- Meals Container (4 Meals Only) -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/layout_meal_cards"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="16dp"
                        app:cardBackgroundColor="?attr/colorSurfaceContainer"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="0dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <include
                                android:id="@+id/card_breakfast"
                                layout="@layout/item_home_meal_card" />

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:layout_marginStart="80dp"
                                android:layout_marginEnd="16dp"
                                android:background="?attr/colorSurfaceVariant" />

                            <include
                                android:id="@+id/card_lunch"
                                layout="@layout/item_home_meal_card" />

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:layout_marginStart="80dp"
                                android:layout_marginEnd="16dp"
                                android:background="?attr/colorSurfaceVariant" />

                            <include
                                android:id="@+id/card_dinner"
                                layout="@layout/item_home_meal_card" />

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:layout_marginStart="80dp"
                                android:layout_marginEnd="16dp"
                                android:background="?attr/colorSurfaceVariant" />

                            <include
                                android:id="@+id/card_snack"
                                layout="@layout/item_home_meal_card" />

                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Hydration & Activity Container (Water & Exercise) -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/card_activity_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="16dp"
                        android:layout_marginTop="16dp"
                        app:cardBackgroundColor="?attr/colorSurfaceContainer"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="0dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <include
                                android:id="@+id/card_water"
                                layout="@layout/layout_home_water_card" />

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:layout_marginStart="80dp"
                                android:layout_marginEnd="16dp"
                                android:background="?attr/colorSurfaceVariant" />

                            <include
                                android:id="@+id/card_exercise"
                                layout="@layout/layout_home_exercise_card" />

                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <include
                        android:id="@+id/card_what_to_eat"
                        layout="@layout/layout_home_what_to_eat" />

                    <include
                        android:id="@+id/card_weight_log"
                        layout="@layout/layout_home_weight_log" />

                    <include
                        android:id="@+id/card_dietologist_home"
                        layout="@layout/layout_home_ai_dietologist" />

                    <include
                        android:id="@+id/card_goal_prediction"
                        layout="@layout/layout_home_goal_prediction" />

                    <FrameLayout
                        android:id="@+id/banner_ad_container_home"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="32dp"
                        android:visibility="gone" />

                </LinearLayout>
            </androidx.core.widget.NestedScrollView>
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/progressBarOverall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminate="true"
            android:visibility="gone"
            app:indicatorColor="?attr/colorPrimary"
            app:indicatorSize="44dp"
            app:trackCornerRadius="4dp"
            app:trackThickness="4dp"
            tools:visibility="visible" />

    </FrameLayout>

    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/animation_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:visibility="gone"
        app:lottie_autoPlay="false"
        app:lottie_loop="false"
        app:lottie_rawRes="@raw/confeti_effect" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>