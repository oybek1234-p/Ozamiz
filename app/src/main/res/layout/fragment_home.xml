<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?colorSurfaceContainer">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?colorSurfaceContainer"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="?colorSurfaceContainer"
            app:contentInsetStart="0dp"
            app:contentInsetStartWithNavigation="0dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <LinearLayout
                    android:id="@+id/coin_display_layout"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="8dp"
                    android:paddingEnd="4dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <com.airbnb.lottie.LottieAnimationView
                        android:id="@+id/lottie_coin"
                        android:layout_width="@dimen/dimen_48"
                        android:layout_height="@dimen/dimen_48"
                        android:scaleType="centerCrop"
                        app:lottie_autoPlay="false"
                        app:lottie_loop="false"
                        app:lottie_rawRes="@raw/coin_anim" />

                    <TextView
                        android:id="@+id/text_points_count"
                        style="@style/Headline2_16"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/roboto_bold"
                        android:textColor="?colorOnSurface"
                        tools:text="0" />

                    <TextView
                        android:id="@+id/text_points_delta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:fontFamily="@font/roboto_bold"
                        android:textSize="20sp"
                        android:visibility="gone"
                        tools:text="+5"
                        tools:textColor="@color/green" />
                </LinearLayout>

                <TextView
                    android:id="@+id/toolbar_title"
                    style="@style/Title2_20"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="1"
                    android:textColor="?attr/colorOnSurface"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/streak_display_layout"
                    app:layout_constraintStart_toEndOf="@id/coin_display_layout"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:text="Bugun" />

                <LinearLayout
                    android:id="@+id/streak_display_layout"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/dimen_18"
                    android:visibility="gone"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:visibility="visible">

                    <ImageView
                        android:id="@+id/image_streak_icon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/fire_ic"
                        app:tint="@color/yellow" />

                    <TextView
                        android:id="@+id/text_streak_count"
                        style="@style/Headline2_16"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:fontFamily="@font/roboto_bold"
                        android:textColor="?colorOnSurface"
                        tools:text="3" />
                </LinearLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.appbar.MaterialToolbar>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/date_scroller_recycler_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?colorSurfaceContainer"
            android:clipToPadding="false"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingBottom="@dimen/dimen_12"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:itemCount="10"
            tools:listitem="@layout/item_date_scroller" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefreshLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/contentScrollView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="88dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:gravity="end"
                android:orientation="vertical"
                android:paddingTop="16dp"
                android:paddingBottom="100dp">

                <include
                    android:id="@+id/main_progress"
                    layout="@layout/home_main_progress" />
                
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_motivation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="16dp"
                    android:visibility="gone"
                    app:cardBackgroundColor="?attr/colorSurfaceContainerLowest"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeColor="?attr/colorOutlineVariant"
                    app:strokeWidth="1dp"
                    tools:visibility="visible">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/text_motivation"
                            style="@style/Headline2_16"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/roboto_medium"
                            android:textColor="?colorOnSurface"
                            tools:text="Bugun yondirdingiz! 🔥" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>


                <LinearLayout
                    android:id="@+id/layout_meal_cards"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="16dp"
                    android:orientation="vertical">

                    <include
                        android:id="@+id/card_breakfast"
                        layout="@layout/item_home_meal_card" />

                    <include
                        android:id="@+id/card_lunch"
                        layout="@layout/item_home_meal_card" />

                    <include
                        android:id="@+id/card_dinner"
                        layout="@layout/item_home_meal_card" />

                    <include
                        android:id="@+id/card_snack"
                        layout="@layout/item_home_meal_card" />
                </LinearLayout>


                <LinearLayout
                    android:id="@+id/layout_macro_warnings"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <include
                        android:id="@+id/warning_protein"
                        layout="@layout/item_macro_warning_card"
                        android:visibility="gone" />

                    <include
                        android:id="@+id/warning_carbs"
                        layout="@layout/item_macro_warning_card"
                        android:visibility="gone" />

                    <include
                        android:id="@+id/warning_fat"
                        layout="@layout/item_macro_warning_card"
                        android:visibility="gone" />
                </LinearLayout>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_menus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="16dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?selectableItemBackground"
                    android:visibility="gone"
                    app:cardBackgroundColor="?attr/colorSurfaceContainerLowest"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="0dp"
                    app:strokeColor="?attr/colorOutlineVariant"
                    app:strokeWidth="1dp">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="20dp">

                        <ImageView
                            android:id="@+id/img_menu_icon"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:background="@drawable/round_lay"
                            android:backgroundTint="?attr/colorPrimaryContainer"
                            android:padding="12dp"
                            android:src="@drawable/food_ic"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:tint="?attr/colorPrimary" />

                        <TextView
                            android:id="@+id/text_menu_title"
                            style="@style/TextAppearance.Material3.TitleLarge"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:layout_marginEnd="16dp"
                            android:fontFamily="@font/roboto_bold"
                            android:text="@string/menus_title"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="20sp"
                            app:layout_constraintBottom_toTopOf="@+id/text_menu_subtitle"
                            app:layout_constraintEnd_toStartOf="@+id/img_arrow"
                            app:layout_constraintStart_toEndOf="@id/img_menu_icon"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintVertical_chainStyle="packed" />

                        <TextView
                            android:id="@+id/text_menu_subtitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/menus_subtitle"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textSize="14sp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="@id/text_menu_title"
                            app:layout_constraintStart_toStartOf="@id/text_menu_title"
                            app:layout_constraintTop_toBottomOf="@id/text_menu_title" />

                        <ImageView
                            android:id="@+id/img_arrow"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/arrow_right"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:tint="?attr/colorOnSurfaceVariant" />

                    </androidx.constraintlayout.widget.ConstraintLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_water"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="16dp"
                    app:cardBackgroundColor="?attr/colorSurfaceContainerLowest"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="0dp"
                    app:strokeColor="?attr/colorOutlineVariant"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/title_water"
                                style="@style/TextAppearance.Material3.TitleLarge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/roboto_bold"
                                android:text="@string/water_title"
                                android:textColor="?colorOnSurface"
                                android:textSize="20sp" />

                            <TextView
                                android:id="@+id/text_current_water_liters"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="end"
                                android:fontFamily="@font/roboto_medium"
                                android:textColor="?colorOnSurface"
                                android:textSize="18sp"
                                tools:text="1.2 L ichildi" />
                        </FrameLayout>

                        <TextView
                            android:id="@+id/text_water_goal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:fontFamily="@font/roboto_regular"
                            android:textColor="?colorOnSurface"
                            android:textSize="16sp"
                            tools:text="Maqsad: 2.5 L" />

                        <com.google.android.material.progressindicator.LinearProgressIndicator
                            android:id="@+id/progress_water"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            app:indicatorColor="?colorTertiary"
                            app:indicatorTrackGapSize="0dp"
                            app:trackColor="?colorSurfaceContainerHigh"
                            app:trackCornerRadius="4dp"
                            app:trackStopIndicatorPadding="0dp"
                            app:trackStopIndicatorSize="0dp"
                            app:trackThickness="10dp"
                            tools:progress="50" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_open_water_dialog"
                            style="@style/FilledButton"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="20dp"
                            android:fontFamily="@font/roboto_medium"
                            android:text="Suv qo'shish"
                            android:textSize="14sp"
                            app:backgroundTint="?colorTertiary"
                            app:cornerRadius="16dp"
                            app:icon="@drawable/add_ic"
                            app:iconGravity="textStart" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_exercise"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="8dp"
                    app:cardBackgroundColor="?attr/colorSurfaceContainerLowest"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="0dp"
                    app:strokeColor="?attr/colorOutlineVariant"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/title_exercise"
                                style="@style/TextAppearance.Material3.TitleLarge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/roboto_bold"
                                android:text="Yog' yoqish"
                                android:textColor="?colorOnSurface"
                                android:textSize="20sp" />

                            <View
                                android:layout_width="0dp"
                                android:layout_height="0dp"
                                android:layout_weight="1" />

                            <TextView
                                android:id="@+id/text_exercise_progress"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/roboto_medium"
                                android:textColor="?colorOnSurfaceVariant"
                                android:textSize="14sp"
                                tools:text="0 / 300 kkal" />

                        </LinearLayout>

                        <com.google.android.material.progressindicator.LinearProgressIndicator
                            android:id="@+id/progress_exercise"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            app:indicatorColor="?colorTertiary"
                            app:indicatorTrackGapSize="0dp"
                            app:trackColor="?colorSurfaceContainerHigh"
                            app:trackCornerRadius="4dp"
                            app:trackStopIndicatorPadding="0dp"
                            app:trackStopIndicatorSize="0dp"
                            app:trackThickness="8dp"
                            tools:progress="50" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:id="@+id/btn_quick_walk"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:background="@drawable/bg_rounded_8"
                                android:backgroundTint="?attr/colorSurface"
                                android:clickable="true"
                                android:focusable="true"
                                android:foreground="?selectableItemBackground"
                                android:gravity="center"
                                android:orientation="vertical"
                                android:paddingVertical="12dp">

                                <TextView
                                    android:layout_width="30dp"
                                    android:layout_height="30dp"
                                    android:text="🚶"
                                    android:textSize="24sp" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:fontFamily="@font/roboto_medium"
                                    android:text="Piyoda"
                                    android:textColor="?colorOnSurface"
                                    android:textSize="12sp" />

                            </LinearLayout>

                            <Space
                                android:layout_width="8dp"
                                android:layout_height="wrap_content" />

                            <LinearLayout
                                android:id="@+id/btn_quick_run"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:background="@drawable/bg_rounded_8"
                                android:backgroundTint="?attr/colorSurface"
                                android:clickable="true"
                                android:focusable="true"
                                android:foreground="?selectableItemBackground"
                                android:gravity="center"
                                android:orientation="vertical"
                                android:paddingVertical="12dp">

                                <TextView
                                    android:layout_width="30dp"
                                    android:layout_height="30dp"
                                    android:text="🏃"
                                    android:textSize="24sp" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:fontFamily="@font/roboto_medium"
                                    android:text="Yugurish"
                                    android:textColor="?colorOnSurface"
                                    android:textSize="12sp" />

                            </LinearLayout>

                            <Space
                                android:layout_width="8dp"
                                android:layout_height="wrap_content" />

                            <LinearLayout
                                android:id="@+id/btn_quick_other"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:background="@drawable/bg_rounded_8"
                                android:backgroundTint="?attr/colorSurface"
                                android:clickable="true"
                                android:focusable="true"
                                android:foreground="?selectableItemBackground"
                                android:gravity="center"
                                android:orientation="vertical"
                                android:paddingVertical="12dp">

                                <ImageView
                                    android:layout_width="30dp"
                                    android:layout_height="30dp"
                                    android:src="@drawable/add_ic"
                                    android:textSize="24sp" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:fontFamily="@font/roboto_medium"
                                    android:text="Boshqa"
                                    android:textColor="?colorOnSurface"
                                    android:textSize="12sp" />

                            </LinearLayout>

                        </LinearLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_today_exercises"
                            style="@style/Widget.Material3.Button.ElevatedButton"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_horizontal"
                            android:layout_marginTop="12dp"
                            android:text="Bugun kiritilgan"
                            android:textColor="?attr/colorPrimary"
                            android:visibility="gone"
                            app:icon="@drawable/arrow_right"
                            app:iconGravity="textEnd"
                            tools:visibility="visible" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_dietolog"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?selectableItemBackground"
                    android:visibility="gone"
                    app:cardBackgroundColor="?attr/colorPrimaryContainer"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="20dp">

                        <ImageView
                            android:id="@+id/img_dietolog_icon"
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            android:background="@drawable/round_lay"
                            android:backgroundTint="?attr/colorPrimary"
                            android:padding="12dp"
                            android:src="@drawable/chat_ic"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:tint="?attr/colorOnPrimary" />

                        <TextView
                            android:id="@+id/text_dietolog_title"
                            style="@style/TextAppearance.Material3.TitleMedium"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:layout_marginEnd="8dp"
                            android:fontFamily="@font/roboto_bold"
                            android:text="Dietolog savol berish"
                            android:textColor="?attr/colorOnPrimaryContainer"
                            android:textSize="17sp"
                            app:layout_constraintBottom_toTopOf="@+id/text_dietolog_subtitle"
                            app:layout_constraintEnd_toStartOf="@+id/img_dietolog_arrow"
                            app:layout_constraintStart_toEndOf="@id/img_dietolog_icon"
                            app:layout_constraintTop_toTopOf="@id/img_dietolog_icon"
                            app:layout_constraintVertical_chainStyle="packed" />

                        <TextView
                            android:id="@+id/text_dietolog_subtitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:layout_marginTop="2dp"
                            android:layout_marginEnd="8dp"
                            android:alpha="0.7"
                            android:text="AI dietolog bilan suhbat"
                            android:textColor="?attr/colorOnPrimaryContainer"
                            android:textSize="13sp"
                            app:layout_constraintBottom_toBottomOf="@id/img_dietolog_icon"
                            app:layout_constraintEnd_toStartOf="@+id/img_dietolog_arrow"
                            app:layout_constraintStart_toEndOf="@id/img_dietolog_icon"
                            app:layout_constraintTop_toBottomOf="@id/text_dietolog_title" />

                        <ImageView
                            android:id="@+id/img_dietolog_arrow"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/arrow_right"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:tint="?attr/colorOnPrimaryContainer" />

                    </androidx.constraintlayout.widget.ConstraintLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_weight_log"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="16dp"
                    android:visibility="gone"
                    app:cardBackgroundColor="?attr/colorSurfaceContainerLowest"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="0dp"
                    app:strokeColor="?attr/colorOutlineVariant"
                    app:strokeWidth="1dp"
                    tools:visibility="visible">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="20dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/roboto_bold"
                                android:text="Vazningizni qo'shing"
                                android:textColor="?attr/colorOnSurface"
                                android:textSize="17sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="Yangi natijani bugun qayd eting."
                                android:textColor="?attr/colorOnSurfaceVariant"
                                android:textSize="14sp" />
                        </LinearLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_add_weight_home"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:text="Qo'shish"
                            android:textColor="?attr/colorOnPrimary"
                            app:icon="@drawable/camera_ic" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>


                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_daily_tip"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="16dp"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="0dp"
                    app:strokeColor="?attr/colorOutlineVariant"
                    app:strokeWidth="1dp">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?colorSurfaceContainerLowest"
                        android:paddingHorizontal="@dimen/dimen_18"
                        android:paddingTop="@dimen/dimen_18">

                        <TextView
                            android:id="@+id/text_tip_emoji"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:background="@drawable/round_lay"
                            android:backgroundTint="?attr/colorSurfaceContainer"
                            android:gravity="center"
                            android:textSize="24sp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            tools:text="💧" />

                        <TextView
                            android:id="@+id/text_tip_title"
                            style="@style/TextAppearance.Material3.TitleMedium"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:fontFamily="@font/roboto_bold"
                            android:textColor="?attr/colorOnSurface"
                            app:layout_constraintBottom_toBottomOf="@id/text_tip_emoji"
                            app:layout_constraintEnd_toStartOf="@id/btn_close_tip"
                            app:layout_constraintStart_toEndOf="@id/text_tip_emoji"
                            app:layout_constraintTop_toTopOf="@id/text_tip_emoji"
                            tools:text="Suv ichish tartibi" />

                        <ImageView
                            android:id="@+id/btn_close_tip"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:clickable="true"
                            android:focusable="true"
                            android:padding="4dp"
                            android:src="@drawable/ic_close_24"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:tint="?attr/colorOnSurfaceVariant" />

                        <TextView
                            android:id="@+id/text_tip_description"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:fontFamily="@font/roboto_regular"
                            android:lineSpacingMultiplier="1.2"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="16sp"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/text_tip_emoji"
                            tools:text="Har kuni kamida 2 litr suv ichish moddalar almashinuvini yaxshilaydi." />


                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_tip_details"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/roboto_bold"
                            android:text="Batafsil"
                            android:textColor="?attr/colorPrimary"
                            app:icon="@drawable/arrow_right"
                            app:iconGravity="textEnd"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/text_tip_description" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/progressBarOverall"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:indeterminate="true"
        android:visibility="gone"
        tools:visibility="visible" />
</androidx.coordinatorlayout.widget.CoordinatorLayout>