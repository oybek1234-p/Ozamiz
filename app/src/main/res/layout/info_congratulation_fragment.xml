<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:id="@+id/textView4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="128dp"
        android:fontFamily="@font/roboto_bold"
        android:text="Sizga mos reja tuzdik!"
        android:textColor="?colorPrimary"
        android:textSize="30sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/imageView"
        android:layout_width="match_parent"
        android:layout_height="250dp"
        android:layout_marginTop="@dimen/dimen_12"
        android:visibility="gone"
        android:src="@drawable/congratulation_woman"
        app:layout_constraintTop_toBottomOf="@+id/textView4" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/materialCardView"
        android:layout_width="match_parent"
        android:layout_marginTop="@dimen/dimen_48"
        android:layout_height="wrap_content"
        app:cardElevation="@dimen/dimen_10"
        android:layout_marginHorizontal="@dimen/dimen_24"
        app:layout_constraintTop_toBottomOf="@+id/imageView"
        tools:layout_editor_absoluteX="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?colorSurface"
            android:orientation="vertical"
            android:padding="@dimen/dimen_18">

            <TextView
                android:id="@+id/textView5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="1 oyda 3-4 kg gacha ozishingiz mumkin"
                android:textColor="?colorOnSurface"
                android:textSize="24sp"
                android:fontFamily="@font/roboto_medium"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/cal_view"
                style="@style/Title3_17"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_24"
                android:drawableStart="@drawable/check_ic"
                android:drawablePadding="@dimen/dimen_12"
                android:drawableTint="@color/green"
                android:text="Kunlik kaloriya: 1650 kal" />

            <TextView
                android:id="@+id/food_view"
                style="@style/Title3_17"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_8"
                android:drawableStart="@drawable/check_ic"
                android:drawablePadding="@dimen/dimen_12"
                android:drawableTint="@color/green"
                android:text="Ovqatlanish 3 - 5 mahal" />

            <TextView
                android:id="@+id/exercise_view"
                style="@style/Title3_17"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_8"
                android:drawableStart="@drawable/check_ic"
                android:drawablePadding="@dimen/dimen_12"
                android:drawableTint="@color/green"
                android:text="Mashqlar: 30 - 60 daqiqa" />

            <TextView
                android:id="@+id/water_view"
                style="@style/Title3_17"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_8"
                android:drawablePadding="@dimen/dimen_12"
                android:text="8 stakan suv"
                app:drawableStartCompat="@drawable/check_ic"
                app:drawableTint="@color/green" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/textView6"
        style="@style/Title3_17"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_12"
        android:drawablePadding="@dimen/dimen_12"
        android:gravity="center"
        android:text="Bu sog'lom va barqaror ozish yo'lidir! \nKeling bugun boshlaymiz!"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/materialCardView" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/next_button"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Boshlash"
        app:icon="@drawable/arrow_right"
        app:iconGravity="textEnd"
        android:layout_marginTop="@dimen/dimen_24"
        app:layout_constraintEnd_toEndOf="@+id/materialCardView"
        app:layout_constraintStart_toStartOf="@+id/materialCardView"
        app:layout_constraintTop_toBottomOf="@+id/textView6" />
</androidx.constraintlayout.widget.ConstraintLayout>