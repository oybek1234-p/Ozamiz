<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?colorSurface">

    <!-- Header -->
    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:padding="16dp"
        android:background="?attr/colorSurfaceContainerLowest"
        android:elevation="0dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/oval_back"
            android:backgroundTint="?colorSurfaceContainerHigh"
            android:src="@drawable/arrow_back"
            android:contentDescription="@string/common_back"
            android:padding="8dp"
            app:tint="?colorOnSurface"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/menu_add_title"
            android:textSize="18sp"
            android:fontFamily="@font/roboto_bold"
            android:textColor="?colorOnSurface"
            android:layout_marginEnd="40dp"/>
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/headerLayout"
        app:layout_constraintBottom_toTopOf="@id/footerLayout">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:paddingBottom="100dp"
            android:clipToPadding="false">
            
            <!-- AI Fill Banner -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnAiFill"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="?attr/colorPrimaryContainer"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="12dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/camera_ic"
                        app:tint="?attr/colorOnPrimaryContainer" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/roboto_medium"
                        android:text="@string/menu_ai_generate_title"
                        android:textColor="?attr/colorOnPrimaryContainer"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/round_lay"
                        android:backgroundTint="?attr/colorPrimary"
                        android:fontFamily="@font/roboto_bold"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:text="AI"
                        android:textColor="?attr/colorOnPrimary"
                        android:textSize="11sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Image Picker Card (16:9 Aspect Ratio) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardImagePicker"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="?attr/colorOutlineVariant"
                app:cardBackgroundColor="?attr/colorSurfaceContainer">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:id="@+id/containerUploadInfo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="28dp"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent">

                        <ImageView
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:background="@drawable/oval_background_with_opacity"
                            android:backgroundTint="?attr/colorPrimaryContainer"
                            android:src="@drawable/camera_ic"
                            app:tint="?attr/colorPrimary"
                            android:padding="14dp"
                            android:layout_marginBottom="8dp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/menu_add_upload_title"
                            android:fontFamily="@font/roboto_bold"
                            android:textColor="?colorOnSurface"
                            android:textSize="16sp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/menu_add_upload_desc"
                            android:textColor="?colorOnSurfaceVariant"
                            android:textSize="12sp"
                            android:layout_marginBottom="12dp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/menu_add_choose_photo"
                            android:textColor="?attr/colorPrimary"
                            android:background="@drawable/round_lay"
                            android:backgroundTint="?attr/colorPrimaryContainer"
                            android:paddingHorizontal="20dp"
                            android:paddingVertical="8dp"
                            android:textStyle="bold"
                            android:textSize="12sp"/>
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/imagePreview"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:scaleType="centerCrop"
                        android:visibility="gone"
                        app:layout_constraintDimensionRatio="16:9"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>
            
            <!-- Hidden legacy button (kept with ID for backward compatibility) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSelectCategories"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:visibility="gone"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:text="@string/select_categories"/>

            <!-- Selected Categories Display (Universal FoodTags) -->
            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupSelectedCategories"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:chipSpacing="8dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/menu_add_type_label"
                android:fontFamily="@font/roboto_medium"
                android:textColor="?colorOnSurface"
                android:textSize="14sp"
                android:layout_marginBottom="4dp"/>

            <RadioGroup
                android:id="@+id/radioGroupType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <RadioButton
                    android:id="@+id/radioMenu"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/menu_type_badge_menu"
                    android:checked="true"
                    android:layout_marginEnd="24dp"/>

                <RadioButton
                    android:id="@+id/radioRecipe"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/menu_type_badge_recipe"/>
            </RadioGroup>

            <TextView
                android:id="@+id/labelName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/menu_add_name_label_menu"
                android:fontFamily="@font/roboto_medium"
                android:textColor="?colorOnSurface"
                android:textSize="14sp"
                android:layout_marginBottom="4dp"/>

            <EditText
                android:id="@+id/editName"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/round_lay_stroke"
                android:padding="12dp"
                android:hint="@string/menu_add_name_hint_menu"
                android:inputType="textCapSentences"
                android:layout_marginBottom="16dp"/>

            <LinearLayout
                android:id="@+id/containerMenuFields"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/labelItems"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/menu_add_foods_label"
                    android:fontFamily="@font/roboto_medium"
                    android:textColor="?colorOnSurface"
                    android:textSize="14sp"
                    android:layout_marginBottom="4dp"/>

                <LinearLayout
                    android:id="@+id/containerIngredientsList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="8dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAddIngredient"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:text="@string/menu_add_food_btn"
                    android:textSize="12sp"
                    android:layout_marginBottom="16dp"
                    app:cornerRadius="8dp"
                    android:textAllCaps="false"/>

                <!-- Recipe Only: Cooking Steps, Prep Time, Difficulty -->
                <LinearLayout
                    android:id="@+id/containerRecipeFields"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/menu_add_prep_label"
                        android:fontFamily="@font/roboto_medium"
                        android:textColor="?colorOnSurface"
                        android:textSize="14sp"
                        android:layout_marginBottom="4dp"/>

                    <LinearLayout
                        android:id="@+id/containerStepsList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="8dp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAddStep"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:text="@string/add_step"
                        android:textSize="12sp"
                        android:layout_marginBottom="16dp"
                        app:cornerRadius="8dp"
                        android:textAllCaps="false"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:baselineAligned="false"
                        android:layout_marginBottom="16dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginEnd="8dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/menu_add_prep_time_label"
                                android:fontFamily="@font/roboto_medium"
                                android:textColor="?colorOnSurface"
                                android:textSize="14sp"
                                android:layout_marginBottom="4dp"/>

                            <EditText
                                android:id="@+id/editPrepTime"
                                android:layout_width="match_parent"
                                android:layout_height="48dp"
                                android:background="@drawable/round_lay_stroke"
                                android:padding="12dp"
                                android:hint="15"
                                android:inputType="number"/>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="8dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/qiyinchilik_darajasi"
                                android:fontFamily="@font/roboto_medium"
                                android:textColor="?colorOnSurface"
                                android:textSize="14sp"
                                android:layout_marginBottom="4dp"/>

                            <RadioGroup
                                android:id="@+id/radioGroupDifficulty"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical">

                                <RadioButton
                                    android:id="@+id/radioDifficultyEasy"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/oson"
                                    android:checked="true"
                                    android:textSize="12sp"/>

                                <RadioButton
                                    android:id="@+id/radioDifficultyMedium"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/ortacha"
                                    android:textSize="12sp"/>

                                <RadioButton
                                    android:id="@+id/radioDifficultyHard"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/qiyin"
                                    android:textSize="12sp"/>
                            </RadioGroup>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/containerFoodFields"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/menu_add_about_label"
                    android:fontFamily="@font/roboto_medium"
                    android:textColor="?colorOnSurface"
                    android:textSize="14sp"
                    android:layout_marginBottom="4dp"/>

                <EditText
                    android:id="@+id/editAbout"
                    android:layout_width="match_parent"
                    android:layout_height="100dp"
                    android:background="@drawable/round_lay_stroke"
                    android:padding="12dp"
                    android:gravity="top|start"
                    android:hint="@string/menu_add_about_hint"
                    android:inputType="textMultiLine"
                    android:layout_marginBottom="16dp"/>
            </LinearLayout>
                
            <!-- Macros Grid -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:baselineAligned="false"
                android:layout_marginBottom="16dp">
                
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginEnd="8dp">
                     <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/calories"
                        android:fontFamily="@font/roboto_medium"
                        android:textColor="?colorOnSurface"
                        android:textSize="14sp"
                        android:layout_marginBottom="4dp"/>
                    <EditText
                        android:id="@+id/editCalories"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/round_lay_stroke"
                        android:padding="12dp"
                        android:inputType="numberDecimal"
                        android:imeOptions="actionNext"/>
                </LinearLayout>
                
                 <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="8dp">
                     <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/protein"
                        android:fontFamily="@font/roboto_medium"
                        android:textColor="?colorOnSurface"
                        android:textSize="14sp"
                        android:layout_marginBottom="4dp"/>
                    <EditText
                        android:id="@+id/editProtein"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/round_lay_stroke"
                        android:padding="12dp"
                        android:inputType="numberDecimal"/>
                </LinearLayout>
            </LinearLayout>
            
             <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:baselineAligned="false"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginEnd="8dp">
                     <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/fat"
                        android:fontFamily="@font/roboto_medium"
                        android:textColor="?colorOnSurface"
                        android:textSize="14sp"
                        android:layout_marginBottom="4dp"/>
                    <EditText
                        android:id="@+id/editFat"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/round_lay_stroke"
                        android:padding="12dp"
                        android:inputType="numberDecimal"/>
                </LinearLayout>

                 <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="8dp">
                     <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/carbs"
                        android:fontFamily="@font/roboto_medium"
                        android:textColor="?colorOnSurface"
                        android:textSize="14sp"
                        android:layout_marginBottom="4dp"/>
                    <EditText
                        android:id="@+id/editCarbs"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/round_lay_stroke"
                        android:padding="12dp"
                        android:inputType="numberDecimal"/>
                 </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:baselineAligned="false"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginEnd="8dp">
                     <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/fiber_label"
                        android:fontFamily="@font/roboto_medium"
                        android:textColor="?colorOnSurface"
                        android:textSize="14sp"
                        android:layout_marginBottom="4dp"/>
                    <EditText
                        android:id="@+id/editFiber"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/round_lay_stroke"
                        android:padding="12dp"
                        android:inputType="numberDecimal"/>
                </LinearLayout>

                 <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="8dp">
                     <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/sugar_label"
                        android:fontFamily="@font/roboto_medium"
                        android:textColor="?colorOnSurface"
                        android:textSize="14sp"
                        android:layout_marginBottom="4dp"/>
                    <EditText
                        android:id="@+id/editSugar"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/round_lay_stroke"
                        android:padding="12dp"
                        android:inputType="numberDecimal"/>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:baselineAligned="false"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.5"
                    android:orientation="vertical"
                    android:layout_marginEnd="8dp">
                     <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/salt_label"
                        android:fontFamily="@font/roboto_medium"
                        android:textColor="?colorOnSurface"
                        android:textSize="14sp"
                        android:layout_marginBottom="4dp"/>
                    <EditText
                        android:id="@+id/editSalt"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/round_lay_stroke"
                        android:padding="12dp"
                        android:inputType="numberDecimal"
                        android:imeOptions="actionDone"/>
                </LinearLayout>

                <View
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.5"
                    android:layout_marginStart="8dp"/>
            </LinearLayout>

            <!-- Keyboard Spacer -->
            <View
                android:layout_width="match_parent"
                android:layout_height="100dp"/>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Footer -->
    <FrameLayout
        android:id="@+id/footerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?colorSurface"
        android:padding="16dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:backgroundTint="?attr/colorPrimary"
            android:text="@string/menu_add_save_btn"
            android:textColor="?colorOnPrimary"
            android:fontFamily="@font/roboto_bold"
            android:textSize="16sp"
            app:cornerRadius="16dp"
            android:textAllCaps="false"/>
            
        <ProgressBar
             android:id="@+id/progressBar"
             android:layout_width="wrap_content"
             android:layout_height="wrap_content"
             android:layout_gravity="center"
             android:indeterminateTint="?attr/colorPrimary"
             android:visibility="gone"/>
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
