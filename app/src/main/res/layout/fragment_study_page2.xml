<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:background="?colorSurface"
    android:layout_height="match_parent">

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/button_next_study_page2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:clipToPadding="false"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <ImageView
                android:id="@+id/image_study_page2"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:scaleType="centerCrop"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                android:src="@drawable/water_photo"
                android:contentDescription="Suv illustratsiyasi" />

            <TextView
                android:id="@+id/title_study_page2"
                style="@style/Title2_20"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:text="Suv – ozishning eng arzon va eng samarali yo‘li"
                android:textColor="?colorOnSurface" />

            <TextView
                android:id="@+id/explanation_study_page2"
                style="@style/Headline2_16"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:lineSpacingMultiplier="1.3"
                android:text="Suv tanani tozalaydi, hazmni yaxshilaydi va ko‘pincha ochlikni kamaytiradi.\nTanangizda yog‘ kuyish jarayoni uchun suv kerak. Suv yetishmasa — ozish sekinlashadi."
                android:textColor="?colorOnSurface" />

            <TextView
                style="@style/Text1_16"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="?colorOnSurface"
                android:text="Ba’zida siz ochlik deb o‘ylagan holat aslida chanqoqlik bo‘lishi mumkin." />


            <TextView
                android:id="@+id/key_idea_title_study_page2"
                style="@style/Headline2_16"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="🍋 Tavsiyanoma:"
                android:textColor="?colorOnSurface" />

            <TextView
                android:id="@+id/key_idea_content_study_page2"
                style="@style/Text1_16"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/roboto_medium"
                android:lineSpacingMultiplier="1.3"
                android:textColor="?colorOnSurface"
                android:text="• Har kuni 6–8 stakan (1.5–2 litr) suv iching\n• Ovqatlanishdan 15-20 daqiqa oldidan 1-2 stakan suv iching – yog‘ kuyishini tezlashtiradi" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_next_study_page2"
        style="@style/Widget.Material3.Button"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:text="Keyingisi"
        app:icon="@drawable/arrow_right"
        app:iconGravity="textEnd"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>