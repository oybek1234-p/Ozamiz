<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?colorSurface">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout_food_advice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?colorSurface"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar_food_advice"
            style="@style/Widget.MaterialComponents.Toolbar.PrimarySurface"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="?colorSurface"
            app:navigationIcon="@drawable/arrow_back"
            app:navigationIconTint="?colorOnSurface"
            app:title="Asosiy Tavsiyalar"
            app:titleTextColor="?colorOnSurface" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        android:clipToPadding="false"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                style="@style/Title4_24"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:visibility="gone"
                android:text="🍽️ Ozish uchun Asosiy Tavsiyalar"
                android:textColor="?colorOnSurface"
                android:layout_marginBottom="16dp"/>

            <!-- NONUSHTA SECTION -->
            <TextView
                style="@style/Title2_20"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="🥣 Nonushta"
                android:textColor="?colorOnSurface" />

            <TextView
                style="@style/Headline2_16"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="🔹 Qanday bo‘lishi kerak:"
                android:textColor="?colorOnSurface" />
            <TextView
                style="@style/Text1_16"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:lineSpacingMultiplier="1.2"
                android:text="Ertalab organizmni uyg‘otadigan, to‘yimli va yengil bo‘lsin.  Ko‘p shakarli, yog‘li mahsulotlardan saqlaning"
                android:textColor="?colorOnSurface" />

            <TextView
                style="@style/Title3_17"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="✅ Asosiy ovqatdan birini tanlang:"
                android:textColor="?colorOnSurface" />
            <TextView
                style="@style/Text1_16"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:lineSpacingMultiplier="1.2"
                android:text="1) Ofsyanka – 3-4 osh qoshiq, suvda yoki oz sutda\n2) Grechka yoki bug‘doy yormasi – 3-4 osh qoshiq, qaynatilgan\n3) 1–2 dona qaynatilgan tuxum\n4) Tvorog – 100 g, tuzsiz\n5) Sutli qatiqli nonushta (masalan, yogurtli bo‘tqa)"
                android:textColor="?colorOnSurface" />

            <TextView
                style="@style/Title3_17"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="➕ Qoshimchasiga birni tanlang:"
                android:textColor="?colorOnSurface" />
            <TextView
                style="@style/Text1_16"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:lineSpacingMultiplier="1.2"
                android:text="1) Sabzavotli salat (bodring, pomidor, ko‘kat)\n2) Meva (olma, banan, apelsin – bitta)\n3) Qatiq – yarim stakan\n1 bo‘lak qora non"
                android:textColor="?colorOnSurface" />

            <TextView
                style="@style/Title3_17"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="❌ Yeyilmasin:"
                android:textColor="?colorOnSurface" />
            <TextView
                style="@style/Text1_16"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:lineSpacingMultiplier="1.2"
                android:text="1) Hamirli ovqatlar(oq non, manti, honim),Bulochka,\n2) Shirin yogurtlar, qandli choy\n3) Pechenye, konfet, sok\n4) Kola, gazlangan ichimliklar"
                android:textColor="?colorOnSurface" />

            <TextView
                style="@style/Headline2_16"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="🧠 Misol:"
                android:textColor="?colorOnSurface" />
            <TextView
                style="@style/Text1_16"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:lineSpacingMultiplier="1.2"
                android:text="Ofsyanka + olma yoki\n1 dona tuxum + bodring-pomidor salat + qora non bo‘lagi"
                android:textColor="?colorOnSurface" />


            <!-- TUSHLIK SECTION -->
            <TextView
                style="@style/Title2_20"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="🍛 Tushlik – To'yimli, lekin sog‘lom bo‘lsin"
                android:textColor="?colorOnSurface" />

            <TextView
                style="@style/Title3_17"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="🔹 Qanday bo‘lishi kerak:"
                android:textColor="?colorOnSurface" />
            <TextView
                style="@style/Text1_16"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:lineSpacingMultiplier="1.2"
                android:text="Energiya beruvchi, lekin yog‘ va kaloriya kam bo‘lsin"
                android:textColor="?colorOnSurface" />

            <TextView
                style="@style/Title3_17"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="✅ Asosiydan birini tanlang:"
                android:textColor="?colorOnSurface" />
            <TextView
                style="@style/Text1_16"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:lineSpacingMultiplier="1.2"
                android:text="Moshkichiri (kam yog‘ bilan)\nSabzavotli sho‘rva (karam, sabzi, mosh, tovuqli)\nDimlama – sabzavotli va yog‘siz\nBug‘da yoki qaynatilgan go‘sht – 100–150 g\nTovuq filesi – bug‘da yoki qozonda ozgina suv bilan\nNo‘xat, loviya, grechka yoki makaron – qaynatilgan, yog‘siz"
                android:textColor="?colorOnSurface" />

            <TextView
                style="@style/Title3_17"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="➕ Qo‘shimchadan BIRINI tanlang:"
                android:textColor="?colorOnSurface" />
            <TextView
                style="@style/Text1_16"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:lineSpacingMultiplier="1.2"
                android:text="Katta kosa sabzavotli salat\nQatiq yoki kefir – 1 stakan\n1 bo‘lak qora non"
                android:textColor="?colorOnSurface" />

            <TextView
                style="@style/Title3_17"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="❌ Yeyilmasin:"
                android:textColor="?colorOnSurface" />
            <TextView
                style="@style/Text1_16"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:lineSpacingMultiplier="1.2"
                android:text="Palov (osh) – faqat haftada 1 marta\nKabob, qovurilgan gosht, kotlet\nSomsa, chuchvara, makaron qovurilgan holda\nMayonez, ketchup, achchiq sous\nNon bilan guruchni birga"
                android:textColor="?colorOnSurface" />

            <TextView
                style="@style/Title3_17"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="🧠 Misol:"
                android:textColor="?colorOnSurface" />
            <TextView
                style="@style/Text1_16"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:lineSpacingMultiplier="1.2"
                android:text="Moshkichiri + sabzavotli salat\nyoki\n100 g tovuq go‘shti + 3 qoshiq grechka + qatiq"
                android:textColor="?colorOnSurface" />

            <!-- KECHKI OVQAT SECTION -->
            <TextView
                style="@style/Title2_20"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="🍲 Kechki ovqat – Yengil va erta yeyiladigan"
                android:textColor="?colorOnSurface" />

            <TextView
                style="@style/Title3_17"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="🔹 Qanday bo‘lishi kerak:"
                android:textColor="?colorOnSurface" />
            <TextView
                style="@style/Text1_16"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:lineSpacingMultiplier="1.2"
                android:text="Kechqurun hazm bo‘ladigan engil, sog‘lom ovqat\nNon va yog‘li ovqat yo‘q!"
                android:textColor="?colorOnSurface" />

            <TextView
                style="@style/Title3_17"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="✅ Asosiydan birini tanlang:"
                android:textColor="?colorOnSurface" />
            <TextView
                style="@style/Text1_16"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:lineSpacingMultiplier="1.2"
                android:text="Qaynatilgan tuxum – 1 dona\nTvorog – 100 g\nBug‘da pishgan baliq – 100 g\nQaynatilgan tovuq – 80–100 g\nSabzavotli bug‘da pishgan taom (brokkoli, karam, sabzi)"
                android:textColor="?colorOnSurface" />

            <TextView
                style="@style/Headline2_16"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="➕ Qo‘shimchadan BIRINI tanlang:"
                android:textColor="?colorOnSurface" />
            <TextView
                style="@style/Text1_16"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:lineSpacingMultiplier="1.2"
                android:text="Sabzavotli salat (zaytun yog‘siz)\nQatiq yoki kefir – 1 stakan\nBitta olma yoki nok"
                android:textColor="?colorOnSurface" />

            <TextView
                style="@style/Headline2_16"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="❌ Yeyilmasin:"
                android:textColor="?colorOnSurface" />
            <TextView
                style="@style/Text1_16"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:lineSpacingMultiplier="1.2"
                android:text="Non, guruch, makaron\nKabob, qovurma, yog‘li go‘sht\nKola, kompot, shirinliklar\nOsh yoki ertalabdan qolgan ovqat"
                android:textColor="?colorOnSurface" />

            <TextView
                style="@style/Headline2_16"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="🧠 Misol:"
                android:textColor="?colorOnSurface" />
            <TextView
                style="@style/Text1_16"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:lineSpacingMultiplier="1.2"
                android:text="1 dona tuxum + sabzavotli salat\nyoki\n100 g tvorog + 1 stakan qatiq"
                android:textColor="?colorOnSurface" />

            <!-- UMUMIY ESLATMALAR SECTION -->
            <TextView
                style="@style/Title2_20"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="📌 Umumiy eslatmalar:"
                android:textColor="?colorOnSurface" />
            <TextView
                style="@style/Text1_16"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingMultiplier="1.3"
                android:text="🍽 Har kuni 3 ta asosiy ovqat va 1–2 tamaddi\n🚰 6–8 stakan suv iching\n🕒 Ovqatlar orasida 3–4 soat tanaffus bo‘lsin\n❗ Har bir ovqatda faqat 1 asosiy va 1 qo‘shimcha tanlang\n📴 Ovqatlanayotganda telefondan chalg‘imang – ongli ovqatlaning"
                android:textColor="?colorOnSurface" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>