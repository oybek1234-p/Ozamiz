<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?colorSurfaceContainerLowest">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout_admin_payment_detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?colorSurface"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar_admin_payment_detail"
            style="@style/Widget.MaterialComponents.Toolbar.PrimarySurface"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="?colorSurface"
            app:navigationIcon="@drawable/arrow_back"
            app:navigationIconTint="?colorOnSurface"
            app:title="To'lovni Tekshirish"
            app:titleTextColor="?colorOnSurface" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollView_admin_payment_detail"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        tools:visibility="visible"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/textView_user_name_detail_admin"
                style="@style/Title3_17"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="?colorOnSurface"
                tools:text="Ismi: Ali Valiyev" />

            <TextView
                android:id="@+id/textView_user_phone_detail_admin"
                style="@style/TextBodyMedium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="?colorOnSurfaceVariant"
                tools:text="Telefoni: +998901234567" />
            <TextView
                android:id="@+id/textView_user_email_detail_admin"
                style="@style/TextBodyMedium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="?colorOnSurfaceVariant"
                tools:text="Emaili: ali@mail.com" />

            <TextView
                android:id="@+id/textView_submission_time_detail_admin"
                style="@style/TextBodyMedium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="?colorOnSurfaceVariant"
                tools:text="Yuborilgan vaqti: 15-Avgust, 2023 10:30" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp">
                <ImageView
                    android:id="@+id/imageView_payment_check_admin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:adjustViewBounds="true"
                    android:minHeight="300dp"
                    android:scaleType="fitCenter"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?colorSurfaceContainer"
                    tools:src="@drawable/placeholder_food" />
            </com.google.android.material.card.MaterialCardView>


            <LinearLayout
                android:id="@+id/layout_action_buttons_admin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="24dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_reject_payment"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:text="@string/reject_payment"
                    android:textColor="?colorError"
                    app:strokeColor="?colorError" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_approve_payment"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="@string/approve_payment" />
            </LinearLayout>
            <ProgressBar
                android:id="@+id/progress_buttons_admin_payment_detail"
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:visibility="gone" />


        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <ProgressBar
        android:id="@+id/progressBar_admin_payment_detail"
        style="?android:attr/progressBarStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone"
        tools:visibility="visible"/>

    <TextView
        android:id="@+id/textView_error_admin_payment_detail"
        style="@style/TextBodyLarge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:textColor="?colorError"
        android:visibility="gone"
        tools:text="Ma'lumot topilmadi"/>

</androidx.coordinatorlayout.widget.CoordinatorLayout>